  transition             String   @db.VarChar(12)
  /// `ThresholdBreached` | `ManualTrip` | `ManualReset` | `CooldownElapsed` |
  /// `ProbeSucceeded` | `ProbeFailed`.
  reason                 String   @db.VarChar(32)
  failureCount           Int?     @db.SmallInt
  actorStaffUserId       String?  @db.Char(26)
