# Copy to apps/api/.env for local development. Never commit real secrets.

# For `docker-compose.yml` (root `.env`, containerized `postgres` service):
# this password MUST equal POSTGRES_PASSWORD below, and the host MUST be
# `postgres` (the compose service name), never `localhost` — found live
# during Final Review's clean `docker compose up` verification: leaving
# these two independently-set placeholders out of sync fails the `migrate`
# step with Prisma P1000 ("Authentication failed"). For `apps/api/.env`
# (non-Docker local dev against docker-compose.dev.yml's Postgres) the
# default below (`liveavatar:liveavatar@localhost`) is correct as-is.
DATABASE_URL=postgresql://liveavatar:liveavatar@localhost:5432/liveavatar
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
BOOTSTRAP_SECRET=change-me-bootstrap-secret
PORT=8080
INTERNAL_PORT=8081
NODE_ENV=development
LOG_DIR=./logs
ADMIN_ORIGIN=http://localhost:4200

# LiveKit (Phase 3). Matches the `livekit` dev-mode service in
# docker-compose.dev.yml, which mints this exact key/secret pair itself.
# For docker-compose.yml (production-oriented, this file's other section
# below) set LIVEKIT_URL=ws://livekit:7880 instead (container DNS name, not
# localhost) and a real generated API key/secret pair — never the devkey
# values below outside of docker-compose.dev.yml.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecretdevsecretdevsecret
AGENT_NAME=avatar-agent

# Phase 4 (BL-013..017): shared secret the Python agent presents as
# X-Internal-Token on every agent-facing /internal route. Must match
# apps/agent's own INTERNAL_TOKEN env var exactly.
INTERNAL_TOKEN=change-me-internal-token-min-16-chars

# ---------------------------------------------------------------------------
# nexus-deploy additions below: variables docker-compose.yml (production-
# oriented compose, distinct from docker-compose.dev.yml) and the apps/agent
# container expect. Copy this whole file to `.env` at the repo root for
# `docker compose up` (never commit the real `.env` — it is gitignored).
# ---------------------------------------------------------------------------

# Postgres image env (docker-compose.yml's `postgres` service only; the API
# itself only reads DATABASE_URL above).
POSTGRES_USER=liveavatar
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=liveavatar

# Image tags to build/run — set by CI to the commit SHA (or a release tag)
# when pushing/pulling from a registry; defaults to `latest` for local use.
WEB_IMAGE=liveavatar/web
WEB_IMAGE_TAG=latest
AGENT_IMAGE=liveavatar/agent
AGENT_IMAGE_TAG=latest

# Admin SPA origin the API's CORS policy allows (HLD §5.1). In compose this
# is whatever host/port you serve /admin from; behind a real ingress this is
# your public admin hostname.
ADMIN_ORIGIN=https://admin.example.com

# The agent's own view of the internal listener (must resolve from the
# `agent` container/pod, not from a browser) and of LiveKit.
CONTROL_PLANE_INTERNAL_URL=http://web-internal:8081
MAX_CONCURRENT_JOBS=10

# AI subsystem (ADR-001 §3) — provider-agnostic, env-driven. Per-tenant
# `endpoint_url`/`credential_ref` overrides from the published Agent Builder
# config still take precedence over these process-wide defaults; these are
# the dev/preview fallback used when a tenant config is absent.
# AI_BASE_URL lets this point at any OpenAI-compatible on-prem endpoint
# (Ollama/vLLM/internal gateway) instead of a remote vendor API — never bake
# a provider baseURL or key into an image layer.
AI_PROVIDER=openai
AI_MODEL_CONVERSATION=gpt-4o-mini
AI_MODEL_SUMMARY=gpt-4o-mini
AI_BASE_URL=
AI_API_KEY=change-me-ai-api-key
AI_REQUEST_TIMEOUT_MS=15000
AI_CONNECT_TIMEOUT_MS=5000

# Per-provider secrets referenced by ProviderCredential.credential_ref, one
# file per ref under ./secrets (bind-mounted read-only into both `web` and
# `agent` — LLD §5.3's directory-mounted SecretStorePort). Not env vars;
# listed here only as a reminder to populate ./secrets/<ref> files before
# first deploy, e.g.:
#   ./secrets/deepgram          -> Deepgram self-hosted API key
#   ./secrets/elevenlabs        -> ElevenLabs API key (optional remote TTS)
#   ./secrets/alibaba-liveavatar -> Alibaba LiveAvatar bearer token (optional remote avatar)

