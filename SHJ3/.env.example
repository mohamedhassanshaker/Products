# SHJ3 — environment contract.
#
# Copy to `.env` for local work. `.env` is gitignored and must never be committed;
# secrets live in Kubernetes secrets in every deployed environment (ADR-0008).
#
# Config is validated at boot and the process REFUSES TO START if a required
# value is absent. That is deliberate: a service that starts with a missing
# secret and fails later is harder to diagnose than one that refuses immediately.
#
# The values below are local-development defaults matching docker-compose.yml.
# None of them are usable in a deployed environment.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
SHJ3_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# SQL Server — system of record, schema per tenant (ADR-0002)
#
# DATABASE_URL is read by the Prisma CLI (migrate, validate, studio), which
# only accepts that name. The application reads SHJ3_SQL_URL and appends
# `schema=<tenant>` per request, so the two are the same connection with and
# without a schema binding. Keep them in step.
# ---------------------------------------------------------------------------
DATABASE_URL="sqlserver://localhost:1433;database=shj3;user=sa;password=Shj3_Local_Dev!2026;encrypt=true;trustServerCertificate=true"
SHJ3_SQL_URL="sqlserver://localhost:1433;database=shj3;user=sa;password=Shj3_Local_Dev!2026;encrypt=true;trustServerCertificate=true"
MSSQL_SA_PASSWORD="Shj3_Local_Dev!2026"

# Bounded per-tenant client pool. N tenants means N pools, and
# SHJ3_SQL_POOL_MAX x N can exhaust SQL Server well before the tenant count
# feels large (RISK-021). This is a resource ceiling, not a cache tuning knob.
SHJ3_SQL_MAX_RESIDENT_CLIENTS=32

# Least-privilege user for the AI service: SELECT on everything, INSERT/UPDATE
# on conversation turns, orchestration traces and re-index job status only.
# The grant IS the control (ADR-0005 rule 5) — not the code.
SHJ3_SQL_DSN="mssql+aioodbc://sa:Shj3_Local_Dev!2026@localhost:1433/shj3?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes"

# ---------------------------------------------------------------------------
# Neo4j — knowledge graph, SINGLE Community database with logical tenant
# partitioning (ADR-0009).
#
# bolt:// not neo4j:// — Community cannot cluster, so a routing URI has nothing
# to route to and fails with a confusing discovery error. Use bolt+s:// in any
# deployed environment.
# ---------------------------------------------------------------------------
SHJ3_NEO4J_URI=bolt://localhost:7687
SHJ3_NEO4J_USERNAME=neo4j
SHJ3_NEO4J_PASSWORD=shj3_local_dev
NEO4J_PASSWORD=shj3_local_dev
# One database for every tenant. Isolation is the Tenant_<slug> label plus the
# tenant_id property, enforced by the query builder (RISK-024).
SHJ3_NEO4J_DATABASE=neo4j
SHJ3_NEO4J_TENANT_LABEL_PREFIX=Tenant_

# ---------------------------------------------------------------------------
# Qdrant — vector index, collection per tenant (ADR-0002)
# ---------------------------------------------------------------------------
SHJ3_QDRANT_URL=http://localhost:6333
SHJ3_QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Redis — ephemeral only, key prefix per tenant, NOT backed up (ADR-0003).
#
# If losing a key can cause a side effect to repeat, the key is not ephemeral:
# payment idempotency is a unique constraint on the transaction row, and only
# its short-lived in-flight lock lives here (ADR-0003 rule 2, RISK-012).
# ---------------------------------------------------------------------------
SHJ3_REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Model providers (ADR-0004). All three behind ports, so a swap is one adapter.
#
# RISK-001: these send citizen text to OpenRouter, OpenAI and Cohere, which
# conflicts with the "UAE — Sharjah data centre" residency default the product
# itself exposes in B14 tab 4. Production requires either a signed residency
# exception or a swap to self-hosted BGE-M3 + bge-reranker-v2-m3.
#
# Left empty in development, where the runtime falls back to the deterministic
# stub adapters the test suite uses — a non-deterministic model cannot be an
# assertion target, and this is what lets the pipeline be built without spend.
# ---------------------------------------------------------------------------
SHJ3_OPENROUTER_API_KEY=
SHJ3_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

SHJ3_OPENAI_API_KEY=
SHJ3_OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Recorded per Qdrant collection at provisioning. Changing the model or the
# dimension is a FULL re-index, never a partial one — mixing dimensions in one
# collection destroys retrieval quality silently (ADR-0004 rule 3, RISK-016).
SHJ3_OPENAI_EMBEDDING_DIM=3072

SHJ3_COHERE_API_KEY=
SHJ3_COHERE_RERANK_MODEL=rerank-v3.5

# Required in production only. Boot fails without it when a model provider key
# is set and the environment is production.
SHJ3_RESIDENCY_EXCEPTION_REF=

# ---------------------------------------------------------------------------
# Authentication (ADR-0006)
#
# Local accounts now, behind an IdentityProvider port; OIDC (Entra ID or
# Keycloak) and UAE PASS later. Sessions are opaque server-side records in
# Redis, never JWTs carrying claims the app interprets — so revocation is
# immediate, which B9's Suspended state requires.
# ---------------------------------------------------------------------------
SHJ3_SESSION_SECRET=local-dev-session-secret-not-for-production
SHJ3_SESSION_TTL_SECONDS=28800

# AES-256-GCM envelope key (deployment.md §16 var #12) — base64, must decode to exactly
# 32 bytes. Unlike SHJ3_SESSION_SECRET's placeholder above, this HAS to be a real,
# validly-shaped key even in development: AES-256's key length is a structural
# requirement of the algorithm, not a "stronger in production" policy, so a wrong-length
# value fails at boot in every environment (config.ts). Encrypts StaffCredentials'
# totpSecretCipher (B-2) and, later, tenant-held connector credentials at rest. Generate a
# real one with `openssl rand -base64 32` — never reuse this checked-in value outside a
# developer's own machine; rotating it later means re-encrypting every row it protects
# (deployment.md §16.6), so get it right before the first secret is ever encrypted with it.
SHJ3_ENCRYPTION_KEY=+yddTmNwlSyCtqzv2bABbnYmDiwu9hojxvkrJ73e4U8=

# Citizen verification adapter. `mock` implements all four assurance levels as a
# first-class fixture so B11's step-up rules are testable before UAE PASS exists.
#
# The process REFUSES TO BOOT with `mock` when SHJ3_ENVIRONMENT=production
# (ADR-0006 rule 6). A mocked verification path in front of real payments is the
# worst failure this system could have, so it is prevented at startup rather
# than by policy.
SHJ3_VERIFICATION_ADAPTER=mock

# Payment gateway adapter (B-8). `mock` settles every payment intent
# deterministically, with no real gateway ever called.
#
# The process REFUSES TO BOOT with `mock` when SHJ3_ENVIRONMENT=production —
# the payments analogue of ADR-0006 rule 6 above, for the identical reason: a
# mocked payment path in front of real citizen money is the worst failure this
# system could have.
SHJ3_PAYMENT_GATEWAY_ADAPTER=mock

# ---------------------------------------------------------------------------
# Internal service hop (ADR-0001). mTLS in a deployed environment.
# ---------------------------------------------------------------------------
SHJ3_AI_BASE_URL=http://localhost:8000
SHJ3_AI_ROLE=api

# Platform-scope credential for the internal provisioning API.
#
# mTLS establishes WHICH service is calling and the NetworkPolicy makes shj3-web the only
# one that can — neither establishes that a call is a sanctioned platform operation, since
# shj3-web is also the caller for every ordinary tenant-scoped request. Provisioning is one
# of only two audited cross-tenant paths (ADR-0002 rule 5), so it carries its own
# credential and shj3-ai requires it. An unset value CLOSES the endpoints; it never opens
# them.
SHJ3_AI_PLATFORM_TOKEN=local-dev-platform-token-not-for-production

# Upper bound on one call over this hop — a turn request, and the internal provisioning
# calls of RB-09 steps 2 and 3. Must exceed shj3-ai's own ceiling, or a streamed answer is
# cut mid-sentence.
SHJ3_AI_TIMEOUT_MS=120000
# Model client init (LiteLLM router construction, provider handshakes) is slow.
# The application gives up BEFORE the Kubernetes startup probe does, so the
# failure is a diagnosable log line rather than a restart loop.
SHJ3_AI_MODEL_INIT_TIMEOUT_S=90

# B-6: the inbound WhatsApp webhook (`/api/webhooks/whatsapp`, api.md §4.4/§10.1).
# `SHJ3_WHATSAPP_WEBHOOK_VERIFY_TOKEN` is compared, constant-time, against Meta's
# `hub.verify_token` on the one-time `GET` subscription handshake. `SHJ3_WHATSAPP_APP_SECRET`
# is the HMAC-SHA256 key every inbound `POST`'s `X-Hub-Signature-256` is verified against,
# over the raw body bytes, before any JSON parsing — an unset value CLOSES the webhook (every
# signature check fails), it never opens it.
SHJ3_WHATSAPP_WEBHOOK_VERIFY_TOKEN=local-dev-whatsapp-verify-token-not-for-production
SHJ3_WHATSAPP_APP_SECRET=local-dev-whatsapp-app-secret-not-for-production
# Per-pod concurrency ceiling (deployment.md §16 var #21). /readyz sheds load
# to other pods once active turns reach this value, and it is the numerator
# the shj3-ai HPA's concurrency metric scales against (§7.5).
SHJ3_AI_MAX_CONCURRENT_TURNS=24

# ---------------------------------------------------------------------------
# Observability. One trace id spans web -> ai -> tool call, which is what makes
# B14 tab 3 real rather than decorative.
# ---------------------------------------------------------------------------
SHJ3_OTEL_EXPORTER_OTLP_ENDPOINT=
SHJ3_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# B10 tab 2: the web widget embed snippet's script origin.
#
# Only needed when the public asset domain differs from what the request's own Host
# header says — a real production deployment serving the widget bundle from a CDN in
# front of shj3-web. Left unset here: `/channels` derives the real origin from the
# request itself (X-Forwarded-Host/Host + X-Forwarded-Proto, falling back to a bare
# local next dev's own plain Host header) rather than a hardcoded placeholder domain.
# ---------------------------------------------------------------------------
SHJ3_WIDGET_SCRIPT_ORIGIN=

# ---------------------------------------------------------------------------
# Local port remap — only needed if another project's compose stack already
# holds a default port on this machine (this repo shares a Docker daemon with
# unrelated projects in development). docker-compose.yml's checked-in
# defaults are the standard ports; override only what collides.
# ---------------------------------------------------------------------------
# NEO4J_HTTP_PORT=17474
# NEO4J_BOLT_PORT=17687
# REDIS_PORT=16379
