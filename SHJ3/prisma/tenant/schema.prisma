// =====================================================================================
//  SHJ3 — Prisma schema: TENANT (SQL Server)
//  One of two schema files that together are this system's single source of truth for
//  its relational shape (ADR-0005, ADR-0011). This file owns the 112 per-tenant models
//  (§3.1) — the TEMPLATE every tenant schema is created from. Its sibling is
//  prisma/platform/schema.prisma — the 23 genuinely global models. Read ADR-0011 before
//  touching either file.
//  Spec: docs/data-model.md — §1 conventions, §3 tenancy keys, §4 entity catalogue,
//        §10 retention, §13 entity counts. Follow the spec, not intuition.
// =====================================================================================
//
//  READ THIS FIRST — THIS FILE IS NOT A LIVE TABLE SET
//  ------------------------------------------------------------------------------------
//  Every model below is declared with NO `@@schema()` attribute and this generator does
//  NOT enable `multiSchema` (see "WHY NO multiSchema HERE" below). At migration-authoring
//  time this file's DDL is applied against `tenant_template`, a REAL SQL Server schema
//  that exists ONLY to receive it — AT RUNTIME NO ROW IS EVER READ OR WRITTEN IN
//  `tenant_template`. The tenant set is dynamic: a schema is created when a Sharjah
//  government entity is onboarded (`sewa`, `customs`, `libraries`, `sharjah_platform`,
//  …), and a static Prisma schema cannot enumerate a set that grows at runtime. So:
//
//    1. Prisma Migrate emits the per-tenant DDL once, against `tenant_template`.
//    2. The per-tenant migration orchestrator (ADR-0005 §2, resumable, N×) replays that
//       same DDL under each tenant's validated slug, and applies
//       `prisma/sql/001_constraints.sql` with `{{SCHEMA}}` substituted per tenant.
//    3. At request scope the app builds a `PrismaClient` from THIS file's generated
//       client, whose SQL Server connection string carries `schema=<slug>` — one client
//       per tenant, pooled and cached (`tenant-db.ts`'s `getTenantDb()`). Unqualified
//       identifiers then resolve inside the tenant's own schema, because there is no
//       `multiSchema` here to override that resolution with a compile-time constant
//       (ADR-0011). `getTenantDb()` is the only way in; there is no unscoped client and
//       therefore no vocabulary in which an application author can express a
//       cross-tenant query (§3.5).
//
//  A future reader who assumes `tenant_template` holds live rows will misread the entire
//  model. It holds the shape; the tenants hold the rows.
//
//  WHY NO multiSchema HERE (ADR-0011 — supersedes ADR-0010's amendment of ADR-0005)
//  ------------------------------------------------------------------------------------
//  The ORIGINAL design (before ADR-0011) declared these models with `@@schema("tenant_template")`
//  in the SAME file as `platform`'s models, using `multiSchema` to hold both. That does not
//  work: `multiSchema` resolves `@@schema()` to a literal schema name at `prisma generate`
//  time — a compile-time constant, identical for every generated-client instance regardless
//  of its connection string. Confirmed directly against a live database: every tenant's
//  `getTenantDb().<model>.*` query resolved against the literal `tenant_template` schema,
//  regardless of which tenant's connection string built the client (ADR-0010's finding).
//  `multiSchema` is designed to let one fixed database expose models split across a SMALL,
//  KNOWN set of fixed schemas within one client — not to let the same model set address N
//  *dynamically created* schemas chosen per connection.
//
//  A follow-up experiment, done before ADR-0010's raw-SQL fix was built, isolated the real
//  cause: a MINIMAL schema with NO `@@schema()` and NO `multiSchema` — exactly this file's
//  shape — correctly routes BOTH reads and writes via the connection string's `schema=`
//  parameter. Two clients differing only in that parameter (`probea`, `probeb`) each saw
//  only their own schema's data. So dropping `multiSchema` for the tenant models, while
//  keeping it for `platform`'s (genuinely fixed-schema) models in the OTHER file, closes
//  the defect with full Prisma ORM ergonomics preserved for 107 of 112 tenant models —
//  the outcome ADR-0011 chose over ADR-0010's raw-SQL-for-everything alternative, which is
//  now superseded. Do not implement ADR-0010.
//
//  CROSS-SCHEMA REFERENCES INTO platform
//  ------------------------------------------------------------------------------------
//  Five relationships cross the platform/tenant boundary: `RolePermission.permissionKey`
//  → `platform.Permission`, `LocaleSetting.localeCode` → `platform.Locale`,
//  `PolicySetting.policyKey` → `platform.OverridablePolicy`, `PolicyOverride.policyKey` →
//  `platform.OverridablePolicy`, `VersionDeployment.environmentKey` →
//  `platform.Environment`. Prisma cannot express a `@relation` across two separately
//  generated clients, so each of these five is a PLAIN SCALAR field here — no `@relation`,
//  no Prisma-level `include`/nested-write sugar — with a `///` doc comment on the field
//  itself pointing at ADR-0011 and naming the platform model it references. This is NOT an
//  oversight if you go looking for a `@relation` on one of these five fields and do not
//  find one. A query needing both sides performs two reads — one via `getPlatformDb()`,
//  one via `getTenantDb()` — and joins in application code. The underlying SQL Server
//  FOREIGN KEY constraint for each of the five is unaffected: hand-written, idempotent DDL
//  in `prisma/sql/001_constraints.sql`, `{{SCHEMA}}`-templated on the tenant side — not
//  Prisma-managed, so it does not depend on this file declaring the relation, and will not
//  silently disappear the next time this file's migration history is diffed.
//
//  ------------------------------------------------------------------------------------
//  CONVENTIONS (§1) — applied without exception, identically in both schema files
//  ------------------------------------------------------------------------------------
//  * Model names are PascalCase singular; `@@map` gives the PascalCase-plural table
//    name (§1.1). Columns are camelCase singular and carry NO `@map`, so the generated
//    SQLAlchemy attributes mirror the column names character-for-character and the
//    pre-commit drift check (ADR-0005 §4) is trivially total.
//  * Ids are ULIDs stored as `CHAR(26)` (`Latin1_General_100_BIN2`), generated
//    client-side in both runtimes, clustered primary key (§1.2). `autoincrement()` is
//    NOT used for entity ids — see §1.2's rejection of `INT IDENTITY`.
//  * Every `…At` column is `DATETIME2`, always UTC, and `createdAt` / `updatedAt` are
//    always set by the application — no database-side default, because two runtimes plus
//    a clock-sensitive audit log must have exactly one clock source (§1.3). §1.3 also
//    fixes the precision at `(3)`: Prisma's `@db.DateTime2` takes no precision argument,
//    so the millisecond precision is applied by a single set-based `ALTER COLUMN` loop
//    over `sys.columns` in `prisma/sql/001_constraints.sql` rather than being restated on
//    ~500 fields. Wall-clock business data is `TIME` (working hours, quiet hours) plus an
//    IANA zone column, never converted to UTC at rest.
//  * Soft delete is NOT uniform (§1.4). `deletedAt` (or `removedAt`) exists if and only
//    if a historical record or an audit entry can point at the row. Configuration leaves
//    and join rows are hard-deleted. Append-only ledgers are never deleted.
//  * NO Prisma `enum` and NO Prisma `Json`: the SQL Server connector supports neither
//    (§1.5). Closed sets are `VarChar(32)`-style columns whose permitted values are
//    asserted by a generated `CK_<Table>_<column>` CHECK constraint; JSON payloads are
//    `NVarChar(Max)` with `CK_<Table>_<col>_isJson`. Both live in
//    `prisma/sql/001_constraints.sql`, emitted from `packages/contracts/src/enums.ts`.
//
//  ------------------------------------------------------------------------------------
//  WHAT THIS FILE CANNOT SAY — and where it is said instead
//  ------------------------------------------------------------------------------------
//  Prisma's SQL Server connector cannot declare CHECK constraints, filtered/partial
//  indexes, computed/PERSISTED columns, triggers, views or GRANTs. data-model.md
//  specifies many of each and they carry real business rules — the append-only audit
//  log, the delete-blocking trigger on `Transactions`, `retentionExpiresAt` as a
//  computed column, the unique-current-version constraint, the
//  `assuranceLevelAtPayment <> 'Anonymous'` check that stops an unverified payment.
//
//  Every one of them is hand-written T-SQL in `prisma/sql/001_constraints.sql`,
//  idempotent, `{{SCHEMA}}`-parameterised, and applied once per tenant schema by the
//  orchestrator. Where a rule left this file, the owning model or field carries a `///`
//  doc comment naming the constraint and the file. A reader of this schema must never
//  conclude a rule is absent — it is elsewhere, by necessity, and it is named.
//
//  `staffUserId`-shaped columns are `Char(26)` references to `platform.StaffUsers` that
//  are deliberately NOT declared as foreign keys (and could not be — StaffUsers lives in
//  the other schema file). Three reasons: (a) `StaffUsers` is soft-deleted and audit
//  legibility is preserved by the `actor…Snapshot` columns, not by the reference (§4.13);
//  (b) a tenant schema must remain self-describing if restored in isolation, which is why
//  `TenantProfiles` exists at all (§4.1); (c) ADR-0002's positive consequence — migrating
//  a tenant schema into its own database — is defeated by a dense web of cross-schema
//  references, the same property §1.2 cites when rejecting `INT IDENTITY`. Referential
//  integrity for these columns is maintained by the application; the five FKs named above
//  are the ones that do enforcement work no other mechanism can.
// =====================================================================================

generator client {
  provider = "prisma-client-js"
  // Distinct from platform/schema.prisma's client — two schema files, two generators, two
  // generated clients (ADR-0011). Output kept outside src/ and outside node_modules'
  // implicit default location, because that default can only serve one generated client
  // per project; both are named explicitly and gitignored (never committed — regenerated
  // by `pnpm db:generate`).
  //
  // Deliberately NO `previewFeatures = ["multiSchema"]` and no `@@schema()` on any model
  // below — see "WHY NO multiSchema HERE" above. This is what makes `getTenantDb()`'s
  // per-connection schema routing actually take effect.
  output   = "../generated/tenant-client"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  // No `schemas = [...]` array: that is multiSchema-only configuration, and this file
  // deliberately does not use multiSchema (see above). At runtime `getTenantDb()`
  // constructs each client with its own tenant's `schema=<slug>` appended to this base
  // URL (`tenant-db.ts`); `DATABASE_URL` here matters only to `prisma generate` /
  // `prisma migrate`, which need a schema to author DDL against (`tenant_template`).
}

// #####################################################################################
// #                                                                                   #
// #   TENANT TEMPLATE SCHEMA — replicated into every tenant schema.                    #
// #                                                                                   #
// #   Reminder: no row is ever read or written in `tenant_template` itself. The DDL    #
// #   below is replayed under each tenant's validated slug (`sewa`, `customs`,         #
// #   `libraries`, `sharjah_platform`, ...) by the per-tenant migration orchestrator,  #
// #   and `prisma/sql/001_constraints.sql` is applied N times with `{{SCHEMA}}`        #
// #   substituted. See the header block.                                               #
// #                                                                                   #
// #####################################################################################

// -------------------------------------------------------------------------------------
// tenant · 4.1 tenancy substrate + outbox
// -------------------------------------------------------------------------------------

/// The one-row-per-schema mirror of the tenant's own registry entry (§4.1). It exists so
/// per-tenant triggers and queries can read tenant facts without a cross-schema join,
/// and so a tenant schema is self-describing if it is ever restored in isolation. Kept
/// in sync by the provisioning path and by `TR_Tenants_syncProfiles`.
///
/// `isPlatformTenant` is read by `TR_Teams_crossEntityScope`, which is what makes B9
/// tab 2's "Platform to All entities" row legitimate and a SEWA-created equivalent not.
///
/// Singleton shape (§4.1): `CK_TenantProfiles_singleton CHECK (singletonKey = 1)` in
/// `prisma/sql/001_constraints.sql`.
model TenantProfile {
  id               String   @id @db.Char(26)
  singletonKey     Int      @unique(map: "UQ_TenantProfiles_singleton") @default(1) @db.TinyInt
  tenantId         String   @db.Char(26)
  slug             String   @db.VarChar(30)
  displayName      String   @db.NVarChar(200)
  isPlatformTenant Boolean
  dataResidency    String   @db.VarChar(32)
  createdAt        DateTime @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2

  @@map("TenantProfiles")
}

/// Derived-store write intents, committed in the same SQL Server transaction as the
/// domain change (ADR-0003 rule 4, §9.1). No distributed transactions: writes are
/// ordered SQL Server first, then the derived stores, with this table and a
/// reconciliation job. If a derived write fails, the system of record is still correct
/// and re-index repairs the index.
///
/// In `prisma/sql/001_constraints.sql`: the filtered claim index
/// `IX_OutboxEvents_claimable ON (availableAt, id) INCLUDE (...) WHERE state IN
/// ('Pending','Failed')` — filtered so it stays small as `Applied` rows accumulate —
/// plus `IX_OutboxEvents_dead ... WHERE state = 'Dead'`, `CK_OutboxEvents_state`,
/// `CK_OutboxEvents_appliedPaired`, `CK_OutboxEvents_lockPaired`,
/// `CK_OutboxEvents_deadIsExhausted` and `CK_OutboxEvents_payloadJson_isJson`.
model OutboxEvent {
  id            String    @id @db.Char(26)
  /// `Chunk` | `SourceDocument` | `GraphNodeRecord` | `GraphEdgeRecord` | `KnowledgeSource`.
  aggregateKind String    @db.VarChar(48)
  aggregateId   String    @db.Char(26)
  /// `ChunkUpserted` | `ChunkDeleted` | `GraphNodeMerged` | `SourceRemoved` | ...
  eventType     String    @db.VarChar(64)
  /// `Neo4j` | `Qdrant` | `Both`.
  targetStore   String    @db.VarChar(16)
  payloadJson   String    @db.NVarChar(Max)
  /// A retried application-level operation produces the same intent once.
  dedupeKey     String    @unique(map: "UQ_OutboxEvents_dedupeKey") @db.VarChar(160)
  /// `Pending` | `InFlight` | `Applied` | `Failed` | `Dead`.
  state         String    @db.VarChar(12)
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(8)
  /// Backoff schedule.
  availableAt   DateTime  @db.DateTime2
  lockedBy      String?   @db.VarChar(64)
  lockedUntil   DateTime? @db.DateTime2
  lastError     String?   @db.NVarChar(Max)
  appliedAt     DateTime? @db.DateTime2
  occurredAt    DateTime  @db.DateTime2
  createdAt     DateTime  @db.DateTime2
  updatedAt     DateTime  @updatedAt @db.DateTime2

  @@index([aggregateKind, aggregateId, occurredAt], map: "IX_OutboxEvents_aggregate")
  @@map("OutboxEvents")
}

/// Drift detection and repair between SQL Server and the two derived stores (§9.3).
/// Handles what the outbox cannot: a `Dead` row, and drift introduced outside the write
/// path — a restored Neo4j backup, a manually dropped Qdrant collection.
///
/// For `store = 'Neo4j'`, `driftFound` carries two kinds of drift: an index behind the
/// record, which is expected and repairable, and a **malformed partition**, which is
/// neither — the three zero-assertions of §9.3 step 6 stand in for the property-existence
/// constraints Neo4j Community cannot enforce, so a non-zero result pages rather than
/// enqueuing a re-index (standing RISK-024).
///
/// `CK_ReconciliationRuns_store`, `_scope` and `_state` live in
/// `prisma/sql/001_constraints.sql`.
model ReconciliationRun {
  id                 String    @id @db.Char(26)
  /// `Neo4j` | `Qdrant`.
  store              String    @db.VarChar(16)
  /// `Tenant` | `Collection` | `Source`.
  scope              String    @db.VarChar(16)
  knowledgeSourceId  String?   @db.Char(26)
  expectedCount      Int
  observedCount      Int
  driftFound         Int
  driftRepaired      Int
  /// `Dead` rows returned to `Pending` after their cause was fixed.
  deadOutboxRequeued Int
  /// The scoped `ReindexJob` raised where drift exceeded the inline-repair threshold.
  reindexJobId       String?   @db.Char(26)
  state              String    @db.VarChar(12)
  startedAt          DateTime  @db.DateTime2
  finishedAt         DateTime? @db.DateTime2
  createdAt          DateTime  @db.DateTime2
  updatedAt          DateTime  @updatedAt @db.DateTime2

  knowledgeSource KnowledgeSource? @relation(fields: [knowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reindexJob      ReindexJob?      @relation(fields: [reindexJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([store, startedAt(sort: Desc)], map: "IX_ReconciliationRuns_store_startedAt")
  @@map("ReconciliationRuns")
}

// -------------------------------------------------------------------------------------
// tenant · 4.2 iam — teams, roles, the 7x8 matrix
// -------------------------------------------------------------------------------------

/// B9 tab 2 teams with an entity scope.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_Teams_name ... WHERE deletedAt IS NULL`,
/// `CK_Teams_scope`, and `TR_Teams_crossEntityScope` — `scope = 'AllEntities'` is
/// rejected unless `TenantProfiles.isPlatformTenant = 1`.
model Team {
  id          String    @id @db.Char(26)
  name        String    @db.NVarChar(120)
  /// `Tenant` | `AllEntities`.
  scope       String    @db.VarChar(16)
  description String?   @db.NVarChar(1000)
  isSystem    Boolean
  deletedAt   DateTime? @db.DateTime2
  createdAt   DateTime  @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2

  members            TeamMember[]
  roleAssignments    UserRoleAssignment[]
  routingRules       RoutingRule[]
  cannedReplies      CannedReply[]
  escalationTickets  EscalationTicket[]
  handoverDefaultFor HandoverConfig[]     @relation("HandoverDefaultQueue")
  handoverAlertFor   HandoverConfig[]     @relation("HandoverSupervisorAlert")

  @@map("Teams")
}

/// Team membership; B9 tab 2's chips are derived from this, live. A genuine
/// many-to-many with an `isPrimary` flag — B9 tab 1's table shows one Team per user
/// while its Edit dialog offers plural team pills, and this satisfies both readings
/// (§4.2 ASSUMPTION 1). Hard-deleted (§1.4): a join row nothing historical points at.
///
/// `UQ_TeamMembers_primary (staffUserId) WHERE isPrimary = 1` — the registry's single
/// "Team" column renders the primary — is filtered and lives in
/// `prisma/sql/001_constraints.sql`.
model TeamMember {
  id                 String   @id @db.Char(26)
  teamId             String   @db.Char(26)
  /// References `platform.StaffUsers.id`; not FK-enforced (see the header block).
  staffUserId        String   @db.Char(26)
  isPrimary          Boolean
  addedByStaffUserId String   @db.Char(26)
  addedAt            DateTime @db.DateTime2
  createdAt          DateTime @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([teamId, staffUserId], map: "UQ_TeamMembers_teamId_staffUserId")
  @@index([staffUserId], map: "IX_TeamMembers_staffUserId")
  @@map("TeamMembers")
}

/// The 7 seeded roles plus custom ones. Per-tenant, which is what makes B9 tab 3's
/// **+ Add custom role** work while `platform.Permissions` stays closed.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_Roles_key ... WHERE deletedAt IS NULL`,
/// `UQ_Roles_ordinal ... WHERE deletedAt IS NULL` (fixes the matrix column order), and
/// `TR_Roles_blockSystemDelete` — a system role cannot be soft-deleted.
model Role {
  id          String    @id @db.Char(26)
  key         String    @db.VarChar(64)
  displayName String    @db.NVarChar(200)
  isSystem    Boolean
  ordinal     Int       @db.SmallInt
  description String?   @db.NVarChar(1000)
  deletedAt   DateTime? @db.DateTime2
  createdAt   DateTime  @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("Roles")
}

/// The 7x8 matrix. **One row per *granted* cell** — B9 tab 3 renders a dash for a
/// missing row. Storing `granted BIT` instead would create two representations of "no"
/// (`0` and absent) and the effective-permission query would have to handle both; deny
/// by default (architecture §10) means absence is the only sensible encoding.
/// Hard-deleted (§1.4).
///
/// `FK_RolePermissions_Permissions` is one of the four deliberate cross-schema foreign
/// keys (see the header block): a tenant cannot invent a permission, because a permission
/// with no enforcement point is a lie in a matrix.
///
/// `TR_RolePermissions_protectSuperAdmin` — the `super_admin` row for
/// `manage_users_teams` cannot be revoked, or the tenant locks itself out — lives in
/// `prisma/sql/001_constraints.sql`.
model RolePermission {
  id                   String   @id @db.Char(26)
  roleId               String   @db.Char(26)
  /// References `platform.Permission.key` — NOT a Prisma `@relation`. `Permission` lives
  /// in prisma/platform/schema.prisma, a separate generated client; Prisma cannot express
  /// a relation across two clients (ADR-0011). The SQL Server FOREIGN KEY constraint
  /// (`RolePermissions_permissionKey_fkey`) is unaffected — hand-written, idempotent DDL
  /// in prisma/sql/001_constraints.sql, not Prisma-managed. A caller needing the
  /// `Permission` row reads it separately via `getPlatformDb()`.
  permissionKey        String   @db.VarChar(64)
  grantedByStaffUserId String   @db.Char(26)
  grantedAt            DateTime @db.DateTime2
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([roleId, permissionKey], map: "UQ_RolePermissions_roleId_permissionKey")
  @@map("RolePermissions")
}

/// Which roles a user holds **in this tenant**. Hard-deleted (§1.4) — the audit entry
/// records the before/after state as JSON, not a foreign key, precisely so this can be
/// deleted cleanly.
model UserRoleAssignment {
  id                    String   @id @db.Char(26)
  /// References `platform.StaffUsers.id`; not FK-enforced (see the header block).
  staffUserId           String   @db.Char(26)
  roleId                String   @db.Char(26)
  /// Optional narrowing of the role to one team.
  scopeTeamId           String?  @db.Char(26)
  assignedByStaffUserId String   @db.Char(26)
  assignedAt            DateTime @db.DateTime2
  createdAt             DateTime @db.DateTime2
  updatedAt             DateTime @updatedAt @db.DateTime2

  role      Role  @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  scopeTeam Team? @relation(fields: [scopeTeamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([staffUserId, roleId], map: "UQ_UserRoleAssignments_staffUserId_roleId")
  @@index([roleId], map: "IX_UserRoleAssignments_roleId")
  @@map("UserRoleAssignments")
}

/// Singleton. Session/lockout policy, previously only the hardcoded defaults in
/// `modules/iam/domain/{session,lockout}.ts` (30min idle / 12h absolute staff session,
/// 5 failures / 15min lock, 1s->8s backoff) — this table makes those tenant-editable
/// while keeping the SAME values as the row's own seeded defaults, so a tenant that never
/// opens the Security tab sees no behavior change (mirrors `FlowAssistantConfig`'s own
/// "seed with the prior hardcoded default" convention exactly).
///
/// In `prisma/sql/001_constraints.sql`: `UQ_SecurityPolicies_singleton`,
/// `CK_SecurityPolicies_singleton CHECK (singletonKey = 1)`, plus range checks on every
/// numeric column (never zero/negative, never an absurdly large window).
model SecurityPolicy {
  id                        String   @id @db.Char(26)
  singletonKey              Int      @unique(map: "UQ_SecurityPolicies_singleton") @default(1) @db.TinyInt
  staffSessionIdleMinutes   Int      @db.SmallInt
  staffSessionAbsoluteHours Int      @db.SmallInt
  lockoutFailuresBeforeLock Int      @db.TinyInt
  lockoutDurationMinutes    Int      @db.SmallInt
  backoffCeilingSeconds     Int      @db.TinyInt
  updatedByStaffUserId      String?  @db.Char(26)
  createdAt                 DateTime @db.DateTime2
  updatedAt                 DateTime @updatedAt @db.DateTime2

  @@map("SecurityPolicies")
}

// -------------------------------------------------------------------------------------
// tenant · 4.3 conversation — sessions, turns, transcripts, feedback
// -------------------------------------------------------------------------------------

/// One citizen conversation across one channel session (A1-A3, B1 tab 2).
///
/// `retentionExpiresAt` is stamped **at creation** from
/// `PrivacyConfigs.transcriptRetention` as it stood then (§10.2), so shortening the
/// setting does not retroactively delete conversations the citizen was told would be kept
/// for 90 days, and lengthening it does not resurrect what is gone.
///
/// In `prisma/sql/001_constraints.sql`:
/// **`CK_Conversations_piiMaskApplied CHECK (piiMaskApplied = 1)`** — architecture §10
/// requires masking *before* persistence, so the unmasked state is made unrepresentable
/// rather than merely discouraged; the column is an assertion that the masking step ran.
/// Also `CK_Conversations_outcome`, the filtered sweep index
/// `IX_Conversations_retentionExpiresAt ... WHERE erasedAt IS NULL`, and
/// `IX_Conversations_citizenIdentityId ... WHERE citizenIdentityId IS NOT NULL`.
model Conversation {
  id                  String    @id @db.Char(26)
  /// `WebWidget` | `WhatsApp` | `MobileApp` | `KioskIvr`. Stored as a **value**, not an
  /// FK to a live channel: disabling a channel stops new conversations only, and a
  /// foreign key to a "live channel" concept would make that carve-out inexpressible
  /// (§4.10).
  channelKey          String    @db.VarChar(24)
  localeCode          String    @db.VarChar(16)
  citizenIdentityId   String?   @db.Char(26)
  primaryAgentId      String?   @db.Char(26)
  intentKey           String?   @db.VarChar(64)
  /// `Active` | `Resolved` | `Escalated` | `Abandoned`.
  outcome             String    @db.VarChar(16)
  wasContained        Boolean
  turnCount           Int
  externalSubjectHash String?   @db.Char(64)
  redisSessionKey     String?   @db.NVarChar(120)
  startedAt           DateTime  @db.DateTime2
  lastTurnAt          DateTime  @db.DateTime2
  endedAt             DateTime? @db.DateTime2
  piiMaskApplied      Boolean
  retentionExpiresAt  DateTime  @db.DateTime2
  /// Set by the retention sweep, which leaves a stub with narrative columns nulled so
  /// `ConversationMetricsDaily` stays explicable across a retention boundary
  /// (§10.2 ASSUMPTION 11). Full-row deletion happens only in the erasure path.
  erasedAt            DateTime? @db.DateTime2
  createdAt           DateTime  @db.DateTime2
  updatedAt           DateTime  @updatedAt @db.DateTime2

  citizenIdentity      CitizenIdentity?      @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  primaryAgent         Agent?                @relation(fields: [primaryAgentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  turns                ConversationTurn[]
  slots                ConversationSlot[]
  traces               OrchestrationTrace[]
  escalationTickets    EscalationTicket[]
  transactions         Transaction[]
  goldenCases          GoldenCase[]
  verificationAttempts VerificationAttempt[]

  @@index([startedAt, outcome], map: "IX_Conversations_startedAt_outcome")
  @@index([channelKey, startedAt], map: "IX_Conversations_channelKey_startedAt")
  @@map("Conversations")
}

/// One message. **AI-writable — grant group 1** (ADR-0005 rule 5, §3.6): `shj3_ai` holds
/// `INSERT, UPDATE` here and nowhere outside the three groups. Cascade-deleted with the
/// parent conversation (§1.4).
///
/// In `prisma/sql/001_constraints.sql`: `CK_ConversationTurns_role`,
/// `CK_ConversationTurns_contentFormat`, and
/// `CK_ConversationTurns_refusalPaired CHECK ((wasRefused = 0) = (refusalReason IS NULL))`.
model ConversationTurn {
  id             String   @id @db.Char(26)
  conversationId String   @db.Char(26)
  ordinal        Int
  /// `Citizen` | `Assistant` | `System` | `HumanAgent`.
  role           String   @db.VarChar(16)
  /// A transcript is **never** stored unmasked (architecture §10).
  contentMasked  String   @db.NVarChar(Max)
  /// `Text` | `Markdown` | `WhatsAppList`.
  contentFormat  String   @db.VarChar(16)
  agentVersionId String?  @db.Char(26)
  localeCode     String   @db.VarChar(16)
  inputTokens    Int?
  outputTokens   Int?
  latencyMs      Int?
  wasRefused     Boolean
  refusalReason  String?  @db.VarChar(48)
  createdAt      DateTime @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  conversation   Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agentVersion   AgentVersion?        @relation(fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  feedback       MessageFeedback?
  trace          OrchestrationTrace?
  citations      GroundingCitation[]
  consentEntries ConsentLedgerEntry[]

  @@unique([conversationId, ordinal], map: "UQ_ConversationTurns_conversationId_ordinal")
  @@index([agentVersionId], map: "IX_ConversationTurns_agentVersionId")
  @@map("ConversationTurns")
}

/// Thumbs up / thumbs down per assistant turn. `UQ_MessageFeedback_turnId` means one
/// verdict per message — re-rating is an update, not a second row. Cascade-deleted with
/// the conversation.
///
/// `CK_MessageFeedback_rating CHECK (rating IN ('Up','Down'))` lives in
/// `prisma/sql/001_constraints.sql`.
model MessageFeedback {
  id                 String   @id @db.Char(26)
  turnId             String   @unique(map: "UQ_MessageFeedback_turnId") @db.Char(26)
  /// `Up` | `Down`.
  rating             String   @db.VarChar(8)
  reasonTag          String?  @db.VarChar(48)
  comment            String?  @db.NVarChar(1000)
  submittedByCitizen Boolean
  createdAt          DateTime @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  turn ConversationTurn @relation(fields: [turnId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([rating, createdAt], map: "IX_MessageFeedback_rating_createdAt")
  @@map("MessageFeedback")
}

/// Durable record of a slot, written when it must survive process loss — i.e. at
/// handover (A2 step 3, A3: "the pending slot transfers"). The **live** value is in Redis
/// (§8); this row is the handover snapshot, written by `shj3-web` because
/// `ConversationSlots` is deliberately outside the AI service's three write groups
/// (§3.6).
///
/// `CK_ConversationSlots_status` and `_requiredAssurance` live in
/// `prisma/sql/001_constraints.sql`.
model ConversationSlot {
  id                String    @id @db.Char(26)
  conversationId    String    @db.Char(26)
  name              String    @db.VarChar(64)
  valueMasked       String?   @db.NVarChar(256)
  /// `Pending` | `Filled` | `Abandoned`.
  status            String    @db.VarChar(16)
  requiredAssurance String    @db.VarChar(32)
  openedAt          DateTime  @db.DateTime2
  filledAt          DateTime? @db.DateTime2
  createdAt         DateTime  @db.DateTime2
  updatedAt         DateTime  @updatedAt @db.DateTime2

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([conversationId, name], map: "UQ_ConversationSlots_conversationId_name")
  @@map("ConversationSlots")
}

/// The five suggestion chips of A1, config-driven rather than hardcoded.
///
/// `CK_QuickActions_ordinalRange CHECK (ordinal BETWEEN 1 AND 10)` and
/// `CK_QuickActions_channelScope` live in `prisma/sql/001_constraints.sql`.
model QuickAction {
  id               String   @id @db.Char(26)
  label            String   @db.NVarChar(80)
  localeCode       String   @db.VarChar(16)
  payloadIntentKey String   @db.VarChar(64)
  ordinal          Int      @db.SmallInt
  /// `All` | `WebWidget` | `WhatsApp`.
  channelScope     String   @db.VarChar(24)
  isEnabled        Boolean
  agentId          String?  @db.Char(26)
  createdAt        DateTime @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([localeCode, channelScope, ordinal], map: "UQ_QuickActions_localeCode_channelScope_ordinal")
  @@map("QuickActions")
}

// -------------------------------------------------------------------------------------
// tenant · 4.4 agents — registry, versions, wizard configuration
//
// The registry/version split is the spine of B2 and B3. B2's rule is explicit:
// "Rollback and environment promotion are distinct. Rollback changes which version is
// current; promotion (B14) moves a version between environments." Those are two pieces
// of state on two entities — `AgentVersions.isCurrent` and
// `VersionDeployments.environmentKey` — and conflating them into one status column is
// the mistake this split exists to prevent. Rollback and promotion therefore write to
// different tables, which is what makes the rule mechanical.
// -------------------------------------------------------------------------------------

/// The registry row: lifecycle, ownership, current pointer (B2).
///
/// In `prisma/sql/001_constraints.sql`: `UQ_Agents_slug ... WHERE deletedAt IS NULL`,
/// `CK_Agents_status`,
/// `CK_Agents_archivedPaired CHECK ((status = 'Archived') = (archivedAt IS NOT NULL))`,
/// and `CK_Agents_publishedHasVersion CHECK (status <> 'Published' OR currentVersionId
/// IS NOT NULL)`. Archive is a **status filter, not a delete**, because B14 tab 1 still
/// counts versions per environment (§1.4).
model Agent {
  id                   String    @id @db.Char(26)
  name                 String    @db.NVarChar(200)
  slug                 String    @db.VarChar(120)
  description          String?   @db.NVarChar(1000)
  /// The owning tenant, mirrored from `TenantProfiles` so an export is self-describing.
  ownerTenantId        String    @db.Char(26)
  /// `Draft` | `Published` | `Archived`.
  status               String    @db.VarChar(16)
  currentVersionId     String?   @db.Char(26)
  clonedFromAgentId    String?   @db.Char(26)
  createdByStaffUserId String    @db.Char(26)
  archivedAt           DateTime? @db.DateTime2
  deletedAt            DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  versions            AgentVersion[]             @relation("AgentVersionOfAgent")
  currentVersion      AgentVersion?              @relation("AgentCurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clonedFrom          Agent?                     @relation("AgentClone", fields: [clonedFromAgentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clones              Agent[]                    @relation("AgentClone")
  historyEntries      AgentVersionHistoryEntry[]
  wizardDrafts        AgentWizardDraft[]
  conversations       Conversation[]
  quickActions        QuickAction[]
  channels            Channel[]
  traces              OrchestrationTrace[]
  traceSteps          OrchestrationTraceStep[]
  routerFallbackFor   RouterConfig[]
  policyOverrides     PolicyOverride[]
  deployments         VersionDeployment[]
  regressionRuns      RegressionRun[]
  usageDaily          AgentUsageDaily[]
  metricsDaily        ConversationMetricsDaily[]
  pipelineNodes       PipelineNode[]             @relation("PipelineNodeAgent")
  pipelineFallbackFor PipelineVersion[]          @relation("PipelineVersionFallbackAgent")

  @@index([status], map: "IX_Agents_status")
  @@map("Agents")
}

/// An immutable-once-published configuration snapshot. Carries wizard steps 1-3 and 10.
///
/// In `prisma/sql/001_constraints.sql`:
/// **`UQ_AgentVersions_agentId_current (agentId) WHERE isCurrent = 1`** — two current
/// versions of one agent is unrepresentable; the computed persisted column
/// `label AS ('v' + CAST(major AS varchar) + '.' + CAST(minor AS varchar)) PERSISTED`;
/// `CK_AgentVersions_temperature CHECK (temperature BETWEEN 0 AND 2)`;
/// `CK_AgentVersions_publishedPaired`;
/// `CK_AgentVersions_fallbackDiffers CHECK (fallbackModel IS NULL OR fallbackModel <>
/// primaryModel)`; and `TR_AgentVersions_publishedImmutable` — a `Published` row's config
/// columns cannot be updated, because change means a new version.
model AgentVersion {
  id                     String    @id @db.Char(26)
  agentId                String    @db.Char(26)
  major                  Int       @db.SmallInt
  minor                  Int       @db.SmallInt
  /// `Draft` | `Published` | `Archived`.
  status                 String    @db.VarChar(16)
  isCurrent              Boolean
  systemPrompt           String    @db.NVarChar(Max)
  /// `Helpful` | `Formal` | `Concise`.
  tone                   String    @db.VarChar(16)
  primaryModel           String    @db.VarChar(120)
  fallbackModel          String?   @db.VarChar(120)
  temperature            Decimal   @db.Decimal(3, 2)
  maxOutputTokens        Int
  changeSummary          String?   @db.NVarChar(1000)
  configHash             String    @db.Char(64)
  createdByStaffUserId   String    @db.Char(26)
  publishedAt            DateTime? @db.DateTime2
  publishedByStaffUserId String?   @db.Char(26)
  clonedFromVersionId    String?   @db.Char(26)
  deletedAt              DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  agent             Agent                      @relation("AgentVersionOfAgent", fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentForAgents  Agent[]                    @relation("AgentCurrentVersion")
  clonedFrom        AgentVersion?              @relation("AgentVersionClone", fields: [clonedFromVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clones            AgentVersion[]             @relation("AgentVersionClone")
  historyEntries    AgentVersionHistoryEntry[] @relation("AgentVersionHistoryVersion")
  rolledBackFrom    AgentVersionHistoryEntry[] @relation("AgentVersionHistoryFromVersion")
  knowledgeBindings AgentKnowledgeBinding[]
  flowBindings      AgentFlowBinding[]
  channelBindings   AgentChannelBinding[]
  localeBindings    AgentLocaleBinding[]
  sandboxRuns       AgentSandboxRun[]
  wizardDrafts      AgentWizardDraft[]
  toolBindings      ToolBinding[]
  turns             ConversationTurn[]
  traces            OrchestrationTrace[]
  deployments       VersionDeployment[]
  promotionRequests PromotionRequest[]
  regressionRuns    RegressionRun[]
  gateEvaluations   GateEvaluation[]
  usageDaily        AgentUsageDaily[]
  pipelineNodePins  PipelineNode[]             @relation("PipelineNodeAgentVersionPin")

  @@unique([agentId, major, minor], map: "UQ_AgentVersions_agentId_major_minor")
  @@index([agentId, status], map: "IX_AgentVersions_agentId_status")
  @@map("AgentVersions")
}

/// The inline history list of B2, newest first. **Append-only** by grant
/// (`DENY UPDATE, DELETE`, in `prisma/sql/001_constraints.sql`) — never deleted (§1.4).
/// `kind = 'RolledBack'` carries `fromVersionId`, which is how rollback stays legible
/// without touching any `VersionDeployments` row.
model AgentVersionHistoryEntry {
  id               String   @id @db.Char(26)
  agentId          String   @db.Char(26)
  agentVersionId   String?  @db.Char(26)
  /// `Created` | `Cloned` | `Published` | `Unpublished` | `RolledBack` | `Promoted` | `Archived`.
  kind             String   @db.VarChar(24)
  note             String   @db.NVarChar(500)
  fromVersionId    String?  @db.Char(26)
  actorStaffUserId String   @db.Char(26)
  occurredAt       DateTime @db.DateTime2
  createdAt        DateTime @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentVersion AgentVersion? @relation("AgentVersionHistoryVersion", fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromVersion  AgentVersion? @relation("AgentVersionHistoryFromVersion", fields: [fromVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([agentId, occurredAt(sort: Desc)], map: "IX_AgentVersionHistoryEntries_agentId_occurredAt")
  @@map("AgentVersionHistoryEntries")
}

/// Wizard step 5: bound knowledge collections. Copied rather than shared on clone — a
/// binding is part of a version's configuration snapshot, and sharing rows would make
/// editing the clone mutate the original (§4.4). Hard-deleted (§1.4).
model AgentKnowledgeBinding {
  id                    String   @id @db.Char(26)
  agentVersionId        String   @db.Char(26)
  knowledgeCollectionId String   @db.Char(26)
  isEnabled             Boolean
  boundByStaffUserId    String   @db.Char(26)
  boundAt               DateTime @db.DateTime2
  createdAt             DateTime @db.DateTime2
  updatedAt             DateTime @updatedAt @db.DateTime2

  agentVersion        AgentVersion        @relation(fields: [agentVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  knowledgeCollection KnowledgeCollection @relation(fields: [knowledgeCollectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([agentVersionId, knowledgeCollectionId], map: "UQ_AgentKnowledgeBindings_agentVersionId_knowledgeCollectionId")
  @@map("AgentKnowledgeBindings")
}

/// Wizard step 6: bound flows, pinned to a **flow version**.
///
/// `TR_AgentFlowBindings_publishedNeedsPublishedFlow` (in
/// `prisma/sql/001_constraints.sql`) blocks a `Published` agent version from binding a
/// `Draft` flow version. The block is at **publish**, not at bind, because B3 step 6
/// lists "Update account details (Draft)" as bindable.
model AgentFlowBinding {
  id             String   @id @db.Char(26)
  agentVersionId String   @db.Char(26)
  flowId         String   @db.Char(26)
  flowVersionId  String   @db.Char(26)
  isEnabled      Boolean
  ordinal        Int      @db.SmallInt
  createdAt      DateTime @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  flowVersion  FlowVersion  @relation(fields: [flowVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([agentVersionId, flowId], map: "UQ_AgentFlowBindings_agentVersionId_flowId")
  @@map("AgentFlowBindings")
}

/// Wizard step 8: which surfaces this version runs on. Feeds B2's Channels column.
model AgentChannelBinding {
  id             String   @id @db.Char(26)
  agentVersionId String   @db.Char(26)
  channelKey     String   @db.VarChar(24)
  isEnabled      Boolean
  createdAt      DateTime @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([agentVersionId, channelKey], map: "UQ_AgentChannelBindings_agentVersionId_channelKey")
  @@map("AgentChannelBindings")
}

/// Which locales the version claims to serve. Read by the publish gate: B10 tab 5's rule
/// — "an agent bound to Arabic cannot publish until Arabic reaches 100%" — is evaluated
/// as a join of this table against `LocaleSettings.translatedPercent`, with **no stored
/// "locale-ready" flag anywhere**, because such a flag would be a fourth copy of a number
/// that already exists once (§4.14).
///
/// `UQ_AgentLocaleBindings_primary (agentVersionId) WHERE isPrimary = 1` is filtered and
/// lives in `prisma/sql/001_constraints.sql`.
model AgentLocaleBinding {
  id             String   @id @db.Char(26)
  agentVersionId String   @db.Char(26)
  localeCode     String   @db.VarChar(16)
  isPrimary      Boolean
  createdAt      DateTime @db.DateTime2
  updatedAt      DateTime @updatedAt @db.DateTime2

  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([agentVersionId, localeCode], map: "UQ_AgentLocaleBindings_agentVersionId_localeCode")
  @@map("AgentLocaleBindings")
}

/// Wizard step 9: the pre-publish sandbox exchange, kept so a publish decision is
/// reviewable.
///
/// `CK_AgentSandboxRuns_transcriptJson_isJson` and `_traceJson_isJson` live in
/// `prisma/sql/001_constraints.sql`.
model AgentSandboxRun {
  id               String   @id @db.Char(26)
  agentVersionId   String   @db.Char(26)
  transcriptJson   String   @db.NVarChar(Max)
  promptText       String   @db.NVarChar(Max)
  ranByStaffUserId String   @db.Char(26)
  traceJson        String?  @db.NVarChar(Max)
  createdAt        DateTime @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2

  agentVersion AgentVersion @relation(fields: [agentVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([agentVersionId, createdAt(sort: Desc)], map: "IX_AgentSandboxRuns_agentVersionId_createdAt")
  @@map("AgentSandboxRuns")
}

/// Wizard state that persists between steps and between sessions (§4.4 ASSUMPTION 2 —
/// B3's "all state persists when moving between steps" is in-memory in the prototype;
/// modelled server-side so a wizard survives a refresh). Hard-deleted on publish (§1.4).
///
/// `CK_AgentWizardDrafts_lastStep CHECK (lastStep BETWEEN 1 AND 10)` and
/// `CK_AgentWizardDrafts_stepStateJson_isJson` live in
/// `prisma/sql/001_constraints.sql`.
model AgentWizardDraft {
  id               String   @id @db.Char(26)
  agentId          String?  @db.Char(26)
  agentVersionId   String?  @db.Char(26)
  ownerStaffUserId String   @db.Char(26)
  lastStep         Int      @db.TinyInt
  stepStateJson    String   @db.NVarChar(Max)
  createdAt        DateTime @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2

  agent        Agent?        @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentVersion AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ownerStaffUserId, agentId], map: "UQ_AgentWizardDrafts_ownerStaffUserId_agentId")
  @@map("AgentWizardDrafts")
}

// -------------------------------------------------------------------------------------
// tenant · 4.5 orchestration — router config and traces
// -------------------------------------------------------------------------------------

/// Singleton. Everything B4 surfaces. A second `RouterConfig` would make routing
/// non-deterministic in a way no screen would reveal, which is why the singleton pattern
/// (§4.1) is a constraint rather than a convention.
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_RouterConfigs_singleton`, `CK_RouterConfigs_singleton CHECK (singletonKey = 1)`,
/// `CK_RouterConfigs_maxHops CHECK (maxHops BETWEEN 1 AND 10)`,
/// `CK_RouterConfigs_scopeListPaired CHECK ((agentSelectionScope = 'ExplicitList') =
/// (agentScopeListJson IS NOT NULL))`,
/// `CK_RouterConfigs_confidence CHECK (minRoutingConfidence BETWEEN 0 AND 1)`, plus the
/// enum checks on the four mode columns.
model RouterConfig {
  id                      String   @id @db.Char(26)
  singletonKey            Int      @unique(map: "UQ_RouterConfigs_singleton") @default(1) @db.TinyInt
  /// `Sequential` | `Parallel` | `SupervisorWorker`.
  executionMode           String   @db.VarChar(24)
  /// `IntentClassifier` | `LlmRouter` | `RuleFirst`.
  routingStrategy         String   @db.VarChar(24)
  /// `AllPublished` | `ChannelBound` | `ExplicitList`.
  agentSelectionScope     String   @db.VarChar(24)
  agentScopeListJson      String?  @db.NVarChar(Max)
  maxHops                 Int      @db.TinyInt
  maxLoopIterations       Int      @db.TinyInt
  costCeilingTokens       Int
  /// Money as an exact integer (fils-equivalent micro-AED), never a float.
  costCeilingMicroAed     BigInt
  /// `HighestConfidence` | `PreferOwningEntity` | `SupervisorArbitrates`.
  conflictResolution      String   @db.VarChar(32)
  /// `ConcatenateInOrder` | `DeduplicateOverlap` | `SupervisorRewrite`.
  responseMergePolicy     String   @db.VarChar(32)
  fallbackAgentId         String?  @db.Char(26)
  minRoutingConfidence    Decimal  @db.Decimal(5, 4)
  /// The tenant's live pipeline. `NULL` = this tenant has not activated one and
  /// `process_turn.py` runs the legacy single-agent path (`_legacy_single_agent`) driven
  /// by the flat columns above. Lives here rather than in a new singleton because this
  /// exact row is ALREADY read once per turn (`get_router_config()`) — a second
  /// singleton would mean a second read, a second `createDefault` seeding path and a
  /// second provisioning hook for one pointer.
  ///
  /// `TR_RouterConfigs_activePipelinePublished` (in `prisma/sql/001_constraints.sql`)
  /// requires this to name a `Published` `PipelineVersion`, never a Draft.
  activePipelineVersionId String?  @db.Char(26)
  createdAt               DateTime @db.DateTime2
  updatedAt               DateTime @updatedAt @db.DateTime2

  fallbackAgent         Agent?           @relation(fields: [fallbackAgentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activePipelineVersion PipelineVersion? @relation(fields: [activePipelineVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("RouterConfigs")
}

/// One trace per turn: the routing decision and its envelope (A2 trace rail, B4).
/// **AI-writable — grant group 2** (§3.6).
///
/// `pendingSlotName` exists because the AI service must be able to record *the fact of*
/// a pending slot (A2 step 3) while `ConversationSlots` stays outside its write grant —
/// the live value is in Redis and the durable slot row is written by `shj3-web` at
/// handover (§3.6).
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_OrchestrationTraces_turnId` is declared here; plus
/// `CK_OrchestrationTraces_confidence CHECK (routingConfidence IS NULL OR
/// routingConfidence BETWEEN 0 AND 1)`, `CK_OrchestrationTraces_hops CHECK (hopCount <= 50)`
/// (widened from 10 — a real multi-branch pipeline turn legitimately needs more headroom
/// than the old 3-agent ceiling), `CK_OrchestrationTraces_executionMode` (new — this
/// column had no CHECK before), and the guardrail-result enum checks.
model OrchestrationTrace {
  id                   String   @id @db.Char(26)
  conversationId       String   @db.Char(26)
  turnId               String   @unique(map: "UQ_OrchestrationTraces_turnId") @db.Char(26)
  /// `Sequential` | `Parallel` | `SupervisorWorker` | `Pipeline` — the three legacy
  /// values stay real (historical rows carry them); a graph-executed turn writes
  /// `'Pipeline'`.
  executionMode        String   @db.VarChar(24)
  routedAgentId        String?  @db.Char(26)
  routedAgentVersionId String?  @db.Char(26)
  routingConfidence    Decimal? @db.Decimal(5, 4)
  hopCount             Int      @db.TinyInt
  totalInputTokens     Int
  totalOutputTokens    Int
  totalCostMicroAed    BigInt
  pendingSlotName      String?  @db.VarChar(64)
  escapeTriggered      Boolean
  mergePolicyApplied   String?  @db.VarChar(32)
  guardrailPreResult   String   @db.VarChar(16)
  guardrailPostResult  String   @db.VarChar(16)
  /// Drops when the graph half of retrieval degrades to vector-only, which correctly
  /// makes refusal and escalation *more* likely rather than serving an ungrounded
  /// answer (§2 consequence 3).
  groundingConfidence  Decimal? @db.Decimal(5, 4)
  startedAt            DateTime @db.DateTime2
  durationMs           Int
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2
  pipelineVersionId    String?  @db.Char(26)
  pipelineDesignId     String?  @db.Char(26)
  /// The frozen `"v1.2"` label — deliberately duplicated text, not resolved via a join,
  /// the same argument `graphPath` above already makes: a trace must stay legible after
  /// the version that produced it is archived and its nodes hard-deleted.
  pipelineLabel        String?  @db.VarChar(16)
  terminalNodeKey      String?  @db.VarChar(64)
  branchCount          Int      @default(1) @db.TinyInt
  loopIterationsTotal  Int      @default(0) @db.TinyInt

  conversation       Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  turn               ConversationTurn         @relation(fields: [turnId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routedAgent        Agent?                   @relation(fields: [routedAgentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routedAgentVersion AgentVersion?            @relation(fields: [routedAgentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipelineVersion    PipelineVersion?         @relation(fields: [pipelineVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  steps              OrchestrationTraceStep[]
  citations          GroundingCitation[]

  @@index([conversationId, startedAt], map: "IX_OrchestrationTraces_conversationId_startedAt")
  @@index([routedAgentId, startedAt], map: "IX_OrchestrationTraces_routedAgentId_startedAt")
  @@map("OrchestrationTraces")
}

/// The individual lines of A2's trace rail, in order. **AI-writable — grant group 2**.
/// Cascade-deleted with the conversation.
///
/// **`CK_OrchestrationTraceSteps_toolCallHasBinding CHECK (kind <> 'ToolCall' OR
/// toolBindingId IS NOT NULL)`** (in `prisma/sql/001_constraints.sql`) is the tool
/// permission boundary showing up in the trace: a `ToolCall` step must name a
/// `ToolBinding`, not a raw tool name. A tool discovered but never bound has no
/// `ToolBinding` row, so a trace step recording its invocation **cannot be inserted** —
/// B3's rule "Registered is not callable" is enforced at the point of *recording* as
/// well as of dispatch, which means an invocation that bypassed the binding check would
/// be impossible to log and would fail loudly.
///
/// Also there: `CK_OrchestrationTraceSteps_kind`, `_status`, and
/// `_argumentsMasked_isJson`.
model OrchestrationTraceStep {
  id               String   @id @db.Char(26)
  traceId          String   @db.Char(26)
  ordinal          Int      @db.SmallInt
  /// `GuardrailPre` | `Route` | `AgentInvoke` | `ToolCall` | `Retrieval` | `Merge` |
  /// `GuardrailPost` | `Handover` | `FlowEscape` | `FanOut` | `LoopBack` (the last two
  /// added by the Pipeline Designer — one `FanOut` step per parallel fan-out point, one
  /// `LoopBack` step per loop decision, taken or not).
  kind             String   @db.VarChar(24)
  agentId          String?  @db.Char(26)
  toolBindingId    String?  @db.Char(26)
  label            String   @db.NVarChar(300)
  argumentsMasked  String?  @db.NVarChar(Max)
  resultSummary    String?  @db.NVarChar(1000)
  confidence       Decimal? @db.Decimal(5, 4)
  /// `Ok` | `Failed` | `Timeout` | `Blocked` | `Skipped`.
  status           String   @db.VarChar(16)
  errorCode        String?  @db.VarChar(64)
  isSecondaryAgent Boolean
  durationMs       Int
  startedAt        DateTime @db.DateTime2
  createdAt        DateTime @db.DateTime2
  updatedAt        DateTime @updatedAt @db.DateTime2
  /// Real `PipelineNodes`/`PipelineEdges` references, null for every legacy (non-graph)
  /// trace. `pipelineNodeKey`/`fromNodeKey` are FROZEN copies of the real node keys at
  /// the moment this step ran — a later Draft can delete the node; the step must still
  /// name it. `branchId` (`"0"`, `"0.1"`, `"0.1.0"`) is what makes the whole executed
  /// graph reconstructible from `OrchestrationTraceSteps` alone, with no read of
  /// `PipelineNodes`/`PipelineEdges` needed (required because a trace must render after
  /// its pipeline version is archived and hard-deleted).
  pipelineNodeId   String?  @db.Char(26)
  pipelineNodeKey  String?  @db.VarChar(64)
  pipelineEdgeId   String?  @db.Char(26)
  fromNodeKey      String?  @db.VarChar(64)
  /// `Sequential` | `Parallel` | `LoopBack`, frozen from the edge this step arrived via.
  edgeKind         String?  @db.VarChar(16)
  branchId         String?  @db.VarChar(32)
  /// 1-based pass number when this step ran inside a loop region; `NULL` otherwise.
  loopIteration    Int?     @db.TinyInt
  /// Forward-topological depth (`apps/ai`'s `domain/pipeline.py::topological_depth`) —
  /// lets the trace UI lay out columns without re-deriving the graph.
  depth            Int?     @db.TinyInt

  trace        OrchestrationTrace @relation(fields: [traceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent        Agent?             @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toolBinding  ToolBinding?       @relation(fields: [toolBindingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipelineNode PipelineNode?      @relation(fields: [pipelineNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipelineEdge PipelineEdge?      @relation(fields: [pipelineEdgeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([traceId, ordinal], map: "UQ_OrchestrationTraceSteps_traceId_ordinal")
  @@index([toolBindingId, status], map: "IX_OrchestrationTraceSteps_toolBindingId_status")
  @@map("OrchestrationTraceSteps")
}

// -------------------------------------------------------------------------------------
// tenant · 4.5b orchestration — pipeline designer
//
// A real, versioned, drag-and-drop multi-agent GRAPH — sequential handoff, parallel
// fan-out, and bounded+conditional loop-back — replacing `RouterConfigs.executionMode`'s
// single tenant-wide enum for any tenant that activates one (`RouterConfigs.
// activePipelineVersionId`). Mirrors `Agent`/`AgentVersion` and `Flow`/`FlowVersion`'s
// established `Draft -> Published` registry shape exactly: `PipelineDesign` is the named
// parent, `PipelineVersion` the real, immutable-once-published lineage underneath it.
//
// This is a genuinely new execution model, not a widened `RouterConfig`: today's
// `process_turn.py` dispatch is a flat `if/elif/else` over one enum, invoking at most 3
// agents once each, with no loop ever actually executing (`Budget.max_loop_iterations`/
// `loop_detected()` exist but nothing re-invokes an agent within a turn). `apps/ai`'s new
// `domain/pipeline.py` (a real graph-walking interpreter) and `domain/condition_expr.py`
// (the loop-condition grammar) are this model's runtime; see those modules' own doc
// comments for the full design. `RouterConfigs`' OTHER fields — the tenant-wide ceilings,
// merge/conflict defaults, fallback agent, min routing confidence — survive, now scoped
// per `PipelineVersion` (enforced as `min(RouterConfigs.*, PipelineVersion.*)` for the
// two cost ceilings) rather than duplicated or discarded; `executionMode`,
// `agentSelectionScope` and `agentScopeListJson` are superseded outright once a pipeline
// is active — the graph itself IS the selection.
// -------------------------------------------------------------------------------------

/// Named, versioned multi-agent routing design — the registry parent, mirroring `Agent`/
/// `Flow` exactly.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_PipelineDesigns_slug (slug) WHERE deletedAt
/// IS NULL`, `CK_PipelineDesigns_status`, `CK_PipelineDesigns_publishedHasVersion`.
model PipelineDesign {
  id                   String    @id @db.Char(26)
  name                 String    @db.NVarChar(200)
  slug                 String    @db.VarChar(120)
  description          String?   @db.NVarChar(1000)
  ownerTenantId        String    @db.Char(26)
  /// `Draft` | `Published` | `Archived`.
  status               String    @db.VarChar(16)
  currentVersionId     String?   @db.Char(26)
  createdByStaffUserId String    @db.Char(26)
  deletedAt            DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  versions       PipelineVersion[]             @relation("PipelineVersionOfDesign")
  currentVersion PipelineVersion?              @relation("PipelineCurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  historyEntries PipelineVersionHistoryEntry[]

  @@map("PipelineDesigns")
}

/// An immutable-once-published pipeline graph. Carries the surviving half of
/// `RouterConfigs`' own ceilings/defaults (§4.5b above), now scoped per version rather
/// than tenant-wide.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_PipelineVersions_designId_major_minor`,
/// `CK_PipelineVersions_status`, `_publishedPaired`, `_publishedHasEntry`,
/// `UQ_PipelineVersions_designId_current (pipelineDesignId) WHERE isCurrent = 1`,
/// `_ceilings`, `_confidence`, `_mergePolicy`, `_conflictResolution`,
/// `_routingStrategy`, `TR_PipelineVersions_publishedImmutable`, and
/// `TR_PipelineVersions_publishGraphValid` — the whole-graph publish gate (entry node is
/// this version's own `Start` node; at least one `Response` node; no orphans; acyclic
/// through forward edges except via `LoopBack`; every `LoopBack` edge targets an ancestor
/// of its source; no reference to a Draft agent/agent-version). That rule set is mirrored,
/// not merely referenced, by `apps/ai`'s `domain/pipeline.py::validate_definition` (the
/// runtime twin) and this session's `modules/orchestration/domain/
/// pipeline-graph.ts::analyzePipelineGraph` (the live client-side twin) — all three are
/// meant to agree on exactly what a legal pipeline is.
model PipelineVersion {
  id                        String    @id @db.Char(26)
  pipelineDesignId          String    @db.Char(26)
  major                     Int       @db.SmallInt
  minor                     Int       @db.SmallInt
  /// `Draft` | `Published` | `Archived`.
  status                    String    @db.VarChar(16)
  isCurrent                 Boolean
  /// The version's single `Start` node — FK-cycle-safe two-step insert, the same shape
  /// `FlowVersion.entryNodeId` already establishes.
  entryNodeId               String?   @db.Char(26)
  /// `RouterConfigs.maxHops`'s replacement, pipeline-wide (not per-branch): total node
  /// invocations across every branch this turn. Range widens 1-10 -> 1-50, since a real
  /// multi-branch graph legitimately needs more headroom than the old 3-agent ceiling.
  maxTotalHops              Int       @db.TinyInt
  costCeilingTokens         Int
  /// Money as an exact integer, never a float — same convention as `RouterConfigs.
  /// costCeilingMicroAed`. Enforced at runtime as `min(RouterConfigs.costCeilingMicroAed,
  /// this)` — a tenant-wide cap an Agent Designer's own published pipeline can tighten,
  /// never exceed.
  costCeilingMicroAed       BigInt
  /// `ConcatenateInOrder` | `DeduplicateOverlap` | `SupervisorRewrite` — the default a
  /// join node (>= 2 inbound edges) uses unless its own `PipelineNode.
  /// mergePolicyOverride` is set.
  defaultMergePolicy        String    @db.VarChar(32)
  /// `HighestConfidence` | `PreferOwningEntity` | `SupervisorArbitrates`.
  defaultConflictResolution String    @db.VarChar(32)
  /// `IntentClassifier` | `LlmRouter` | `RuleFirst` — only `IntentClassifier` is
  /// implemented (`score_agent_confidence`), the same honest state `RouterConfigs.
  /// routingStrategy` was already in.
  routingStrategy           String    @db.VarChar(24)
  minRoutingConfidence      Decimal   @db.Decimal(5, 4)
  fallbackAgentId           String?   @db.Char(26)
  changeSummary             String?   @db.NVarChar(1000)
  createdByStaffUserId      String    @db.Char(26)
  publishedAt               DateTime? @db.DateTime2
  /// Unconstrained `StaffUser` reference — cross-schema FK is impossible (ADR-0011),
  /// identical to `FlowVersion.publishedByStaffUserId`.
  publishedByStaffUserId    String?   @db.Char(26)
  clonedFromVersionId       String?   @db.Char(26)
  deletedAt                 DateTime? @db.DateTime2
  createdAt                 DateTime  @db.DateTime2
  updatedAt                 DateTime  @updatedAt @db.DateTime2

  design           PipelineDesign                @relation("PipelineVersionOfDesign", fields: [pipelineDesignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentForDesign PipelineDesign[]              @relation("PipelineCurrentVersion")
  entryNode        PipelineNode?                 @relation("PipelineVersionEntryNode", fields: [entryNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clonedFrom       PipelineVersion?              @relation("PipelineVersionClone", fields: [clonedFromVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clones           PipelineVersion[]             @relation("PipelineVersionClone")
  fallbackAgent    Agent?                        @relation("PipelineVersionFallbackAgent", fields: [fallbackAgentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodes            PipelineNode[]                @relation("PipelineNodeOfVersion")
  edges            PipelineEdge[]
  historyEntries   PipelineVersionHistoryEntry[] @relation("PipelineHistoryVersion")
  rolledBackFrom   PipelineVersionHistoryEntry[] @relation("PipelineHistoryFromVersion")
  activeForRouter  RouterConfig[]
  traces           OrchestrationTrace[]

  @@unique([pipelineDesignId, major, minor], map: "UQ_PipelineVersions_designId_major_minor")
  @@index([pipelineDesignId, status], map: "IX_PipelineVersions_designId_status")
  @@map("PipelineVersions")
}

/// One node in a pipeline graph — `Start` | `Agent` | `Supervisor` | `Response`. `Start`
/// exists because a parallel fan-out needs a source that is not itself an agent
/// invocation, and gives `PipelineVersion.entryNodeId` an unambiguous, model-call-free
/// home; `Response` is the terminal/output node every published version needs at least
/// one of. Hard-deleted (§1.4), same as `FlowNode`.
///
/// Deliberately excludes per-node model/temperature overrides: that configuration
/// already lives on the immutable, audited `AgentVersion` snapshot — the sanctioned way
/// to get different behaviour for the same agent in different pipelines is
/// `agentVersionPinId` naming a different version, not a second, unaudited override here.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_PipelineNodes_pipelineVersionId_key`,
/// `CK_PipelineNodes_kind`, `_agentPaired`, `_pinNeedsAgent`, `_inputContextMode`,
/// `_supervisorContext`, `_onErrorPolicy`, `_mergePolicyOverride`,
/// `_conflictResolutionOverride`, `_costOverrides`, plus the filtered unique indexes
/// `UQ_PipelineNodes_start (pipelineVersionId) WHERE kind = 'Start'` and
/// `UQ_PipelineNodes_turnBoundAgent (pipelineVersionId) WHERE usesTurnBoundAgent = 1`.
model PipelineNode {
  id                          String   @id @db.Char(26)
  pipelineVersionId           String   @db.Char(26)
  key                         String   @db.VarChar(64)
  /// `Start` | `Agent` | `Supervisor` | `Response`.
  kind                        String   @db.VarChar(16)
  title                       String   @db.NVarChar(200)
  canvasX                     Int
  canvasY                     Int
  agentId                     String?  @db.Char(26)
  /// Resolves the TURN's own bound agent instead of a fixed one, when true — legal on at
  /// most one node per version, and never together with `agentId`.
  usesTurnBoundAgent          Boolean  @default(false)
  /// Pins a SPECIFIC `AgentVersion` (including a Draft one) instead of
  /// `Agent.currentVersionId` — mirrors `AgentFlowBinding.flowVersionId`'s own
  /// version-pinning discipline.
  agentVersionPinId           String?  @db.Char(26)
  /// `UserTurnOnly` | `UpstreamRepliesFull` | `UpstreamRepliesSummary` — the last is
  /// today's real supervisor `plan_summary` line (`process_turn.py`) made configurable.
  inputContextMode            String   @db.VarChar(24)
  /// Only meaningful at in-degree >= 2 (a real join point).
  mergePolicyOverride         String?  @db.VarChar(32)
  conflictResolutionOverride  String?  @db.VarChar(32)
  /// Feeds `AgentReply.is_owning_entity` as a configured fact — replaces today's
  /// `not is_secondary` proxy.
  isOwningEntity              Boolean  @default(false)
  costCeilingTokensOverride   Int?
  costCeilingMicroAedOverride BigInt?
  timeoutMsOverride           Int?
  /// `FailTurn` | `SkipNode` | `RouteToFallbackAgent` — the first real enforcement point
  /// `RouterConfigs.fallbackAgentId` has ever had.
  onErrorPolicy               String   @db.VarChar(24)
  createdAt                   DateTime @db.DateTime2
  updatedAt                   DateTime @updatedAt @db.DateTime2

  pipelineVersion  PipelineVersion          @relation("PipelineNodeOfVersion", fields: [pipelineVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  agent            Agent?                   @relation("PipelineNodeAgent", fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentVersionPin  AgentVersion?            @relation("PipelineNodeAgentVersionPin", fields: [agentVersionPinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entryForVersions PipelineVersion[]        @relation("PipelineVersionEntryNode")
  edgesFrom        PipelineEdge[]           @relation("PipelineEdgeFrom")
  edgesTo          PipelineEdge[]           @relation("PipelineEdgeTo")
  traceSteps       OrchestrationTraceStep[]

  @@unique([pipelineVersionId, key], map: "UQ_PipelineNodes_pipelineVersionId_key")
  @@map("PipelineNodes")
}

/// A connection between two pipeline nodes. `Parallel` is structural, never a
/// single-edge flag: two or more `Parallel` edges sharing one `fromNodeId`, executed
/// concurrently — `TR_PipelineEdges_homogeneousFanOut` makes a mixed or lone `Parallel`
/// edge unrepresentable. `LoopBack` is the ONE edge kind allowed to form a cycle and the
/// only one allowed to be a self-edge (`CK_PipelineEdges_selfLoopOnlyLoopBack` —
/// deliberately diverges from `CK_FlowEdges_noSelfLoop`).
///
/// In `prisma/sql/001_constraints.sql`: `UQ_PipelineEdges_from_ordinal`,
/// `UQ_PipelineEdges_pair`, `CK_PipelineEdges_kind`, `_selfLoopOnlyLoopBack`,
/// `_loopFields CHECK ((kind = 'LoopBack') = (maxIterations IS NOT NULL))` (the hard
/// backstop made unrepresentable to omit), `_maxIterationsBounded (1-20)`,
/// `_conditionOnlyOnLoop`, `_conditionCharset` (a floor under `apps/ai`'s
/// `domain/condition_expr.py` grammar), `TR_PipelineEdges_sameVersion`,
/// `TR_PipelineEdges_homogeneousFanOut`.
model PipelineEdge {
  id                  String   @id @db.Char(26)
  pipelineVersionId   String   @db.Char(26)
  fromNodeId          String   @db.Char(26)
  toNodeId            String   @db.Char(26)
  /// `Sequential` | `Parallel` | `LoopBack`.
  kind                String   @db.VarChar(16)
  ordinal             Int      @db.SmallInt
  label               String?  @db.NVarChar(120)
  /// MANDATORY on `LoopBack`, forbidden otherwise — the loop's hard iteration backstop,
  /// always enforced regardless of `conditionExpression`.
  maxIterations       Int?     @db.TinyInt
  /// Optional, `LoopBack` only. A whitelisted comparison expression validated by
  /// `apps/ai`'s `domain/condition_expr.py` (`POST /v1/orchestration/pipelines/
  /// validate-condition`) — never evaluated by SQL Server, only shape-floored by
  /// `CK_PipelineEdges_conditionCharset`.
  conditionExpression String?  @db.NVarChar(500)
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  pipelineVersion PipelineVersion          @relation(fields: [pipelineVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromNode        PipelineNode             @relation("PipelineEdgeFrom", fields: [fromNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toNode          PipelineNode             @relation("PipelineEdgeTo", fields: [toNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  traceSteps      OrchestrationTraceStep[]

  @@unique([pipelineVersionId, fromNodeId, ordinal], map: "UQ_PipelineEdges_from_ordinal")
  @@unique([pipelineVersionId, fromNodeId, toNodeId], map: "UQ_PipelineEdges_pair")
  @@map("PipelineEdges")
}

/// The inline history list for a pipeline design, newest first — mirrors
/// `AgentVersionHistoryEntry` exactly, including its append-only grant
/// (`DENY UPDATE, DELETE` in `prisma/sql/002_tenant_grants.sql`). `Activated` is the one
/// value with no `AgentVersionHistoryEntry` analogue: flipping
/// `RouterConfigs.activePipelineVersionId` is a tenant-visible act that must be
/// attributable, and this is the only place it is recorded.
model PipelineVersionHistoryEntry {
  id                String   @id @db.Char(26)
  pipelineDesignId  String   @db.Char(26)
  pipelineVersionId String?  @db.Char(26)
  /// `Created` | `Cloned` | `Published` | `Unpublished` | `RolledBack` | `Activated` | `Archived`.
  kind              String   @db.VarChar(24)
  note              String   @db.NVarChar(500)
  fromVersionId     String?  @db.Char(26)
  actorStaffUserId  String   @db.Char(26)
  occurredAt        DateTime @db.DateTime2
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  design          PipelineDesign   @relation(fields: [pipelineDesignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pipelineVersion PipelineVersion? @relation("PipelineHistoryVersion", fields: [pipelineVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fromVersion     PipelineVersion? @relation("PipelineHistoryFromVersion", fields: [fromVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([pipelineDesignId, occurredAt(sort: Desc)], map: "IX_PipelineVersionHistoryEntries_pipelineDesignId_occurredAt")
  @@map("PipelineVersionHistoryEntries")
}

/// What grounded the answer: chunk, score, rank, graph path (A2 Sources panel).
/// **AI-writable — grant group 2**.
///
/// `FK_GroundingCitations_Chunks` is the §5 contract made retroactive: **the citation is
/// a foreign key into the authoritative text**, so a citation row cannot be written for
/// a `chunk_id` that does not exist and the audit trail of past answers is composed only
/// of resolvable references. A stale Qdrant payload can therefore produce a wrong
/// *ranking* — a quality bug — but never a fabricated citation, which in a government
/// service would be the system asserting a false fact about official policy.
///
/// `graphPath` is deliberately **text, not a relation** (§4.5): it freezes the traversal
/// the citizen was actually shown, so a later graph merge cannot retroactively change
/// what a past answer claimed to have traversed — and materialising the traversal as SQL
/// rows would put graph structure in the system of record, which ADR-0003 forbids.
///
/// `CK_GroundingCitations_rank CHECK (rank BETWEEN 1 AND 50)` and
/// `CK_GroundingCitations_retrievedVia` live in `prisma/sql/001_constraints.sql`.
model GroundingCitation {
  id                String   @id @db.Char(26)
  traceId           String   @db.Char(26)
  turnId            String   @db.Char(26)
  /// The `chunk_id` — a globally unique ULID that joins SQL Server, Neo4j and Qdrant
  /// (§5). Generated once, by the only writer that has a system of record, and never
  /// regenerated by a re-index.
  chunkId           String   @db.Char(26)
  knowledgeSourceId String   @db.Char(26)
  rank              Int      @db.SmallInt
  vectorScore       Decimal? @db.Decimal(6, 5)
  graphScore        Decimal? @db.Decimal(6, 5)
  hybridScore       Decimal  @db.Decimal(6, 5)
  rerankScore       Decimal? @db.Decimal(6, 5)
  /// `Graph` | `Vector` | `Hybrid`.
  retrievedVia      String   @db.VarChar(16)
  graphPath         String?  @db.NVarChar(500)
  wasCited          Boolean
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  trace           OrchestrationTrace @relation(fields: [traceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  turn            ConversationTurn   @relation(fields: [turnId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  chunk           Chunk              @relation(fields: [chunkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  knowledgeSource KnowledgeSource    @relation(fields: [knowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([traceId, rank], map: "UQ_GroundingCitations_traceId_rank")
  @@index([chunkId], map: "IX_GroundingCitations_chunkId")
  @@map("GroundingCitations")
}

// -------------------------------------------------------------------------------------
// tenant · 4.6 tools — skills, MCP, connectors, bindings, breakers
//
// B5's "shared, platform-wide catalogue" means tenant-wide, not global (§14 decision 1,
// closing RISK-023): an MCP server endpoint with mTLS credentials belongs to the entity
// that operates it, and B6 tab 1 establishes that sources are entity-owned. A genuinely
// cross-entity gateway is registered in the `sharjah_platform` tenant like any other
// tenant's tools. No cross-entity share mechanism exists and one is not being added.
// -------------------------------------------------------------------------------------

/// The catalogue of callable capabilities: native, or projected from a connector or an
/// MCP tool. B3 step 4 and B5 tabs 1-3 are **one set of tables with two screens over
/// them**.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_Skills_key ... WHERE deletedAt IS NULL`,
/// `UQ_Skills_apiConnectorId ... WHERE apiConnectorId IS NOT NULL` (one skill per
/// connector, which is what makes `TR_ApiConnectors_projectSkill` idempotent),
/// `UQ_Skills_mcpToolId ... WHERE mcpToolId IS NOT NULL`,
/// `CK_Skills_exactlyOneSource` (a non-native skill has exactly one source, a native one
/// has none), and
/// `CK_Skills_connectorHasRateLimit CHECK (invocationKind <> 'ApiConnector' OR
/// rateLimitPolicyId IS NOT NULL)` — a hard constraint only because the projection
/// trigger copies the connector's policy across.
model Skill {
  id                  String    @id @db.Char(26)
  key                 String    @db.VarChar(96)
  name                String    @db.NVarChar(200)
  description         String?   @db.NVarChar(1000)
  category            String?   @db.VarChar(48)
  /// `Native` | `ApiConnector` | `McpTool`.
  invocationKind      String    @db.VarChar(24)
  apiConnectorId      String?   @db.Char(26)
  mcpToolId           String?   @db.Char(26)
  inputSchemaJson     String    @db.NVarChar(Max)
  outputSchemaJson    String?   @db.NVarChar(Max)
  rateLimitPolicyId   String?   @db.Char(26)
  isSystem            Boolean
  isAttachedByDefault Boolean
  deletedAt           DateTime? @db.DateTime2
  createdAt           DateTime  @db.DateTime2
  updatedAt           DateTime  @updatedAt @db.DateTime2

  apiConnector    ApiConnector?    @relation(fields: [apiConnectorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mcpTool         McpTool?         @relation(fields: [mcpToolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateLimitPolicy RateLimitPolicy? @relation(fields: [rateLimitPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toolBindings    ToolBinding[]

  @@map("Skills")
}

/// A registered MCP endpoint and its connection state.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_McpServers_endpoint ... WHERE deletedAt IS
/// NULL`, `CK_McpServers_authNeedsSecret CHECK (authMode = 'None' OR credentialSecretRef
/// IS NOT NULL)`, and **`CK_McpServers_secretIsReference`** — the column holds a
/// *reference* (`env:` / `k8s:`), never a secret, because architecture §10 keeps secrets
/// in config/env only.
model McpServer {
  id                  String    @id @db.Char(26)
  name                String    @db.NVarChar(200)
  endpoint            String    @db.NVarChar(500)
  /// `Stdio` | `Sse` | `StreamableHttp`.
  transport           String    @db.VarChar(16)
  /// `OAuth2ClientCredentials` | `MutualTls` | `ApiKey` | `None`.
  authMode            String    @db.VarChar(32)
