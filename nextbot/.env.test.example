# Copy to `.env.test` for local integration/isolation test runs against
# `compose.test.yml`. These are throwaway credentials for an ephemeral, tmpfs-backed
# test container — not production secrets.
NEXTBOT_DB_ENV=test
NEXTBOT_DB_OWNER_TEST_URL=postgres://nextbot_test:nextbot_test_password@localhost:55432/nextbot_test
NEXTBOT_DB_APP_TEST_URL=postgres://nextbot_app_test:app_test_pw_change_me@localhost:55432/nextbot_test
NEXTBOT_DB_PLATFORM_TEST_URL=postgres://nextbot_platform_test:platform_test_pw_change_me@localhost:55432/nextbot_test
NEXTBOT_DB_GATEWAY_TEST_URL=postgres://nextbot_gateway_test:gateway_test_pw_change_me@localhost:55432/nextbot_test
NEXTBOT_SESSION_SECRET=test-session-secret-please-change-me-32chars-min
NEXTBOT_WIDGET_SESSION_SECRET=test-widget-session-secret-please-change-32ch
NEXTBOT_KMS_MASTER_KEY=1111111111111111111111111111111111111111111111111111111111111111
# BE2 (QA fix pass): apps/gateway's widget rate limiter — points at
# compose.test.yml's ephemeral redis-test service.
NEXTBOT_REDIS_TEST_URL=redis://localhost:56379
# Phase 13 (BL-06) — ClickHouse read/write path (agent_run_span, ADR-0008), points at compose.test.yml's ephemeral clickhouse-test service.
CLICKHOUSE_TEST_URL=http://nextbot_test:nextbot_test_password@localhost:58123/nextbot_test
# Target Architecture Blueprint Phase 7a (ADR-0018) — the graph store's tenant-
# isolation primitive. Points at compose.test.yml's ephemeral neo4j-test service.
# GRAPH_STORE_ADMIN_* is the real Neo4j superuser NEO4J_AUTH creates at container
# start (DBMS-admin privileges — provisioning only, never used to read/write tenant
# data). GRAPH_STORE_SERVICE_USER_TEST/CREDENTIAL_REF_TEST is the service user
# `withTenantGraph()` authenticates as; it is created idempotently by
# `ensureTenantGraphDatabase()`'s own bootstrap on first use, NOT by this compose
# service directly — so its password here is this suite's own choice, not
# Neo4j's default.
NEXTBOT_DB_ENV=test
GRAPH_STORE_PROVIDER=neo4j
GRAPH_STORE_TEST_URL=bolt://localhost:57687
GRAPH_STORE_ADMIN_USER_TEST=neo4j
GRAPH_STORE_ADMIN_CREDENTIAL_REF_TEST=nextbot_test_neo4j_password
GRAPH_STORE_SERVICE_USER_TEST=svc_graph_test
GRAPH_STORE_CREDENTIAL_REF_TEST=svc_graph_test_password_1
GRAPH_STORE_DATABASE_PREFIX=t
