  ordinal              Int       @db.SmallInt
  isEnabled            Boolean
  createdByStaffUserId String    @db.Char(26)
  deletedAt            DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  team Team? @relation(fields: [teamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("CannedReplies")
}

/// Singleton. Queue defaults and the escalation SLA (B8, B10 tab 1).
///
/// `offerEscalationOutsideHours` is deliberately a **different column on a different
/// entity** from `WorkingHoursProfiles.assistantAvailable247`: B10 tab 1's rule
