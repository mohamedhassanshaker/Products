# import-linter cache — machine-local, regenerated on every run.
.import_linter_cache/

# Generated Prisma clients (ADR-0011) — two schema files, two `prisma generate` outputs.
# Native query-engine binaries and generated JS/WASM; regenerated by `pnpm db:generate`,
# never committed, unlike the small checked-in generated TS/Python source elsewhere.
prisma/generated/

# Tenant-uploaded brand assets (logos, favicons — design-system.md §9.1, the theming
# module's LocalBrandAssetStorage adapter). Real per-environment runtime data written
# by a live Settings -> Appearance upload, never a build artifact or source file.
apps/web/public/uploads/

# Per-session scratch state for the Claude Code hooks in .claude/settings.json
# (scripts/claude-hooks/) — which files a session touched, not a build artifact.
.claude/hooks-state/
