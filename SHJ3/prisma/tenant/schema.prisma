  supervisorAlertTeam Team?               @relation("HandoverSupervisorAlert", fields: [supervisorAlertTeamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workingHoursProfile WorkingHoursProfile @relation(fields: [workingHoursProfileId], references: [id], onDelete: NoAction, onUpdate: NoAction)

