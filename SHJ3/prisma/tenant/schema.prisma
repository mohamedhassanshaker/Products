  targetKey                 String?  @db.VarChar(64)
  failureThreshold          Int      @db.SmallInt
  windowSeconds             Int
  cooldownSeconds           Int
  halfOpenProbes            Int      @db.TinyInt
  /// `ApologiseOfferLiveAgent` | `ServeCachedAnswer` | `QueueAndRetry` | `FailClosed`.
  fallbackStrategy          String   @db.VarChar(32)
  cachedAnswerMaxAgeSeconds Int?
  serveCachedWhenDown       Boolean
  degradedModeMessage       String   @db.NVarChar(500)
  isEnabled                 Boolean
  createdAt                 DateTime @db.DateTime2
  updatedAt                 DateTime @updatedAt @db.DateTime2

