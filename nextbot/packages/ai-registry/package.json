{
  "name": "@nextbot/ai-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Provider-agnostic model registry (LLD §7.1). ONLY package that may import @google/adk or a provider SDK — enforced by dependency-cruiser.",
  "exports": {
    ".": "./src/index.ts"
