{
  "name": "@nextbot/workflows",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Target Architecture Blueprint Phases 15-16 (BL-47a/BL-47b, FR-WF-01..07, LLD §14.6) — Workflow Designer: the authoring half (graph schema, V1-V12 validation, promotion ladder, CRUD/validate/diff/transition API) AND the durable-execution half (workflow_run/lease/step schema, the store-and-lease executor hosted by apps/worker per ADR-0013 §7, run-level budgets, compensation, suspension/expiry, and the FR-WF-07 graph trace API).",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit --dir .",
    "test:integration": "vitest run --project integration --dir ."
  },
