{
  "name": "nextbot",
  "private": true,
  "version": "0.0.0",
  "description": "NextBot — AI customer support platform monorepo (Nexus pipeline).",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "neverBuiltDependencies": ["sqlite3"]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:boundaries": "eslint . --max-warnings=0 && dependency-cruiser --config .dependency-cruiser.cjs --output-type err apps packages",
    "test": "turbo run test",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:isolation": "vitest run --project isolation",
    "test:coverage": "vitest run --coverage",
    "db:generate": "pnpm --filter @nextbot/db run generate",
    "db:migrate": "pnpm --filter @nextbot/db run migrate",
    "db:seed": "tsx scripts/seed.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.2",
    "dependency-cruiser": "^16.4.2",
    "dotenv": "^16.4.5",
    "eslint": "^9.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^4.2.2",
    "globals": "^17.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.2"
  },
  "dependencies": {
    "@nextbot/agent-platform": "workspace:*",
    "@nextbot/connectors": "workspace:*",
    "@nextbot/contracts": "workspace:*",
    "@nextbot/db": "workspace:*",
    "@nextbot/iam": "workspace:*",
    "@nextbot/tenancy": "workspace:*",
    "@nextbot/tool-registry": "workspace:*",
    "drizzle-orm": "^0.36.1"
  }
}
