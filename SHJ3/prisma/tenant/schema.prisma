  @@map("Channels")
}

/// Named staffed-hours pattern, with holiday sync and the 24/7 assistant override.
///
/// `CK_WorkingHoursProfiles_timezoneIana` lives in `prisma/sql/001_constraints.sql`.
model WorkingHoursProfile {
  id                      String   @id @db.Char(26)
  name                    String   @unique(map: "UQ_WorkingHoursProfiles_name") @db.NVarChar(120)
  /// IANA zone. Wall-clock business data is **not** a timestamp (§1.3): converting
  /// working hours to UTC at rest would silently break across a DST boundary and would
  /// make the admin screen display something other than what was typed.
  timezone                String   @default("Asia/Dubai") @db.VarChar(64)
  publicHolidayAutoSync   Boolean
  assistantAvailable247   Boolean
  noAgentAvailableMessage String   @db.NVarChar(500)
  createdAt               DateTime @db.DateTime2
  updatedAt               DateTime @updatedAt @db.DateTime2

  slots           WorkingHoursSlot[]
  channels        Channel[]
  handoverConfigs HandoverConfig[]

  @@map("WorkingHoursProfiles")
}

/// One open window on one weekday. An overnight window is **two rows**, which keeps the
/// comparison trivial. Hard-deleted (§1.4).
///
/// `CK_WorkingHoursSlots_dayOfWeek CHECK (dayOfWeek BETWEEN 0 AND 6)` and
/// `CK_WorkingHoursSlots_ordered CHECK (closesAt > opensAt)` live in
/// `prisma/sql/001_constraints.sql`.
model WorkingHoursSlot {
  id                    String   @id @db.Char(26)
  workingHoursProfileId String   @db.Char(26)
  /// 0 = Sunday.
  dayOfWeek             Int      @db.TinyInt
  opensAt               DateTime @db.Time
  closesAt              DateTime @db.Time
  createdAt             DateTime @db.DateTime2
  updatedAt             DateTime @updatedAt @db.DateTime2

  workingHoursProfile WorkingHoursProfile @relation(fields: [workingHoursProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workingHoursProfileId, dayOfWeek, opensAt], map: "UQ_WorkingHoursSlots_profile_day_opensAt")
  @@map("WorkingHoursSlots")
}

/// UAE holidays, auto-synced or manual (§4.10 ASSUMPTION 4 — B10 tab 1 names no sync
/// source, so this is a cached table with an `origin` discriminator).
///
/// `CK_PublicHolidays_origin` lives in `prisma/sql/001_constraints.sql`.
model PublicHoliday {
  id          String    @id @db.Char(26)
  holidayDate DateTime  @unique(map: "UQ_PublicHolidays_holidayDate") @db.Date
  name        String    @db.NVarChar(200)
  /// `AutoSync` | `Manual`.
  origin      String    @db.VarChar(12)
  isObserved  Boolean
  syncedAt    DateTime? @db.DateTime2
  createdAt   DateTime  @db.DateTime2
  updatedAt   DateTime  @updatedAt @db.DateTime2

  @@map("PublicHolidays")
}

/// B10 tab 2 in full. 1:1 with the web-widget channel.
///
/// **`CK_WidgetConfigs_accentIsToken CHECK (accentTokenKey NOT LIKE '#%' AND
/// accentTokenKey NOT LIKE 'rgb%')`** keeps the widget inside the design system. B10
/// tab 2 offers 5 accent swatches and it is tempting to store the hex — but a hex literal
/// in a config table is a hardcoded colour that has merely moved from the code to the
/// database, where the linter cannot see it (ADR-0007). Storing a **token key**
/// (`--brand-accent-1` … `--brand-accent-5`) resolved through the tenant's active
/// `TokenSet` at render time means re-skinning a tenant repaints the embedded widget too,
/// with no widget-config edit and no re-issued embed snippet.
///
/// The check lives in `prisma/sql/001_constraints.sql`.
model WidgetConfig {
  id                    String   @id @db.Char(26)
  channelId             String   @unique(map: "UQ_WidgetConfigs_channelId") @db.Char(26)
  /// A design-system token key, never a colour literal.
  accentTokenKey        String   @db.VarChar(64)
  /// `BottomRight` | `BottomLeft`.
  launcherPosition      String   @db.VarChar(16)
  /// `Docked` | `Expanded`.
  defaultState          String   @db.VarChar(12)
  disclaimerText        String   @db.NVarChar(500)
  greetingText          String   @db.NVarChar(1000)
  composerPlaceholder   String   @db.NVarChar(160)
  showDisclaimerDismiss Boolean
  embedSnippetVersion   Int      @db.SmallInt
  createdAt             DateTime @db.DateTime2
  updatedAt             DateTime @updatedAt @db.DateTime2

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("WidgetConfigs")
}

/// The embed allowlist. Security-relevant, so attributable. Hard-deleted (§1.4).
///
/// `CK_WidgetAllowedDomains_noScheme CHECK (domain NOT LIKE '%://%' AND domain NOT LIKE
/// '%/%')` and `CK_WidgetAllowedDomains_noWildcardTld` live in
/// `prisma/sql/001_constraints.sql`.
model WidgetAllowedDomain {
  id                 String   @id @db.Char(26)
  channelId          String   @db.Char(26)
  domain             String   @db.NVarChar(253)
  addedByStaffUserId String   @db.Char(26)
  addedAt            DateTime @db.DateTime2
  createdAt          DateTime @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([channelId, domain], map: "UQ_WidgetAllowedDomains_channelId_domain")
  @@map("WidgetAllowedDomains")
}

/// BSP and session-window settings. 1:1 with the WhatsApp channel.
///
/// `CK_WhatsAppConfigs_sessionWindow CHECK (sessionWindowHours = 24)` — the 24-hour
/// window is a Meta platform rule, not a preference, so it is **pinned rather than made
/// editable** — lives in `prisma/sql/001_constraints.sql` with
/// `CK_WhatsAppConfigs_bspProvider`.
model WhatsAppConfig {
  id                     String   @id @db.Char(26)
  channelId              String   @unique(map: "UQ_WhatsAppConfigs_channelId") @db.Char(26)
  phoneNumber            String   @db.VarChar(24)
  phoneNumberId          String   @unique(map: "UQ_WhatsAppConfigs_phoneNumberId") @db.VarChar(64)
  wabaId                 String   @db.VarChar(64)
  /// `MetaCloudApi`.
  bspProvider            String   @db.VarChar(32)
  optInRequired          Boolean
  sessionWindowHours     Int      @default(24) @db.TinyInt
  /// A reference, never a secret (architecture §10).
  credentialSecretRef    String   @db.NVarChar(200)
  webhookVerifySecretRef String   @db.NVarChar(200)
  createdAt              DateTime @db.DateTime2
  updatedAt              DateTime @updatedAt @db.DateTime2

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("WhatsAppConfigs")
}

/// Outbound templates and their BSP approval status (B10 tab 3).
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_MessageTemplates_name_localeCode ... WHERE deletedAt IS NULL`;
/// `CK_MessageTemplates_rejectedHasReason`;
/// `CK_MessageTemplates_approvedHasBspId CHECK (approvalStatus <> 'Approved' OR
/// bspTemplateId IS NOT NULL)`; and the sibling of
/// `TR_Campaigns_templateMustBeApproved` that forces `isEnabled = 0` on dependent
/// campaigns when a template moves *out* of `Approved`.
model MessageTemplate {
  id                     String    @id @db.Char(26)
  name                   String    @db.VarChar(120)
  channelKey             String    @db.VarChar(24)
  category               String    @db.VarChar(32)
  bodySample             String    @db.NVarChar(2000)
  variablesJson          String?   @db.NVarChar(Max)
  localeCode             String    @db.VarChar(16)
  /// `Draft` | `Pending` | `Approved` | `Rejected`.
  approvalStatus         String    @db.VarChar(12)
  bspTemplateId          String?   @db.VarChar(64)
  submittedByStaffUserId String?   @db.Char(26)
  submittedAt            DateTime? @db.DateTime2
  reviewedAt             DateTime? @db.DateTime2
  rejectionReason        String?   @db.NVarChar(500)
  deletedAt              DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  campaigns     Campaign[]
  campaignSends CampaignSend[]

  @@index([approvalStatus], map: "IX_MessageTemplates_approvalStatus")
  @@map("MessageTemplates")
}

/// Proactive messaging (B10 tab 4). **`Blocked` is derived, not stored.** B10 is
/// unusually explicit — "a campaign whose template is not Approved shows Blocked and its
/// toggle will not turn on … the dependency is enforced, not just described" — so storing
/// a block flag would create two facts (the template's status and the campaign's block)
/// that can disagree. The campaign stores only `isEnabled`;
/// **`TR_Campaigns_templateMustBeApproved`** rejects any insert or update setting
/// `isEnabled = 1` while the referenced template is not `Approved`, and the UI's
/// three-state badge is rendered from the `CampaignStates` view.
///
/// The trigger, the view and
/// `CK_Campaigns_offsetPaired CHECK ((trigger = 'RelativeToDueDate') =
/// (triggerOffsetHours IS NOT NULL))` all live in `prisma/sql/001_constraints.sql`.
model Campaign {
  id                     String    @id @db.Char(26)
  name                   String    @unique(map: "UQ_Campaigns_name") @db.NVarChar(200)
  messageTemplateId      String    @db.Char(26)
  /// `RelativeToDueDate` | `OnBookingCreated` | `OnPaymentSettled` | `Manual`.
  trigger                String    @db.VarChar(32)
  triggerOffsetHours     Int?
  audienceDefinitionJson String    @db.NVarChar(Max)
  audienceLabel          String    @db.NVarChar(200)
  isEnabled              Boolean
  respectQuietHours      Boolean
  sentThisMonth          Int
  lastSentAt             DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  messageTemplate MessageTemplate @relation(fields: [messageTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sends           CampaignSend[]

  @@index([messageTemplateId], map: "IX_Campaigns_messageTemplateId")
  @@map("Campaigns")
}

/// One outbound attempt, with its **send-time** gate result — B10 tab 4's second rule:
/// both gates are re-checked at send time, not only at configuration time.
/// `suppressionReason` is the record of that re-check, so a send whose template lost
/// approval, whose recipient revoked consent, or which landed in quiet hours is written
/// as `Suppressed` with a reason rather than silently dropped.
///
/// **`UQ_CampaignSends_idempotencyKey`** (derived from
/// `campaignId + recipientHash + triggerOccurrenceKey`) is what makes a Redis queue
/// redelivery safe: the second attempt violates the index and is discarded rather than
/// double-messaging a citizen.
///
/// The filtered `IX_CampaignSends_state ... WHERE state = 'Queued'` and
/// `CK_CampaignSends_suppressedPaired` live in `prisma/sql/001_constraints.sql`.
model CampaignSend {
  id                String    @id @db.Char(26)
  campaignId        String    @db.Char(26)
  messageTemplateId String    @db.Char(26)
  recipientHash     String    @db.Char(64)
  citizenIdentityId String?   @db.Char(26)
  /// `Queued` | `Sent` | `Delivered` | `Failed` | `Suppressed`.
  state             String    @db.VarChar(12)
  /// `QuietHours` | `NoOptIn` | `TemplateNotApproved` | `Duplicate` | `ChannelDisabled`.
  suppressionReason String?   @db.VarChar(32)
  idempotencyKey    String    @unique(map: "UQ_CampaignSends_idempotencyKey") @db.VarChar(120)
  bspMessageId      String?   @db.VarChar(120)
  queuedAt          DateTime  @db.DateTime2
  sentAt            DateTime? @db.DateTime2
  deliveredAt       DateTime? @db.DateTime2
  failureCode       String?   @db.VarChar(64)
  createdAt         DateTime  @db.DateTime2
  updatedAt         DateTime  @updatedAt @db.DateTime2

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messageTemplate MessageTemplate  @relation(fields: [messageTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  citizenIdentity CitizenIdentity? @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([campaignId, queuedAt], map: "IX_CampaignSends_campaignId_queuedAt")
  @@map("CampaignSends")
}

/// Singleton. No sends 21:00-07:00 (B10 tab 4). `TIME(0)` plus an IANA zone, never UTC
/// (§1.3).
///
/// `CK_QuietHoursConfigs_singleton` lives in `prisma/sql/001_constraints.sql`.
model QuietHoursConfig {
  id           String   @id @db.Char(26)
  singletonKey Int      @unique(map: "UQ_QuietHoursConfigs_singleton") @default(1) @db.TinyInt
  isEnabled    Boolean
  startsAt     DateTime @db.Time
  endsAt       DateTime @db.Time
  timezone     String   @default("Asia/Dubai") @db.VarChar(64)
  createdAt    DateTime @db.DateTime2
  updatedAt    DateTime @updatedAt @db.DateTime2

  @@map("QuietHoursConfigs")
}

/// The per-tenant half of B10 tab 5: enabled, voice, parity, fallback. The catalogue half
/// is `platform.Locales`, and `FK_LocaleSettings_Locales` is one of the four deliberate
/// cross-schema foreign keys (see the header block).
///
/// **`translatedPercent` is a computed persisted column** over `translatedStringCount` /
/// `totalStringCount` — this is what makes B10 tab 5's 82% Arabic figure a real number
/// rather than a typed one, and it is what B13's locale gate joins against. It is in
/// `prisma/sql/001_constraints.sql` and absent from this model so nothing can write it.
///
/// Also there: **`UQ_LocaleSettings_fallback (isFallback) WHERE isFallback = 1`** —
/// exactly one fallback locale, because "fall back to whichever" is not a behaviour;
/// `CK_LocaleSettings_fallbackMustBeEnabled CHECK (isFallback = 0 OR isEnabled = 1)`;
/// `CK_LocaleSettings_countsCoherent CHECK (translatedStringCount <= totalStringCount)`.
model LocaleSetting {
  id                    String   @id @db.Char(26)
  /// References `platform.Locale.code` — NOT a Prisma `@relation`. `Locale` lives in
  /// prisma/platform/schema.prisma, a separate generated client; Prisma cannot express a
  /// relation across two clients (ADR-0011). The SQL Server FOREIGN KEY constraint
  /// (`LocaleSettings_localeCode_fkey`) is unaffected — hand-written, idempotent DDL in
  /// prisma/sql/001_constraints.sql, not Prisma-managed. A caller needing the `Locale`
  /// row reads it separately via `getPlatformDb()`.
  localeCode            String   @unique(map: "UQ_LocaleSettings_localeCode") @db.VarChar(16)
  isEnabled             Boolean
  voiceName             String?  @db.NVarChar(80)
  translatedStringCount Int
  totalStringCount      Int
  isFallback            Boolean
  createdAt             DateTime @db.DateTime2
  updatedAt             DateTime @updatedAt @db.DateTime2

  @@map("LocaleSettings")
}

/// What makes 82% a real number rather than a typed one (B10 tab 5, B13 tab 3).
///
/// `CK_TranslationStrings_valuePaired CHECK ((state = 'Missing') = (value IS NULL))` and
/// `TR_TranslationStrings_recountLocale`, which maintains
/// `LocaleSettings.translatedStringCount`, live in `prisma/sql/001_constraints.sql`.
model TranslationString {
  id                   String   @id @db.Char(26)
  stringKey            String   @db.VarChar(200)
  localeCode           String   @db.VarChar(16)
  value                String?  @db.NVarChar(Max)
  /// `Missing` | `Draft` | `Translated` | `Reviewed`.
  state                String   @db.VarChar(12)
  updatedByStaffUserId String?  @db.Char(26)
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2

  @@unique([stringKey, localeCode], map: "UQ_TranslationStrings_stringKey_localeCode")
  @@index([localeCode, state], map: "IX_TranslationStrings_localeCode_state")
  @@map("TranslationStrings")
}

// -------------------------------------------------------------------------------------
// tenant · 4.11 verification — providers, step-up, identity stitching
//
// Four assurance levels, ordered, because step-up is a comparison
// `rank(session) >= rank(required)`:
//   L0 `Anonymous` · L1 `Verified` · L2 `VerifiedPlusOtp` · L2 `VerifiedPlusDocument`.
// Two values share rank L2 deliberately: a document check and an OTP are *alternative*
// second factors, not a hierarchy — a kiosk user who scanned an Emirates ID must not
// then be forced through an SMS. L3 is left unallocated rather than invented (RISK-006):
// a rank with no step-up rule requiring it and no provider producing it would be dead
// configuration that no CHECK constraint could honestly permit.
// -------------------------------------------------------------------------------------

/// The three rows of B11 tab 1 (ADR-0006).
///
/// `CK_VerificationProviders_enabledNeedsCredential CHECK (isEnabled = 0 OR
/// credentialSecretRef IS NOT NULL)`, `_providerType`, `_providesAssurance` and
/// `_configJson_isJson` live in `prisma/sql/001_constraints.sql`.
model VerificationProvider {
  id                  String   @id @db.Char(26)
  /// `UaePass` | `OtpSms` | `EmiratesIdScan`.
  key                 String   @unique(map: "UQ_VerificationProviders_key") @db.VarChar(32)
  name                String   @db.NVarChar(200)
  /// `NationalDigitalIdentity` | `PossessionFactor` | `DocumentCheck`.
  providerType        String   @db.VarChar(32)
  note                String?  @db.NVarChar(500)
  isEnabled           Boolean
  ordinal             Int      @unique(map: "UQ_VerificationProviders_ordinal") @db.TinyInt
  configJson          String?  @db.NVarChar(Max)
  credentialSecretRef String?  @db.NVarChar(200)
  /// The assurance level a successful run of this provider produces.
  providesAssurance   String   @db.VarChar(32)
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  @@map("VerificationProviders")
}

/// Singleton. Holds the single most consequential toggle in the prototype.
///
/// **`CK_VerificationConfigs_disableNeedsReason CHECK (accountOwnershipCheckEnabled = 1
/// OR (ownershipCheckDisabledReason IS NOT NULL AND
/// ownershipCheckLastChangedByStaffUserId IS NOT NULL))`** — B11 tab 1: "with ownership
/// checking off, a user could look up or pay against an account they do not hold."
/// Turning it off is permitted, because the wireframe makes it a toggle; turning it off
/// *silently* is not. Combined with the mandatory `AuditLogEntries` write on every config
/// change, the disabled state always has a name and a stated justification attached.
///
/// The check lives in `prisma/sql/001_constraints.sql` with
/// `CK_VerificationConfigs_singleton` and `_otpBounds`.
model VerificationConfig {
  id                                     String    @id @db.Char(26)
  singletonKey                           Int       @unique(map: "UQ_VerificationConfigs_singleton") @default(1) @db.TinyInt
  accountOwnershipCheckEnabled           Boolean   @default(true)
  ownershipCheckDisabledReason           String?   @db.NVarChar(500)
  ownershipCheckLastChangedByStaffUserId String?   @db.Char(26)
  ownershipCheckLastChangedAt            DateTime? @db.DateTime2
  otpLengthDigits                        Int       @db.TinyInt
  otpTtlSeconds                          Int
  otpMaxAttempts                         Int       @db.TinyInt
  createdAt                              DateTime  @db.DateTime2
  updatedAt                              DateTime  @updatedAt @db.DateTime2

  @@map("VerificationConfigs")
}

/// Which assurance level each sensitive action demands (B11 tab 2).
///
/// `TR_StepUpRules_paymentFloor` — `InitiatePayment` may not be relaxed below
/// `VerifiedPlusOtp` (FR-PAY-06) — and `CK_StepUpRules_requiredAssurance` /
/// `_actionKey` live in `prisma/sql/001_constraints.sql`.
model StepUpRule {
  id                String   @id @db.Char(26)
  /// `ViewBillBalance` | `LinkUtilityAccount` | `InitiatePayment` | `ChangeRegisteredMobile`.
  actionKey         String   @unique(map: "UQ_StepUpRules_actionKey") @db.VarChar(48)
  requiredAssurance String   @db.VarChar(32)
  isEnabled         Boolean
  ordinal           Int      @db.TinyInt
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  @@map("StepUpRules")
}

/// Singleton. B11 tab 5's stitching and memory **scope** controls.
///
/// **Memory *lifetime* is deliberately not here.** `memoryRetentionDays` was retired by
/// product-owner decision 2026-09-08 (RISK-022, §10.5): B11 tab 5 and B14 tab 4 both
/// claimed authority over derived conversation memory, and because the effective value
/// was the stricter of two, B14's 7-year option was unreachable.
/// `PrivacyConfigs.transcriptRetention` is now the **single authority** over transcripts
/// and derived memory, and B11 tab 5 renders the resolved value read-only with B14 tab 4
/// named as its source. Do not reintroduce a retention column here.
///
/// `CK_IdentityStitchingConfigs_neverStitchCoherent CHECK ((stitchingKey = 'NeverStitch')
/// = (stitchAcrossChannels = 0))` — "stitch on, key = never" is a contradiction the screen
/// cannot express, so neither can the table — lives in
/// `prisma/sql/001_constraints.sql`.
model IdentityStitchingConfig {
  id                      String   @id @db.Char(26)
  singletonKey            Int      @unique(map: "UQ_IdentityStitchingConfigs_singleton") @default(1) @db.TinyInt
  stitchAcrossChannels    Boolean
  /// `VerifiedEmiratesIdHash` | `MobileNumber` | `NeverStitch`.
  stitchingKey            String   @db.VarChar(32)
  /// `PerVerifiedIdentity` | `PerChannelSession` | `NoMemory` — **scope**, i.e. whose
  /// memory a turn joins. Lifetime is `PrivacyConfigs.transcriptRetention`.
  conversationMemoryScope String   @db.VarChar(32)
  createdAt               DateTime @db.DateTime2
  updatedAt               DateTime @updatedAt @db.DateTime2

  @@map("IdentityStitchingConfigs")
}

/// A citizen, at the assurance level actually achieved. **Only hashes and masks** — no
/// plaintext identifier is ever stored.
///
/// Retained as a **tombstone** on subject erasure, with every hash and mask nulled and
/// `erasedAt` set, because `Transactions.citizenIdentityId` must remain a resolvable
/// foreign key for the statutory 7 years (§10.4).
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_CitizenIdentities_emiratesIdHash ... WHERE emiratesIdHash IS NOT NULL AND erasedAt
/// IS NULL`; the filtered `IX_CitizenIdentities_mobileHash`;
/// **`CK_CitizenIdentities_verifiedHasEvidence CHECK (assuranceLevel = 'Anonymous' OR
/// (verifiedByProviderKey IS NOT NULL AND verifiedAt IS NOT NULL))`**; and
/// `CK_CitizenIdentities_noPlaintextId CHECK (emiratesIdHash IS NULL OR
/// LEN(emiratesIdHash) = 64)`.
model CitizenIdentity {
  id                    String    @id @db.Char(26)
  assuranceLevel        String    @db.VarChar(32)
  emiratesIdHash        String?   @db.Char(64)
  mobileHash            String?   @db.Char(64)
  displayNameMasked     String?   @db.NVarChar(120)
  verifiedByProviderKey String?   @db.VarChar(32)
  verifiedAt            DateTime? @db.DateTime2
  verificationExpiresAt DateTime? @db.DateTime2
  erasedAt              DateTime? @db.DateTime2
  createdAt             DateTime  @db.DateTime2
  updatedAt             DateTime  @updatedAt @db.DateTime2

  conversations         Conversation[]
  identityLinks         IdentityLink[]
  linkedServiceAccounts LinkedServiceAccount[]
  verificationAttempts  VerificationAttempt[]
  transactions          Transaction[]
  campaignSends         CampaignSend[]
  consentEntries        ConsentLedgerEntry[]
  escalationTickets     EscalationTicket[]
  erasureRequests       ErasureRequest[]

  @@map("CitizenIdentities")
}

/// One channel subject bound to one identity. The stitching join.
///
/// **`CK_IdentityLinks_verifiedOnly CHECK (assuranceLevelAtLink <> 'Anonymous')`** is
/// B11 tab 5's rule made structural: "stitching only ever joins verified sessions; an
/// anonymous web chat is never merged into a verified WhatsApp identity." The level is
/// recorded **at the moment of linking** rather than read from the identity, because an
/// identity's assurance can be re-established later and that later verification must not
/// retroactively legitimise a link that was anonymous when it was made. Anonymous
/// sessions therefore carry no link row at all.
///
/// The check and `UQ_IdentityLinks_channelKey_channelSubjectHash ... WHERE unlinkedAt IS
/// NULL` live in `prisma/sql/001_constraints.sql`.
model IdentityLink {
  id                   String    @id @db.Char(26)
  citizenIdentityId    String    @db.Char(26)
  channelKey           String    @db.VarChar(24)
  channelSubjectHash   String    @db.Char(64)
  assuranceLevelAtLink String    @db.VarChar(32)
  stitchingKeyUsed     String?   @db.VarChar(32)
  linkedAt             DateTime  @db.DateTime2
  unlinkedAt           DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  citizenIdentity CitizenIdentity @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([citizenIdentityId], map: "IX_IdentityLinks_citizenIdentityId")
  @@map("IdentityLinks")
}

/// Every step-up attempt, successful or not. **Append-only**, never deleted (§1.4).
/// `IX_VerificationAttempts_result_attemptedAt` is what makes brute-force detection a
/// query rather than a log grep.
///
/// The `DENY UPDATE, DELETE` grant and `CK_VerificationAttempts_result` live in
/// `prisma/sql/001_constraints.sql`.
model VerificationAttempt {
  id                String   @id @db.Char(26)
  conversationId    String?  @db.Char(26)
  citizenIdentityId String?  @db.Char(26)
  providerKey       String   @db.VarChar(32)
  actionKey         String?  @db.VarChar(48)
  requiredAssurance String?  @db.VarChar(32)
  /// `Success` | `Failed` | `Expired` | `Cancelled` | `RateLimited`.
  result            String   @db.VarChar(16)
  failureReason     String?  @db.VarChar(64)
  attemptedAt       DateTime @db.DateTime2
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  conversation    Conversation?    @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  citizenIdentity CitizenIdentity? @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversationId, attemptedAt], map: "IX_VerificationAttempts_conversationId_attemptedAt")
  @@index([result, attemptedAt], map: "IX_VerificationAttempts_result_attemptedAt")
  @@map("VerificationAttempts")
}

/// A utility account a citizen has claimed, and whether ownership was **proven** (B11
/// tab 1, A2 step 3's `awaiting slot: account_number`).
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_LinkedServiceAccounts_identity_provider_hash ... WHERE unlinkedAt IS NULL`;
/// **`CK_LinkedServiceAccounts_verifiedPaired CHECK ((ownershipVerified = 0) =
/// (ownershipVerifiedAt IS NULL))`**; and
/// `CK_LinkedServiceAccounts_maskedNotFull CHECK (accountNumberMasked LIKE '%[*x]%')` —
/// the masked column must actually be masked.
model LinkedServiceAccount {
  id                   String    @id @db.Char(26)
  citizenIdentityId    String    @db.Char(26)
  providerKey          String    @db.VarChar(32)
  accountNumberMasked  String    @db.NVarChar(48)
  accountNumberHash    String    @db.Char(64)
  ownershipVerified    Boolean
  ownershipVerifiedAt  DateTime? @db.DateTime2
  ownershipVerifiedVia String?   @db.VarChar(32)
  linkedAt             DateTime  @db.DateTime2
  unlinkedAt           DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  citizenIdentity CitizenIdentity @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transactions    Transaction[]

  @@index([accountNumberHash], map: "IX_LinkedServiceAccounts_accountNumberHash")
  @@map("LinkedServiceAccounts")
}

// -------------------------------------------------------------------------------------
// tenant · 4.12 payments — gateways, transactions, refunds
//
// `amountMinor BIGINT`, never DECIMAL or float: AED 412.00 is 41200 fils. A currency
// amount that participates in refund arithmetic must be an exact integer, because a
// rounding difference in a government payment record is a reconciliation incident.
// -------------------------------------------------------------------------------------

/// B11 tab 3's two rows.
///
/// `CK_PaymentGateways_methodsJson_isJson`, `_mode` and
/// `CK_PaymentGateways_liveNeedsRefundPolicy` live in
/// `prisma/sql/001_constraints.sql`.
model PaymentGateway {
  id                  String   @id @db.Char(26)
  key                 String   @unique(map: "UQ_PaymentGateways_key") @db.VarChar(32)
  name                String   @db.NVarChar(200)
  methodsJson         String   @db.NVarChar(Max)
  /// `Live` | `Sandbox`.
  mode                String   @db.VarChar(12)
  credentialSecretRef String   @db.NVarChar(200)
  isEnabled           Boolean
  supportsRefunds     Boolean
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  transactions Transaction[]

  @@map("PaymentGateways")
}

/// Singleton. The three receipt switches of B11 tab 3.
///
/// `CK_ReceiptConfigs_singleton` lives in `prisma/sql/001_constraints.sql`.
model ReceiptConfig {
  id                               String   @id @db.Char(26)
  singletonKey                     Int      @unique(map: "UQ_ReceiptConfigs_singleton") @default(1) @db.TinyInt
  sendInConversation               Boolean
  emailPdfCopy                     Boolean
  allowRefundRequestsFromAssistant Boolean
  createdAt                        DateTime @db.DateTime2
  updatedAt                        DateTime @updatedAt @db.DateTime2

  @@map("ReceiptConfigs")
}

/// The money record. **Statutory 7-year retention, exempt from transcript retention**
/// (B14 tab 4's rule). Never deleted by any configurable path (§1.4, §10.1).
///
/// Three mechanisms make the carve-out structural rather than a code branch:
/// `PrivacyConfigs` has **no** transaction-retention column, so no screen can offer one;
/// **`retentionExpiresAt` is a computed persisted column** `DATEADD(YEAR, 7,
/// initiatedAt)` — not writable, so it cannot be shortened by an update; and
/// **`TR_Transactions_blockDelete`** rejects any delete where `retentionExpiresAt >
/// SYSUTCDATETIME()`, whatever the caller's role. All three live in
/// `prisma/sql/001_constraints.sql`; the computed column is deliberately absent from
/// this model so nothing can write to it.
///
/// **`CK_Transactions_verifiedOnly CHECK (assuranceLevelAtPayment <> 'Anonymous')`**
/// closes the loop from A2 to B11: a transaction created without a completed step-up is
/// not merely a policy violation, it is a **row that cannot exist**.
/// `assuranceLevelAtPayment` is stored on the transaction rather than read from the
/// identity for the same reason `IdentityLinks` stores its level — the evidence must
/// reflect the moment of the payment, not the identity's state at audit time.
///
/// Also in the SQL file: `UQ_Transactions_reference` and `UQ_Transactions_idempotencyKey`
/// are declared here in Prisma; `CK_Transactions_amountPositive CHECK (amountMinor > 0)`,
/// `CK_Transactions_settledPaired`, `CK_Transactions_failurePaired`, `_status` and
/// `_currency` are in the SQL file.
///
/// A conversation whose retention has expired but which has a transaction attached is
/// purged **asymmetrically**: turns, traces and citations go; the transaction stays with
/// `conversationId` set to `NULL` and `serviceLabel` / `reference` intact, and
/// `RetentionSweepRuns.transactionsSkipped` records the count (§10.1).
model Transaction {
  id                      String    @id @db.Char(26)
  /// Human-quotable reference, e.g. `TXN-88213`.
  reference               String    @unique(map: "UQ_Transactions_reference") @db.VarChar(24)
  /// Nulled by the retention sweep when the conversation is purged.
  conversationId          String?   @db.Char(26)
  citizenIdentityId       String    @db.Char(26)
  paymentGatewayId        String    @db.Char(26)
  serviceKey              String    @db.VarChar(48)
  /// Denormalised so a purged conversation leaves a legible record.
  serviceLabel            String    @db.NVarChar(200)
  linkedServiceAccountId  String?   @db.Char(26)
  /// Minor units (fils). Exact integer arithmetic only.
  amountMinor             BigInt
  currency                String    @default("AED") @db.Char(3)
  /// `Initiated` | `Pending` | `Settled` | `Failed` | `Declined` | `RefundRequested` |
  /// `Refunded`.
  status                  String    @db.VarChar(20)
  gatewayReference        String?   @db.VarChar(120)
  idempotencyKey          String    @unique(map: "UQ_Transactions_idempotencyKey") @db.VarChar(120)
  /// Never `Anonymous` — see `CK_Transactions_verifiedOnly`.
  assuranceLevelAtPayment String    @db.VarChar(32)
  initiatedAt             DateTime  @db.DateTime2
  settledAt               DateTime? @db.DateTime2
  failureCode             String?   @db.VarChar(64)
  createdAt               DateTime  @db.DateTime2
  updatedAt               DateTime  @updatedAt @db.DateTime2

  conversation         Conversation?         @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  citizenIdentity      CitizenIdentity       @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentGateway       PaymentGateway        @relation(fields: [paymentGatewayId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedServiceAccount LinkedServiceAccount? @relation(fields: [linkedServiceAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refundRequests       RefundRequest[]
  paymentEvents        PaymentEvent[]

  @@index([status, initiatedAt(sort: Desc)], map: "IX_Transactions_status_initiatedAt")
  @@index([citizenIdentityId], map: "IX_Transactions_citizenIdentityId")
  @@map("Transactions")
}

/// B11 tab 4's pending item and its resolution. Retained 7 years with the transaction
/// (§10.1).
///
/// `UQ_RefundRequests_pendingPerTransaction (transactionId) WHERE status = 'Pending'`,
/// `CK_RefundRequests_decidedPaired` and
/// `TR_RefundRequests_amountWithinTransaction` — the refund cannot exceed the settled
/// amount less prior refunds — live in `prisma/sql/001_constraints.sql`.
model RefundRequest {
  id                     String    @id @db.Char(26)
  transactionId          String    @db.Char(26)
  /// `Citizen` | `LiveAgent` | `BackOffice`.
  requestedByKind        String    @db.VarChar(16)
  requestedByStaffUserId String?   @db.Char(26)
  reason                 String    @db.NVarChar(500)
  amountMinor            BigInt
  /// `Pending` | `Approved` | `Declined`.
  status                 String    @db.VarChar(12)
  decidedByStaffUserId   String?   @db.Char(26)
  decidedAt              DateTime? @db.DateTime2
  decisionNote           String?   @db.NVarChar(500)
  requestedAt            DateTime  @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, requestedAt], map: "IX_RefundRequests_status_requestedAt")
  @@map("RefundRequests")
}

/// Gateway webhook ledger. **Append-only and idempotent**, never deleted (§1.4).
///
/// **`UQ_PaymentEvents_gatewayEventId`** means a redelivered webhook is discarded by the
/// index, not by a code path. `CK_PaymentEvents_signatureVerified CHECK
/// (signatureVerified = 1)` means an unverified webhook is rejected at the adapter and
/// never becomes a row — both the check and the `DENY UPDATE, DELETE` grant are in
/// `prisma/sql/001_constraints.sql`.
model PaymentEvent {
  id                  String   @id @db.Char(26)
  transactionId       String   @db.Char(26)
  kind                String   @db.VarChar(32)
  gatewayEventId      String   @unique(map: "UQ_PaymentEvents_gatewayEventId") @db.VarChar(120)
  payloadRedactedJson String   @db.NVarChar(Max)
  signatureVerified   Boolean
  occurredAt          DateTime @db.DateTime2
  receivedAt          DateTime @db.DateTime2
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([transactionId, occurredAt], map: "IX_PaymentEvents_transactionId_occurredAt")
  @@map("PaymentEvents")
}

// -------------------------------------------------------------------------------------
// tenant · 4.13 governance — policies, promotion, audit, privacy, ops
// -------------------------------------------------------------------------------------

/// The tenant's toggle/threshold for an **unlocked** policy (B12 tab 1). Hard-deleted
/// (§1.4).
///
/// **`FK_PolicySettings_OverridablePolicies`** points at `platform.OverridablePolicies`,
/// not `platform.Policies` (§3.4). A locked policy has no parent row, so a tenant toggle
/// for it **cannot be inserted** — B12's "locked policies cannot be toggled or overridden
/// by any role" is a foreign-key violation rather than a branch five screens could each
/// forget. And because the effective-policy resolver computes
/// `COALESCE(override, tenantSetting, platformDefault)`, a locked policy resolves to its
/// platform default *by construction* rather than by a branch someone could invert.
///
/// `CK_PolicySettings_valueJson_isJson` lives in `prisma/sql/001_constraints.sql`.
model PolicySetting {
  id                   String   @id @db.Char(26)
  /// References `platform.OverridablePolicy.policyKey` — NOT a Prisma `@relation`.
  /// `OverridablePolicy` lives in prisma/platform/schema.prisma, a separate generated
  /// client; Prisma cannot express a relation across two clients (ADR-0011). The SQL
  /// Server FOREIGN KEY constraint (`PolicySettings_policyKey_fkey`) is unaffected —
  /// hand-written, idempotent DDL in prisma/sql/001_constraints.sql, not Prisma-managed.
  /// A caller needing the `OverridablePolicy` row reads it separately via
  /// `getPlatformDb()`.
  policyKey            String   @unique(map: "UQ_PolicySettings_policyKey") @db.VarChar(64)
  isEnabled            Boolean
  valueJson            String?  @db.NVarChar(Max)
  updatedByStaffUserId String   @db.Char(26)
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2

  @@map("PolicySettings")
}

/// A per-agent override, with a mandatory reason (B12 tab 2). This is where wizard step
/// 7's three guardrail toggles live — they are **not** agent columns, which is what B12's
/// purpose sentence requires ("central policy inherited by every agent, so a rule change
/// lands everywhere at once"). It is also why the wizard's Mask PII toggle is inert:
/// `mask_pii_in_transcripts` is locked, has no `OverridablePolicies` row, and therefore
/// cannot receive an override. The screen shows it ticked and non-negotiable, and the
/// database agrees.
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_PolicyOverrides_active (agentId, policyKey) WHERE removedAt IS NULL`;
/// **`CK_PolicyOverrides_reasonSubstantive CHECK (LEN(LTRIM(RTRIM(reason))) >= 10)`**;
/// `CK_PolicyOverrides_valuePaired CHECK ((mode = 'Value') = (valueJson IS NOT NULL))`;
/// and `TR_PolicyOverrides_respectFloor` — an override may not be *weaker* than
/// `platform.Policies.floorValueJson`.
model PolicyOverride {
  id                   String    @id @db.Char(26)
  agentId              String    @db.Char(26)
  /// References `platform.OverridablePolicy.policyKey` — NOT a Prisma `@relation`.
  /// `OverridablePolicy` lives in prisma/platform/schema.prisma, a separate generated
  /// client; Prisma cannot express a relation across two clients (ADR-0011). The SQL
  /// Server FOREIGN KEY constraint (`PolicyOverrides_policyKey_fkey`) is unaffected —
  /// hand-written, idempotent DDL in prisma/sql/001_constraints.sql, not Prisma-managed.
  /// A caller needing the `OverridablePolicy` row reads it separately via
  /// `getPlatformDb()`.
  policyKey            String    @db.VarChar(64)
  /// `Value` | `Disabled`.
  mode                 String    @db.VarChar(12)
  valueJson            String?   @db.NVarChar(Max)
  /// Mandatory and substantive: an override with no stated justification is the audit
  /// failure B12 exists to prevent.
  reason               String    @db.NVarChar(500)
  createdByStaffUserId String    @db.Char(26)
  removedByStaffUserId String?   @db.Char(26)
  removedAt            DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  agent Agent @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([policyKey], map: "IX_PolicyOverrides_policyKey")
  @@map("PolicyOverrides")
}

/// Which agent version sits in which environment — the **promotion** half of B2's rule,
/// deliberately a different table from `AgentVersions.isCurrent` so rollback and
/// promotion cannot be conflated (§4.4).
///
/// `FK_VersionDeployments_Environments` points at `platform.Environments`: the promotion
/// chain is a property of the deployment topology, identical for every tenant, so a
/// tenant inventing a fourth environment would break the symmetry with the Kubernetes
/// namespaces of architecture §12.
///
/// **`UQ_VersionDeployments_live (agentId, environmentKey) WHERE state = 'Deployed'`** —
/// one version of one agent per environment, which is what makes B14 tab 1's
/// `v1.3 / v2.1 / v2.4` column well-defined — is filtered and lives in
/// `prisma/sql/001_constraints.sql` with `CK_VersionDeployments_supersededPaired`.
model VersionDeployment {
  id                    String    @id @db.Char(26)
  agentId               String    @db.Char(26)
  agentVersionId        String    @db.Char(26)
  /// References `platform.Environment.key` — NOT a Prisma `@relation`. `Environment`
  /// lives in prisma/platform/schema.prisma, a separate generated client; Prisma cannot
  /// express a relation across two clients (ADR-0011). The SQL Server FOREIGN KEY
  /// constraint (`VersionDeployments_environmentKey_fkey`) is unaffected — hand-written,
  /// idempotent DDL in prisma/sql/001_constraints.sql, not Prisma-managed. A caller
  /// needing the `Environment` row reads it separately via `getPlatformDb()`.
  environmentKey        String    @db.VarChar(16)
  /// `Deployed` | `Superseded`.
  state                 String    @db.VarChar(12)
  deployedAt            DateTime  @db.DateTime2
  deployedByStaffUserId String    @db.Char(26)
  supersededAt          DateTime? @db.DateTime2
  promotionRequestId    String?   @db.Char(26)
  createdAt             DateTime  @db.DateTime2
  updatedAt             DateTime  @updatedAt @db.DateTime2

  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentVersion     AgentVersion      @relation(fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotionRequest PromotionRequest? @relation(fields: [promotionRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([environmentKey, state], map: "IX_VersionDeployments_environmentKey_state")
  @@map("VersionDeployments")
}

/// A pending environment promotion awaiting approval (B14 tab 1).
///
/// Four triggers, all in `prisma/sql/001_constraints.sql`, carry rules no column can:
/// `TR_PromotionRequests_followsChain` — `toEnvironmentKey` must equal
/// `platform.Environments.promotesToKey` for `fromEnvironmentKey`, so UAT to Production
/// is legal and Development to Production is not;
/// **`TR_PromotionRequests_gateMustPass`** — where `PublishGates.blockOnSuiteFailure = 1`
/// a request targeting the live environment must carry a `gateEvaluationId` whose row has
/// `passed = 1` for the same version, and the trigger reads the singleton *inside itself*
/// rather than each call site remembering to consult it;
/// **`TR_PromotionRequests_separationOfDuties`** — `decidedByStaffUserId <>
/// requestedByStaffUserId`, so a requester cannot approve their own promotion
/// (FR-GOV-15);
/// **`TR_PromotionRequests_auditOnDecision`** — the audit entry is written in the **same
/// transaction** as the decision, by trigger rather than in an application service a
/// second call site could bypass, which is what guarantees B14 tab 1 and tab 2 can never
/// disagree.
///
/// Also there: `UQ_PromotionRequests_pending (agentVersionId, toEnvironmentKey) WHERE
/// status = 'AwaitingApproval'`, `CK_PromotionRequests_differentEnvironments` and
/// `_decidedPaired`.
model PromotionRequest {
  id                     String    @id @db.Char(26)
  agentVersionId         String    @db.Char(26)
  fromEnvironmentKey     String    @db.VarChar(16)
  toEnvironmentKey       String    @db.VarChar(16)
  requestedByStaffUserId String    @db.Char(26)
  requestedAt            DateTime  @db.DateTime2
  /// `AwaitingApproval` | `Approved` | `Rejected` | `Withdrawn`.
  status                 String    @db.VarChar(20)
  gateEvaluationId       String?   @db.Char(26)
  decidedByStaffUserId   String?   @db.Char(26)
  decidedAt              DateTime? @db.DateTime2
  decisionNote           String?   @db.NVarChar(500)
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  agentVersion    AgentVersion        @relation(fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gateEvaluation  GateEvaluation?     @relation("PromotionRequestGateEvaluation", fields: [gateEvaluationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gateEvaluations GateEvaluation[]    @relation("GateEvaluationPromotionRequest")
  deployments     VersionDeployment[]

  @@index([status, requestedAt], map: "IX_PromotionRequests_status_requestedAt")
  @@map("PromotionRequests")
}

/// The immutable change record (B14 tab 2). **Append-only and hash-chained**; never
/// deleted, and absent from every purge path in §10 including erasure — an erasure
/// request removes the *citizen's* data, while an audit entry records a *staff member's*
/// action on configuration.
///
/// Four layered mechanisms, all in `prisma/sql/001_constraints.sql`, because each covers
/// a hole the others leave:
/// 1. **Grant** — `GRANT SELECT, INSERT`, then `DENY UPDATE, DELETE ... TO PUBLIC`.
/// 2. **Trigger** — `TR_AuditLogEntries_blockMutation` covers a future `db_owner`
///    connection, a migration or a DBA session that the grants do not constrain.
/// 3. **Hash chain** — `entryHash = SHA256(prevHash || sequenceNo || occurredAt || actor
///    || action || target || summary)` makes an out-of-band mutation *detectable* rather
///    than merely forbidden. A nightly verifier walks the chain per tenant and raises an
///    alert on the first mismatch, surfaced in B14 tab 3.
/// 4. **No soft delete and no retention sweep.**
///
/// The `actor…Snapshot` and `targetLabelSnapshot` columns are denormalised so entries
/// stay legible forever — "Granted Entity Admin role to Lina Haddad" must read correctly
/// after Lina's account is removed and after the role is renamed. Foreign keys alone
/// would render as dangling ids or, worse, silently re-render with today's values and
/// misstate what happened. This is also why `beforeJson`/`afterJson` are JSON rather than
/// typed columns pointing at config rows: the entry must survive the deletion of what it
/// describes, which is exactly what allows §1.4 to hard-delete routing rules and binding
/// rows.
///
/// Clustered on `(occurredAt, id)`, so the primary key is non-clustered.
model AuditLogEntry {
  id                       String   @id(map: "PK_AuditLogEntries", clustered: false) @db.Char(26)
  occurredAt               DateTime @db.DateTime2
  /// Nullable and kept only for filtering; legibility comes from the snapshots.
  actorStaffUserId         String?  @db.Char(26)
  actorDisplayNameSnapshot String   @db.NVarChar(200)
  actorRoleSnapshot        String   @db.NVarChar(120)
  action                   String   @db.VarChar(64)
  targetKind               String   @db.VarChar(48)
  targetId                 String?  @db.Char(26)
  targetLabelSnapshot      String   @db.NVarChar(300)
  environmentKey           String?  @db.VarChar(16)
  beforeJson               String?  @db.NVarChar(Max)
  afterJson                String?  @db.NVarChar(Max)
  summary                  String   @db.NVarChar(500)
  correlationId            String   @db.Char(26)
  requestId                String?  @db.Char(26)
  ipHash                   String?  @db.Char(64)
  userAgentHash            String?  @db.Char(64)
  /// Chain position. `IDENTITY`, unlike entity ids (§1.2), because the chain needs a
  /// gapless monotone sequence the database issues.
  sequenceNo               BigInt   @unique(map: "UQ_AuditLogEntries_sequenceNo") @default(autoincrement())
  prevHash                 String?  @db.Char(64)
  entryHash                String   @db.Char(64)
  createdAt                DateTime @db.DateTime2
  updatedAt                DateTime @updatedAt @db.DateTime2

  @@index([occurredAt, id], map: "IX_AuditLogEntries_occurredAt_id", clustered: true)
  @@index([actorStaffUserId, occurredAt], map: "IX_AuditLogEntries_actorStaffUserId_occurredAt")
  @@index([targetKind, targetId], map: "IX_AuditLogEntries_targetKind_targetId")
  @@index([action, occurredAt], map: "IX_AuditLogEntries_action_occurredAt")
  @@map("AuditLogEntries")
}

/// Singleton. B14 tab 4.
///
/// **`transcriptRetention` is the single authority** over transcripts and derived memory
/// (§10.5, RISK-022 resolved): `IdentityStitchingConfigs.memoryRetentionDays` was retired
/// because two settings over one body of data made B14's 7-year option unreachable.
///
/// **There is deliberately no transaction-retention column.** A setting that does not
/// exist cannot be misconfigured, and no screen can offer it — which is the first of the
/// three mechanisms that make the statutory 7-year carve-out structural (§10.1).
///
/// `CK_PrivacyConfigs_transcriptRetention CHECK (transcriptRetention IN
/// ('Days30','Days90','Year1','Year7'))`, `_dataResidency` and `_singleton` live in
/// `prisma/sql/001_constraints.sql`.
model PrivacyConfig {
  id                    String   @id @db.Char(26)
  singletonKey          Int      @unique(map: "UQ_PrivacyConfigs_singleton") @default(1) @db.TinyInt
  consentLedgerEnabled  Boolean
  honourErasureRequests Boolean
  /// `Days30` | `Days90` | `Year1` | `Year7` — default `Days90`.
  transcriptRetention   String   @default("Days90") @db.VarChar(12)
  /// `UaeSharjahDc` | `UaeDubaiDc` | `RegionFlexible`.
  dataResidency         String   @db.VarChar(32)
  updatedByStaffUserId  String   @db.Char(26)
  createdAt             DateTime @db.DateTime2
  updatedAt             DateTime @updatedAt @db.DateTime2

  @@map("PrivacyConfigs")
}

/// Append-only consent history (B14 tab 4, B10 tab 4). An opt-out is a **new entry**,
/// never an update or a deletion of the opt-in. Never purged by retention: it is the
/// evidence that a purge or a send was lawful, so its lifetime must exceed that of the
/// data it authorises (§10.3).
///
/// Purposes are separate rows because they are separately revocable — collapsing them
/// into one boolean would mean revoking marketing messages also revoked identity
/// stitching, which is neither what the citizen asked nor what the screens model.
///
/// The `DENY UPDATE, DELETE` grant, `CK_ConsentLedgerEntries_identityPaired`, `_purpose`,
/// `_action` and `TR_ConsentLedgerEntries_project` (which maintains `ConsentStates`) live
/// in `prisma/sql/001_constraints.sql`.
model ConsentLedgerEntry {
  id                String   @id @db.Char(26)
  /// `CitizenIdentity` | `ContactHash`.
  subjectKind       String   @db.VarChar(24)
  citizenIdentityId String?  @db.Char(26)
  subjectHash       String   @db.Char(64)
  channelKey        String   @db.VarChar(24)
  /// `ProactiveMessaging` | `TranscriptRetention` | `IdentityStitching`.
  purpose           String   @db.VarChar(48)
  /// `OptIn` | `OptOut`.
  action            String   @db.VarChar(12)
  evidenceKind      String   @db.VarChar(32)
  evidenceRef       String?  @db.NVarChar(300)
  occurredAt        DateTime @db.DateTime2
  sourceTurnId      String?  @db.Char(26)
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  citizenIdentity CitizenIdentity?  @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceTurn      ConversationTurn? @relation(fields: [sourceTurnId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consentStates   ConsentState[]

  @@index([subjectHash, purpose, occurredAt(sort: Desc)], map: "IX_ConsentLedgerEntries_subjectHash_purpose_occurredAt")
  @@map("ConsentLedgerEntries")
}

/// Current consent, **projected from the ledger** for the single indexed read that B10
/// tab 4's send-time check needs. A projection, so it is rebuildable from the ledger and
/// never edited directly.
///
/// Maintained by `TR_ConsentLedgerEntries_project` in `prisma/sql/001_constraints.sql`.
model ConsentState {
  id                String   @id @db.Char(26)
  subjectHash       String   @db.Char(64)
  channelKey        String   @db.VarChar(24)
  purpose           String   @db.VarChar(48)
  /// `OptedIn` | `OptedOut`.
  state             String   @db.VarChar(12)
  lastLedgerEntryId String   @db.Char(26)
  effectiveAt       DateTime @db.DateTime2
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  lastLedgerEntry ConsentLedgerEntry @relation(fields: [lastLedgerEntryId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([subjectHash, channelKey, purpose], map: "UQ_ConsentStates_subject_channel_purpose")
  @@map("ConsentStates")
}

/// A right-to-be-forgotten request within a live tenant (B14 tab 4, §10.4 scope B). The
/// completion record is **also** written to `platform.ErasureRequests` and
/// `platform.PlatformAuditLogEntries`, because in the tenant-erasure case the schema that
/// would hold it no longer exists at the moment the operation succeeds.
///
/// **`TR_ErasureRequests_completionRequiresAllStores`** (in
/// `prisma/sql/001_constraints.sql`) is how completeness is proven — *not* by the absence
/// of an error: the request cannot move to `Completed` unless all four `ErasureTasks`
/// rows are `Completed` with `verifiedAt` set. A missed store leaves the request
/// `InProgress` — visible, alertable, and impossible to mistake for done.
///
/// `verificationEvidenceJson` stores the four queries and their zero results — including,
/// per FR-GOV-22, the `Transactions` count deliberately **not** erased with FR-PAY-08
/// cited as the obligation. An erasure report that silently omits what it could not
/// delete is not a report.
///
/// Also there: `UQ_ErasureRequests_openPerSubject (subjectHash) WHERE status IN
/// ('Received','InProgress')` and `CK_ErasureRequests_rejectedHasReason`.
model ErasureRequest {
  id                       String    @id @db.Char(26)
  subjectKind              String    @db.VarChar(24)
  subjectHash              String    @db.Char(64)
  citizenIdentityId        String?   @db.Char(26)
  receivedVia              String    @db.VarChar(32)
  requestedAt              DateTime  @db.DateTime2
  /// `Received` | `InProgress` | `Completed` | `Rejected`.
  status                   String    @db.VarChar(16)
  rejectionReason          String?   @db.NVarChar(500)
  completedAt              DateTime? @db.DateTime2
  verificationEvidenceJson String?   @db.NVarChar(Max)
  createdAt                DateTime  @db.DateTime2
  updatedAt                DateTime  @updatedAt @db.DateTime2

  citizenIdentity CitizenIdentity? @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks           ErasureTask[]

  @@index([status, requestedAt], map: "IX_ErasureRequests_status_requestedAt")
  @@map("ErasureRequests")
}

/// One per store per request. **Exactly four rows, or the request cannot complete** —
/// `UQ_ErasureTasks_erasureRequestId_store` guarantees the shape and the completion
/// trigger counts them.
///
/// A store where nothing needed deleting is still recorded as `Completed` with
/// `affectedCount = 0`, because **a store that was not checked is indistinguishable from
/// a store that was found clean** (§10.4). `verificationQuery` holds the assertion that
/// was actually run — for Neo4j, both encodings (`:Tenant_<slug>` label count and
/// `tenant_id` property count) must independently return zero (ADR-0009).
///
/// `CK_ErasureTasks_completedIsVerified CHECK (state <> 'Completed' OR verifiedAt IS NOT
/// NULL)` and `CK_ErasureTasks_store` live in `prisma/sql/001_constraints.sql`.
model ErasureTask {
  id                String    @id @db.Char(26)
  erasureRequestId  String    @db.Char(26)
  /// `SqlServer` | `Neo4j` | `Qdrant` | `Redis`.
  store             String    @db.VarChar(16)
  scopeDescription  String    @db.NVarChar(500)
  state             String    @db.VarChar(12)
  affectedCount     Int?
  verificationQuery String?   @db.NVarChar(1000)
  verifiedAt        DateTime? @db.DateTime2
  startedAt         DateTime? @db.DateTime2
  finishedAt        DateTime? @db.DateTime2
  error             String?   @db.NVarChar(Max)
  createdAt         DateTime  @db.DateTime2
  updatedAt         DateTime  @updatedAt @db.DateTime2

  erasureRequest ErasureRequest @relation(fields: [erasureRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([erasureRequestId, store], map: "UQ_ErasureTasks_erasureRequestId_store")
  @@map("ErasureTasks")
}

/// A retention pass and exactly what it purged, per store (B14 tab 4's rule).
/// `transactionsSkipped` is **recorded, not silently omitted** — the statutory carve-out
/// should be visible in the sweep record rather than being an invisible absence (§10.1).
///
/// This table is also what makes FR-GOV-27 answerable: "a retention setting with no
/// successful purge run in its period is an alertable condition" becomes
/// `MAX(finishedAt) WHERE state = 'Completed'` — a query over one table rather than an
/// inference from logs.
///
/// `CK_RetentionSweepRuns_state` and `_retentionSetting` live in
/// `prisma/sql/001_constraints.sql`.
model RetentionSweepRun {
  id                  String    @id @db.Char(26)
  scope               String    @db.VarChar(24)
  retentionSetting    String    @db.VarChar(12)
  cutoffAt            DateTime  @db.DateTime2
  conversationsPurged Int
  turnsPurged         Int
  tracesPurged        Int
  derivedMemoryPurged Int
  vectorsPurged       Int
  graphNodesPurged    Int
  redisKeysPurged     Int
  transactionsSkipped Int
  state               String    @db.VarChar(12)
  startedAt           DateTime  @db.DateTime2
  finishedAt          DateTime? @db.DateTime2
  createdAt           DateTime  @db.DateTime2
  updatedAt           DateTime  @updatedAt @db.DateTime2

  @@index([startedAt(sort: Desc)], map: "IX_RetentionSweepRuns_startedAt")
  @@map("RetentionSweepRuns")
}

/// B14 tab 3's rows, as a time series. Written by `shj3-worker` from OpenTelemetry,
/// because the AI runtime cannot write outside its three groups (§3.6).
///
/// Per-tenant, with platform-shared dependencies sampled into the `sharjah_platform`
/// schema and surfaced to other tenants through the audited cross-tenant rollup path
/// (§14 decision 2) — the alternative, a global table with a nullable `tenantId`, would
/// have put an unfiltered cross-tenant read on an ordinary screen.
///
/// `CK_ServiceHealthSamples_errorRate CHECK (errorRate BETWEEN 0 AND 1)`,
/// `CK_ServiceHealthSamples_window CHECK (windowEnd > windowStart)` and `_status` live in
/// `prisma/sql/001_constraints.sql`.
model ServiceHealthSample {
  id           String   @id @db.Char(26)
  targetKind   String   @db.VarChar(16)
  targetId     String?  @db.Char(26)
  targetKey    String?  @db.VarChar(64)
  displayName  String   @db.NVarChar(200)
  windowStart  DateTime @db.DateTime2
  windowEnd    DateTime @db.DateTime2
  requestCount Int
  p50LatencyMs Int?
  p95LatencyMs Int
  p99LatencyMs Int?
  errorRate    Decimal  @db.Decimal(6, 5)
  /// `Healthy` | `Degraded` | `Down`.
  status       String   @db.VarChar(12)
  createdAt    DateTime @db.DateTime2
  updatedAt    DateTime @updatedAt @db.DateTime2

  @@unique([targetKind, targetId, targetKey, windowStart], map: "UQ_ServiceHealthSamples_target_windowStart")
  @@index([windowStart(sort: Desc)], map: "IX_ServiceHealthSamples_windowStart")
  @@map("ServiceHealthSamples")
}

// -------------------------------------------------------------------------------------
// tenant · 4.14 evaluation — golden sets, regression runs, the publish gate
// -------------------------------------------------------------------------------------

/// B13 tab 1's sets.
///
/// `caseCount` is maintained by `TR_GoldenCases_recount`, because B1's **Add to golden
/// set** must increment a figure B13 reads and a stale count would break the wiring the
/// wireframe demonstrates.
///
/// `UQ_GoldenSets_name ... WHERE deletedAt IS NULL`,
/// `CK_GoldenSets_parityHasLocale CHECK (kind <> 'LanguageParity' OR localeCode IS NOT
/// NULL)` and `CK_GoldenSets_kind` live in `prisma/sql/001_constraints.sql`.
model GoldenSet {
  id            String    @id @db.Char(26)
  name          String    @db.NVarChar(200)
  ownerTenantId String    @db.Char(26)
  description   String?   @db.NVarChar(1000)
  /// `Journey` | `LanguageParity` | `RedTeam` | `ToolAccuracy`.
  kind          String    @db.VarChar(24)
  localeCode    String?   @db.VarChar(16)
  caseCount     Int
  lastScore     Decimal?  @db.Decimal(5, 4)
  lastRunAt     DateTime? @db.DateTime2
  deletedAt     DateTime? @db.DateTime2
  createdAt     DateTime  @db.DateTime2
  updatedAt     DateTime  @updatedAt @db.DateTime2

  cases          GoldenCase[]
  regressionRuns RegressionRun[]

  @@map("GoldenSets")
}

/// One test case. May originate from a real transcript.
///
/// **`UQ_GoldenCases_sourceConversation (goldenSetId, sourceConversationId) WHERE
/// sourceConversationId IS NOT NULL AND deletedAt IS NULL`** is what makes B1's **Add to
/// golden set** button "disable itself with confirmation text" a *data fact* rather than
/// a UI memory.
///
/// It lives in `prisma/sql/001_constraints.sql` with
/// `UQ_GoldenCases_goldenSetId_ordinal ... WHERE deletedAt IS NULL` and
/// `CK_GoldenCases_refusalHasNoTools CHECK (mustRefuse = 0 OR expectedToolCallsJson IS
/// NULL)`.
model GoldenCase {
  id                            String    @id @db.Char(26)
  goldenSetId                   String    @db.Char(26)
  ordinal                       Int
  prompt                        String    @db.NVarChar(Max)
  expectedBehaviour             String    @db.NVarChar(Max)
  expectedToolCallsJson         String?   @db.NVarChar(Max)
  expectedCitationSourceIdsJson String?   @db.NVarChar(Max)
  mustRefuse                    Boolean
  localeCode                    String    @db.VarChar(16)
  sourceConversationId          String?   @db.Char(26)
  addedByStaffUserId            String    @db.Char(26)
  addedAt                       DateTime  @db.DateTime2
  isEnabled                     Boolean
  deletedAt                     DateTime? @db.DateTime2
  createdAt                     DateTime  @db.DateTime2
  updatedAt                     DateTime  @updatedAt @db.DateTime2

  goldenSet          GoldenSet              @relation(fields: [goldenSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sourceConversation Conversation?          @relation(fields: [sourceConversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  caseResults        RegressionCaseResult[]
  feedbackIssues     FeedbackIssue[]

  @@map("GoldenCases")
}

/// B13 tab 2's rows: one set scored against one agent version.
///
/// `UQ_RegressionRuns_active (goldenSetId, agentVersionId) WHERE state IN
/// ('Queued','Running')`, `CK_RegressionRuns_scoresInRange` on all four metrics,
/// `CK_RegressionRuns_finishedHasResult CHECK ((state = 'Completed') = (result IS NOT
/// NULL))` and `_triggeredBy` live in `prisma/sql/001_constraints.sql`.
model RegressionRun {
  id               String    @id @db.Char(26)
  goldenSetId      String    @db.Char(26)
  agentId          String    @db.Char(26)
  agentVersionId   String    @db.Char(26)
  /// `Manual` | `Publish` | `Promotion` | `Schedule`.
  triggeredBy      String    @db.VarChar(16)
  state            String    @db.VarChar(12)
  accuracy         Decimal?  @db.Decimal(5, 4)
  groundedness     Decimal?  @db.Decimal(5, 4)
  toolAccuracy     Decimal?  @db.Decimal(5, 4)
  localeParity     Decimal?  @db.Decimal(5, 4)
  /// `Passed` | `Failed` | `Error`.
  result           String?   @db.VarChar(12)
  casesTotal       Int
  casesPassed      Int
  startedAt        DateTime  @db.DateTime2
  finishedAt       DateTime? @db.DateTime2
  ranByStaffUserId String?   @db.Char(26)
  createdAt        DateTime  @db.DateTime2
  updatedAt        DateTime  @updatedAt @db.DateTime2

  goldenSet    GoldenSet              @relation(fields: [goldenSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agent        Agent                  @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentVersion AgentVersion           @relation(fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  caseResults  RegressionCaseResult[]

  @@index([agentVersionId, startedAt(sort: Desc)], map: "IX_RegressionRuns_agentVersionId_startedAt")
  @@index([goldenSetId, startedAt(sort: Desc)], map: "IX_RegressionRuns_goldenSetId_startedAt")
  @@map("RegressionRuns")
}

/// Per-case outcome, so a failure **names the case**. Cascade-deleted with its run.
///
/// The filtered `IX_RegressionCaseResults_regressionRunId ... WHERE passed = 0` — the
/// failure list, which is the only part usually read — and
/// `CK_RegressionCaseResults_failedHasReason CHECK (passed = 1 OR failureReason IS NOT
/// NULL)` live in `prisma/sql/001_constraints.sql`.
model RegressionCaseResult {
  id                  String   @id @db.Char(26)
  regressionRunId     String   @db.Char(26)
  goldenCaseId        String   @db.Char(26)
  passed              Boolean
  accuracyScore       Decimal? @db.Decimal(5, 4)
  groundednessScore   Decimal? @db.Decimal(5, 4)
  toolAccuracyScore   Decimal? @db.Decimal(5, 4)
  actualResponse      String?  @db.NVarChar(Max)
  actualToolCallsJson String?  @db.NVarChar(Max)
  failureReason       String?  @db.NVarChar(1000)
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  regressionRun RegressionRun @relation(fields: [regressionRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  goldenCase    GoldenCase    @relation(fields: [goldenCaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([regressionRunId, goldenCaseId], map: "UQ_RegressionCaseResults_run_case")
  @@map("RegressionCaseResults")
}

/// Singleton. The five gate settings of B13 tab 3. `TR_PromotionRequests_gateMustPass`
/// reads this row *inside the trigger* — one place — rather than each call site
/// remembering to consult it, so switching the gate off changes behaviour without
/// changing enforcement structure.
///
/// `CK_PublishGates_thresholds CHECK (minAccuracy BETWEEN 0 AND 1 AND minGroundedness
/// BETWEEN 0 AND 1)` and `_singleton` live in `prisma/sql/001_constraints.sql`.
model PublishGate {
  id                         String   @id @db.Char(26)
  singletonKey               Int      @unique(map: "UQ_PublishGates_singleton") @default(1) @db.TinyInt
  blockOnSuiteFailure        Boolean
  minAccuracy                Decimal  @default(0.8500) @db.Decimal(5, 4)
  minGroundedness            Decimal  @default(0.8000) @db.Decimal(5, 4)
  redTeamMustScore100        Boolean
  blockOnBoundLocaleBelow100 Boolean
  updatedByStaffUserId       String   @db.Char(26)
  createdAt                  DateTime @db.DateTime2
  updatedAt                  DateTime @updatedAt @db.DateTime2

  @@map("PublishGates")
}

/// A gate decision, with the reasons that produced it.
///
/// **`CK_GateEvaluations_failedHasReasons CHECK ((passed = 1) = (blockingReasonsJson IS
/// NULL))`** is B13's rule as a constraint — "the gate explains why something is blocked
/// rather than only that it is; the blocking set, its score and the threshold it missed
/// are all named." A failed evaluation with a null reasons array cannot be inserted, so
/// the summary strip's live sentence is rendered from data rather than assembled by
/// string concatenation at the call site.
///
/// `gateSnapshotJson` freezes the thresholds in force, so switching the gate off later
/// does not rewrite the history of a past block.
///
/// The check, `CK_GateEvaluations_gateSnapshotJson_isJson` and `_evaluatedForKind` live
/// in `prisma/sql/001_constraints.sql`.
model GateEvaluation {
  id                  String   @id @db.Char(26)
  agentVersionId      String   @db.Char(26)
  evaluatedAt         DateTime @db.DateTime2
  passed              Boolean
  gateSnapshotJson    String   @db.NVarChar(Max)
  blockingReasonsJson String?  @db.NVarChar(Max)
  /// `Publish` | `Promotion`.
  evaluatedForKind    String   @db.VarChar(16)
  promotionRequestId  String?  @db.Char(26)
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  agentVersion      AgentVersion       @relation(fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotionRequest  PromotionRequest?  @relation("GateEvaluationPromotionRequest", fields: [promotionRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotionRequests PromotionRequest[] @relation("PromotionRequestGateEvaluation")

  @@index([agentVersionId, evaluatedAt(sort: Desc)], map: "IX_GateEvaluations_agentVersionId_evaluatedAt")
  @@map("GateEvaluations")
}

// -------------------------------------------------------------------------------------
// tenant · 4.15 analytics — rollups, feedback queues, gaps
//
// Rollups, not raw events: B1 tab 1 must render three date ranges instantly over 36,410
// conversations without scanning the conversation table per page load. Produced by
// `shj3-worker` on a schedule, idempotent per key so a re-run repairs a partial day
// rather than double-counting, and **rebuildable** from `Conversations`,
// `ConversationTurns` and `OrchestrationTraceSteps` for any date still inside the
// retention window. Rates are computed on read, never stored — a stored
// `containmentRate` alongside its numerator and denominator is a third fact that can
// disagree with the first two.
// -------------------------------------------------------------------------------------

/// The KPI grid and channel split (B1 tab 1).
model ConversationMetricsDaily {
  id                 String   @id @db.Char(26)
  metricDate         DateTime @db.Date
  channelKey         String   @db.VarChar(24)
  agentId            String?  @db.Char(26)
  conversationCount  Int
  containedCount     Int
  deflectedCount     Int
  escalatedCount     Int
  abandonedCount     Int
  turnCount          Int
  toolCallCount      Int
  toolErrorCount     Int
  thumbsUpCount      Int
  thumbsDownCount    Int
  avgFirstResponseMs Int?
  createdAt          DateTime @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  agent Agent? @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([metricDate, channelKey, agentId], map: "UQ_ConversationMetricsDaily_date_channel_agent")
  @@index([metricDate], map: "IX_ConversationMetricsDaily_metricDate")
  @@map("ConversationMetricsDaily")
}

/// B1 tab 1's Top intents list.
model IntentMetricsDaily {
  id                String   @id @db.Char(26)
  metricDate        DateTime @db.Date
  intentKey         String   @db.VarChar(64)
  intentLabel       String   @db.NVarChar(200)
  conversationCount Int
  escalatedCount    Int
  resolvedCount     Int
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  @@unique([metricDate, intentKey], map: "UQ_IntentMetricsDaily_date_intent")
  @@index([metricDate, conversationCount(sort: Desc)], map: "IX_IntentMetricsDaily_metricDate_conversationCount")
  @@map("IntentMetricsDaily")
}

/// B2's `412/day` column. Deliberately **not** denormalised onto `Agents`: a config write
/// and a metrics write would then contend for the same page (§4.4).
model AgentUsageDaily {
  id                String   @id @db.Char(26)
  metricDate        DateTime @db.Date
  agentId           String   @db.Char(26)
  agentVersionId    String?  @db.Char(26)
  conversationCount Int
  turnCount         Int
  toolCallCount     Int
  inputTokens       BigInt
  outputTokens      BigInt
  costMicroAed      BigInt
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentVersion AgentVersion? @relation(fields: [agentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([metricDate, agentId, agentVersionId], map: "UQ_AgentUsageDaily_date_agent_version")
  @@index([agentId, metricDate(sort: Desc)], map: "IX_AgentUsageDaily_agentId_metricDate")
  @@map("AgentUsageDaily")
}

/// B1 tab 3's thumbs-down review queue, clustered with a root cause.
///
/// `CK_FeedbackIssues_fixedPaired CHECK ((status = 'Fixed') = (fixedAt IS NOT NULL))`,
/// `_rootCause` and `_status` live in `prisma/sql/001_constraints.sql`.
model FeedbackIssue {
  id                      String    @id @db.Char(26)
  questionText            String    @db.NVarChar(1000)
  clusterKey              String    @unique(map: "UQ_FeedbackIssues_clusterKey") @db.Char(64)
  volume                  Int
  /// `MissingKnowledge` | `StaleSource` | `ToolFailure` | `GuardrailRefusal` | `Other`.
  rootCause               String    @db.VarChar(24)
  /// `Open` | `Fixed` | `Reopened`.
  status                  String    @db.VarChar(12)
  linkedKnowledgeSourceId String?   @db.Char(26)
  linkedFlowId            String?   @db.Char(26)
  linkedGoldenCaseId      String?   @db.Char(26)
  firstSeenAt             DateTime  @db.DateTime2
  lastSeenAt              DateTime  @db.DateTime2
  fixedByStaffUserId      String?   @db.Char(26)
  fixedAt                 DateTime? @db.DateTime2
  createdAt               DateTime  @db.DateTime2
  updatedAt               DateTime  @updatedAt @db.DateTime2

  linkedKnowledgeSource KnowledgeSource? @relation(fields: [linkedKnowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedFlow            Flow?            @relation(fields: [linkedFlowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  linkedGoldenCase      GoldenCase?      @relation(fields: [linkedGoldenCaseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, volume(sort: Desc)], map: "IX_FeedbackIssues_status_volume")
  @@map("FeedbackIssues")
}

/// B1 tab 3's clustered gaps and their two resolutions.
///
/// **`CK_UnansweredQuestions_resolutionPaired`** makes "resolved, pointing at nothing"
/// unrepresentable: B1 tab 3's rule says an unanswered question "becomes either a
/// knowledge entry or a new flow", so the improvement loop cannot be closed by clicking
/// without doing. The check is in `prisma/sql/001_constraints.sql` with
/// `CK_UnansweredQuestions_status`.
model UnansweredQuestion {
  id                          String    @id @db.Char(26)
  questionText                String    @db.NVarChar(1000)
  clusterKey                  String    @unique(map: "UQ_UnansweredQuestions_clusterKey") @db.Char(64)
  askCount                    Int
  firstAskedAt                DateTime  @db.DateTime2
  lastAskedAt                 DateTime  @db.DateTime2
  /// `Open` | `ResolvedAsKnowledge` | `ResolvedAsFlow` | `Dismissed`.
  status                      String    @db.VarChar(24)
  resolutionKnowledgeSourceId String?   @db.Char(26)
  resolutionFlowId            String?   @db.Char(26)
  resolvedByStaffUserId       String?   @db.Char(26)
  resolvedAt                  DateTime? @db.DateTime2
  createdAt                   DateTime  @db.DateTime2
  updatedAt                   DateTime  @updatedAt @db.DateTime2

  resolutionKnowledgeSource KnowledgeSource? @relation(fields: [resolutionKnowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  resolutionFlow            Flow?            @relation(fields: [resolutionFlowId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, askCount(sort: Desc)], map: "IX_UnansweredQuestions_status_askCount")
  @@map("UnansweredQuestions")
}

/// The B14 tab 2 audit row "Exported 42 conversation transcripts", as a record.
///
/// `CK_TranscriptExports_redactionApplied CHECK (redactionApplied = 1)` and
/// `TR_TranscriptExports_audit` — which writes the audit entry in the **same
/// transaction**, because a data export that is not audited is the failure mode B14 tab 2
/// exists to prevent — live in `prisma/sql/001_constraints.sql`.
model TranscriptExport {
  id                     String    @id @db.Char(26)
  requestedByStaffUserId String    @db.Char(26)
  filterJson             String    @db.NVarChar(Max)
  /// Named `exportedRowCount`, not `rowCount`: SQL Server rejects a bare
  /// `rowCount` identifier as a syntax error in some statement positions
  /// (verified directly against the live server) — it collides with `SET
  /// ROWCOUNT` parsing even though it is not in the documented reserved-word
  /// list. Discovered running `TR_TranscriptExports_audit` against a real
  /// database; `[rowCount]` would also work, but a name that never needs
  /// bracket-quoting is the more durable fix.
  exportedRowCount       Int
  /// `Csv` | `Json`.
  format                 String    @db.VarChar(8)
  redactionApplied       Boolean
  storageRef             String?   @db.NVarChar(500)
  expiresAt              DateTime  @db.DateTime2
  downloadedAt           DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  @@index([createdAt(sort: Desc)], map: "IX_TranscriptExports_createdAt")
  @@map("TranscriptExports")
}

// -------------------------------------------------------------------------------------
// tenant · 4.16 theming — tokens, skins, branding, preferences
//
// Phase E and ADR-0007. Resolution order is `user preference -> tenant theme -> system
// default`, which is exactly why the first tier is per-user, the second per-tenant, and
// the third platform-global (`platform.TokenSets`, `platform.Skins`).
//
// Isolation here is **inherited, not re-implemented**: these rows live in the tenant's
// own schema, so "a tenant must never see another tenant's branding" holds by ADR-0002
// rather than by a filter someone must remember to write.
// -------------------------------------------------------------------------------------

/// A resolved set of semantic token values for one mode. `kind` is `TenantSkin` or
/// `UserSkin` here; `SystemDefault` rows live in `platform.TokenSets`.
///
/// The payload is JSON and not a `Tokens` table because a token set is read once per
/// request, on the server, and inlined into `<head>` as a `<style>` block — never queried
/// by individual token, never aggregated, never joined. A row-per-token table would turn
/// one read into ~120 rows on the first-paint path for zero query benefit (§4.16).
///
/// In `prisma/sql/001_constraints.sql`: `CK_TokenSets_tokensJson_isJson`;
/// **`CK_TokenSets_noPrimitiveLeak CHECK (tokensJson NOT LIKE '%--shj3-%')`** — a token
/// set may set only *semantic* tokens, per ADR-0007's three-layer contract; and
/// **`CK_TokenSets_contrastGate`** — the contrast gate **blocks, it does not warn**, so
/// an unvalidated token set cannot be persisted at all and a save that skipped the check
/// fails at the database rather than shipping an unreadable government service.
model TokenSet {
  id                  String    @id @db.Char(26)
  name                String    @db.NVarChar(160)
  /// `SystemDefault` | `TenantSkin` | `UserSkin`.
  kind                String    @db.VarChar(16)
  /// `Light` | `Dark`.
  mode                String    @db.VarChar(8)
  schemaVersion       Int       @db.SmallInt
  tokensJson          String    @db.NVarChar(Max)
  parentTokenSetId    String?   @db.Char(26)
  contrastValidatedAt DateTime? @db.DateTime2
  /// The computed foreground/background pairs, so the screen can show which pair failed.
  contrastReportJson  String?   @db.NVarChar(Max)
  deletedAt           DateTime? @db.DateTime2
  createdAt           DateTime  @db.DateTime2
  updatedAt           DateTime  @updatedAt @db.DateTime2

  parent   TokenSet?  @relation("TokenSetLineage", fields: [parentTokenSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children TokenSet[] @relation("TokenSetLineage")
  lightFor Skin[]     @relation("SkinLightTokenSet")
  darkFor  Skin[]     @relation("SkinDarkTokenSet")

  @@index([kind, mode], map: "IX_TokenSets_kind_mode")
  @@map("TokenSets")
}

/// A named preset pairing a light and a dark token set. Exportable and importable as
/// JSON — and an imported skin is **untrusted input** (ADR-0007), so import runs the Zod
/// schema check and the contrast check before the row is written.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_Skins_name ... WHERE deletedAt IS NULL`;
/// **`UQ_Skins_tenantDefault (isTenantDefault) WHERE isTenantDefault = 1`** — one default
/// per tenant; `CK_Skins_modesDiffer CHECK (lightTokenSetId <> darkTokenSetId)`; and
/// `TR_Skins_blockSystemDelete`.
model Skin {
  id                   String    @id @db.Char(26)
  name                 String    @db.NVarChar(160)
  description          String?   @db.NVarChar(1000)
  lightTokenSetId      String    @db.Char(26)
  darkTokenSetId       String    @db.Char(26)
  isSystem             Boolean
  isTenantDefault      Boolean
  /// `Draft` | `Published`.
  status               String    @db.VarChar(12)
  duplicatedFromSkinId String?   @db.Char(26)
  exportSchemaVersion  Int       @db.SmallInt
  createdByStaffUserId String?   @db.Char(26)
  deletedAt            DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  lightTokenSet   TokenSet              @relation("SkinLightTokenSet", fields: [lightTokenSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  darkTokenSet    TokenSet              @relation("SkinDarkTokenSet", fields: [darkTokenSetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicatedFrom  Skin?                 @relation("SkinDuplicate", fields: [duplicatedFromSkinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  duplicates      Skin[]                @relation("SkinDuplicate")
  tenantBrandings TenantBranding[]
  userPreferences UserThemePreference[]

  @@map("Skins")
}

/// Singleton. The tenant tier of ADR-0007's resolution order.
///
/// `CK_TenantBrandings_whiteLabelNeedsLogos CHECK (whiteLabelEnabled = 0 OR
/// (logoLightAssetId IS NOT NULL AND logoDarkAssetId IS NOT NULL))`, `_singleton`,
/// `_defaultMode`, `_defaultDirection` and `_density` live in
/// `prisma/sql/001_constraints.sql`.
///
/// `fontSize` added post-launch (Phase E backend wave, 2026-09-09): §9.3's control
/// matrix marks base font size tenant-settable exactly like mode/density/direction
/// (not admin-only like font *family*, which stays out of scope — no column exists
/// for it here, or for radius/sidebarWidth, because the shipped skins' typography and
/// geometry are otherwise identical and are served from `@shj3/tokens`' static
/// exports rather than round-tripped through a row; see `CK_TenantBrandings_fontSize`
/// in `001_constraints.sql`, which validates it independently of `_defaultMode` rather
/// than folding it into that existing, already-applied CHECK).
model TenantBranding {
  id                   String   @id @db.Char(26)
  singletonKey         Int      @unique(map: "UQ_TenantBrandings_singleton") @default(1) @db.TinyInt
  activeSkinId         String   @db.Char(26)
  appTitle             String   @db.NVarChar(120)
  logoLightAssetId     String?  @db.Char(26)
  logoDarkAssetId      String?  @db.Char(26)
  faviconAssetId       String?  @db.Char(26)
  /// `Light` | `Dark` | `System`.
  defaultMode          String   @db.VarChar(8)
  /// `LTR` | `RTL`, tied to language selection.
  defaultDirection     String   @db.VarChar(3)
  /// `Compact` | `Comfortable`.
  density              String   @db.VarChar(16)
  /// One of `SkinTypography.baseSize`'s four literal rem values (`@shj3/tokens`
  /// `skin.ts`), stored verbatim so it round-trips into `--font-size-base` with no
  /// translation table. NOT NULL with a default: this is a tenant-wide setting, not
  /// an optional per-user override (contrast `UserThemePreference.fontSize`, below).
  fontSize             String   @default("0.875rem") @db.VarChar(10)
  shadowDepth          String   @db.VarChar(8)
  sidebarStyle         String   @db.VarChar(16)
  whiteLabelEnabled    Boolean
  updatedByStaffUserId String   @db.Char(26)
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2

  activeSkin     Skin        @relation(fields: [activeSkinId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logoLightAsset BrandAsset? @relation("TenantBrandingLogoLight", fields: [logoLightAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logoDarkAsset  BrandAsset? @relation("TenantBrandingLogoDark", fields: [logoDarkAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faviconAsset   BrandAsset? @relation("TenantBrandingFavicon", fields: [faviconAssetId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("TenantBrandings")
}

/// Logo, favicon and other brand binaries.
///
/// `CK_BrandAssets_mimeAllowed CHECK (mimeType IN ('image/svg+xml','image/png',
/// 'image/webp','image/x-icon'))` and
/// `CK_BrandAssets_byteSize CHECK (byteSize <= 1048576)` live in
/// `prisma/sql/001_constraints.sql`.
model BrandAsset {
  id                    String   @id @db.Char(26)
  /// `LogoLight` | `LogoDark` | `Favicon` | `OgImage`.
  kind                  String   @db.VarChar(16)
  fileName              String   @db.NVarChar(260)
  mimeType              String   @db.VarChar(120)
  byteSize              Int
  width                 Int?     @db.SmallInt
  height                Int?     @db.SmallInt
  checksum              String   @db.Char(64)
  storageRef            String   @db.NVarChar(500)
  uploadedByStaffUserId String   @db.Char(26)
  createdAt             DateTime @db.DateTime2
  updatedAt             DateTime @updatedAt @db.DateTime2

  logoLightFor TenantBranding[] @relation("TenantBrandingLogoLight")
  logoDarkFor  TenantBranding[] @relation("TenantBrandingLogoDark")
  faviconFor   TenantBranding[] @relation("TenantBrandingFavicon")

  @@unique([checksum, kind], map: "UQ_BrandAssets_checksum_kind")
  @@map("BrandAssets")
}

/// The highest-precedence tier: per staff user, **per tenant**. Per-tenant rather than
/// global like `StaffUsers` for two reasons (§4.16): a user with membership in two
/// tenants may legitimately want a different appearance in each; and `skinId` references
/// a skin that exists *inside a tenant schema*, so a global preference row would need a
/// composite `(tenantId, skinId)` reference into an arbitrary schema — not expressible as
/// a foreign key — or would break the moment the tenant is deprovisioned.
///
/// **Every preference column is nullable, and `NULL` means "defer to the tenant tier".**
/// Copying tenant values into the user row instead would freeze a user's theme against
/// later tenant re-branding.
///
/// `fontSize` and `reducedMotion` added post-launch (Phase E backend wave, 2026-09-09) —
/// §9.3's control matrix marks both user-overridable (`reducedMotion` is the one row with
/// no tenant-branding counterpart at all: a tenant admin cannot force a user into motion
/// that hurts them). `CK_UserThemePreferences_fontSize` in `001_constraints.sql` validates
/// the new column independently of the existing, already-applied `_enums` CHECK rather
/// than widening it — the same pattern `TenantBranding.fontSize` uses.
///
/// **`skinId` deliberately carries no delete-guard trigger**, unlike
/// `TenantBranding.activeSkinId` (`TR_Skins_blockActiveDeletion`): a personal skin being
/// retired should not block cleanup for every other user who never chose it.
/// `resolveTheme()` treats a `skinId` that no longer resolves to a live (non-deleted) skin
/// the same as `NULL` — deferring to the tenant tier — rather than erroring.
model UserThemePreference {
  id            String   @id @db.Char(26)
  /// References `platform.StaffUsers.id`; not FK-enforced (see the header block).
  staffUserId   String   @unique(map: "UQ_UserThemePreferences_staffUserId") @db.Char(26)
  skinId        String?  @db.Char(26)
  mode          String?  @db.VarChar(8)
  density       String?  @db.VarChar(16)
  direction     String?  @db.VarChar(3)
  /// One of `SkinTypography.baseSize`'s four literal rem values, same representation
  /// as `TenantBranding.fontSize`. `NULL` means defer to the tenant tier.
  fontSize      String?  @db.VarChar(10)
  reducedMotion Boolean?
  createdAt     DateTime @db.DateTime2
  updatedAt     DateTime @updatedAt @db.DateTime2

  skin Skin? @relation(fields: [skinId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("UserThemePreferences")
}
