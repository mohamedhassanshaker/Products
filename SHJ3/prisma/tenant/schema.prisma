// -------------------------------------------------------------------------------------
// tenant · 4.10 channels — surfaces, widget, WhatsApp, templates, campaigns, locales
// -------------------------------------------------------------------------------------

/// The four surfaces and their live state (B10 tab 1). Disabling a channel stops **new**
/// conversations only; existing `Conversations` rows are untouched because they reference
/// `channelKey` as a value, not as a live permission.
///
/// `CK_Channels_liveNeedsAgent CHECK (state <> 'Live' OR boundAgentId IS NOT NULL)`,
/// `CK_Channels_disabledPaired` and
/// `CK_Channels_workingHoursPaired CHECK ((availability = 'WorkingHours') =
/// (workingHoursProfileId IS NOT NULL))` live in `prisma/sql/001_constraints.sql`.
model Channel {
  id                    String    @id @db.Char(26)
  /// `WebWidget` | `WhatsApp` | `MobileApp` | `KioskIvr`.
  key                   String    @unique(map: "UQ_Channels_key") @db.VarChar(24)
  displayName           String    @db.NVarChar(200)
  boundAgentId          String?   @db.Char(26)
  /// `Live` | `Disabled` — a reversible state, not a deletion (§1.4).
  state                 String    @db.VarChar(12)
  /// `TwentyFourSeven` | `WorkingHours`.
  availability          String    @db.VarChar(24)
  workingHoursProfileId String?   @db.Char(26)
  enabledAt             DateTime? @db.DateTime2
  disabledAt            DateTime? @db.DateTime2
  createdAt             DateTime  @db.DateTime2
