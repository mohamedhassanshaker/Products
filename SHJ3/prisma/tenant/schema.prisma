// -------------------------------------------------------------------------------------
// tenant · 4.7 knowledge — Graph RAG sources, chunks, retrieval, conflicts
//
// Naming clarification, because two things are called "collection": a **Qdrant
// collection** is per tenant (`sewa_knowledge`); a **`KnowledgeCollection`** is a
// per-tenant *logical grouping of sources* and therefore a payload filter
// (`collection_id`) inside the tenant's single Qdrant collection. Getting this backwards
// would produce a collection per knowledge group per tenant, exactly the proliferation
// ADR-0002 flags as a negative consequence.
// -------------------------------------------------------------------------------------

/// A bindable grouping of sources (B3 step 5, B6 tab 1). A filter, **not** a Qdrant
/// collection.
///
/// `UQ_KnowledgeCollections_slug ... WHERE deletedAt IS NULL` is filtered and lives in
/// `prisma/sql/001_constraints.sql`.
model KnowledgeCollection {
  id                String    @id @db.Char(26)
  name              String    @db.NVarChar(200)
  slug              String    @db.VarChar(96)
  description       String?   @db.NVarChar(1000)
  ownerTenantId     String    @db.Char(26)
  retrievalConfigId String?   @db.Char(26)
  deletedAt         DateTime? @db.DateTime2
  createdAt         DateTime  @db.DateTime2
  updatedAt         DateTime  @updatedAt @db.DateTime2

  retrievalConfig        RetrievalConfig?        @relation("KnowledgeCollectionRetrievalConfig", fields: [retrievalConfigId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scopedRetrievalConfigs RetrievalConfig[]       @relation("RetrievalConfigScopedCollection")
  sources                KnowledgeSource[]
  chunks                 Chunk[]
  agentBindings          AgentKnowledgeBinding[]
  reindexJobs            ReindexJob[]

  @@map("KnowledgeCollections")
}

/// A source of truth to ingest — the rows of B6 tab 1. Soft-deleted via `removedAt`
/// (§1.4), because chunks and citations point at it.
///
/// **`indexedPercent` is a computed persisted column, never typed** (§9.4): it is the
/// honest UI surface of eventual consistency, maintained by `TR_Chunks_recountSource` as
/// `CASE WHEN chunkCount = 0 THEN 0 ELSE (indexedChunkCount * 100) / chunkCount END`.
/// A source at 70% means every chunk's text is durably in SQL Server and citable while
/// 30% are not yet retrievable — a real, legitimate, temporary state. The column is in
/// `prisma/sql/001_constraints.sql` because Prisma cannot declare a computed column, and
/// it is absent from this model precisely so no code can write to it.
///
/// Also there: `UQ_KnowledgeSources_knowledgeCollectionId_name ... WHERE removedAt IS
/// NULL`, the filtered scheduler index `IX_KnowledgeSources_nextScheduledAt ... WHERE
/// schedule <> 'Manual' AND removedAt IS NULL`,
/// `CK_KnowledgeSources_countsCoherent CHECK (indexedChunkCount <= chunkCount)`,
/// `CK_KnowledgeSources_sourceType`, `_schedule` and `_status`.
model KnowledgeSource {
  id                    String    @id @db.Char(26)
  knowledgeCollectionId String    @db.Char(26)
  name                  String    @db.NVarChar(200)
  /// `Document` | `UrlCrawler` | `Database` | `SharePoint` | `ApiFeed`.
  sourceType            String    @db.VarChar(16)
  location              String    @db.NVarChar(1000)
  ownerTenantId         String    @db.Char(26)
  /// `Manual` | `Daily` | `Weekly`.
  schedule              String    @db.VarChar(12)
  /// `Idle` | `Crawling` | `Indexing` | `Failed`.
  status                String    @db.VarChar(16)
  documentCount         Int
  chunkCount            Int
  indexedChunkCount     Int
  /// Set from `IngestionRuns.finishedAt`, never from the click (§9.4).
  lastCrawledAt         DateTime? @db.DateTime2
  nextScheduledAt       DateTime? @db.DateTime2
  lastError             String?   @db.NVarChar(Max)
  credentialSecretRef   String?   @db.NVarChar(200)
  removedAt             DateTime? @db.DateTime2
  createdAt             DateTime  @db.DateTime2
  updatedAt             DateTime  @updatedAt @db.DateTime2

  knowledgeCollection KnowledgeCollection  @relation(fields: [knowledgeCollectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents           SourceDocument[]
  chunks              Chunk[]
  ingestionRuns       IngestionRun[]
  reindexJobs         ReindexJob[]
  reconciliationRuns  ReconciliationRun[]
  citations           GroundingCitation[]
  conflictsAsSideA    SourceConflict[]     @relation("SourceConflictSideASource")
  conflictsAsSideB    SourceConflict[]     @relation("SourceConflictSideBSource")
  feedbackIssues      FeedbackIssue[]
  unansweredResolved  UnansweredQuestion[]

  @@map("KnowledgeSources")
}

/// One fetched artefact from a source, with its content hash. An unchanged hash skips
/// re-chunking and re-embedding entirely, which is why `IX_SourceDocuments_contentHash`
/// exists.
///
/// `UQ_SourceDocuments_source_externalRef_live (knowledgeSourceId, externalRef) WHERE
/// supersededAt IS NULL` is filtered and lives in `prisma/sql/001_constraints.sql`.
model SourceDocument {
  id                     String    @id @db.Char(26)
  knowledgeSourceId      String    @db.Char(26)
  externalRef            String    @db.NVarChar(1000)
  title                  String?   @db.NVarChar(500)
  contentHash            String    @db.Char(64)
  byteSize               BigInt
  mimeType               String    @db.VarChar(120)
  localeCode             String?   @db.VarChar(16)
  storageRef             String    @db.NVarChar(500)
  fetchedAt              DateTime  @db.DateTime2
  supersededByDocumentId String?   @db.Char(26)
  supersededAt           DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  knowledgeSource KnowledgeSource  @relation(fields: [knowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersededBy    SourceDocument?  @relation("SourceDocumentSupersession", fields: [supersededByDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supersedes      SourceDocument[] @relation("SourceDocumentSupersession")
  chunks          Chunk[]

  @@index([contentHash], map: "IX_SourceDocuments_contentHash")
  @@map("SourceDocuments")
}

/// **The `chunk_id` anchor (§5).** Authoritative text lives here and only here: Qdrant
/// holds the embedding and no renderable content, Neo4j holds a reference node carrying
/// an id only. A citation is resolved by reading this row, which is what makes a stale
/// vector payload able to produce a wrong ranking but never a fabricated citation.
///
/// In `prisma/sql/001_constraints.sql`:
/// `IX_Chunks_knowledgeSourceId_vectorState` and `IX_Chunks_knowledgeCollectionId_vectorState`
/// (they drive `indexedPercent` and the reconciliation scan);
/// `CK_Chunks_embeddedPaired CHECK ((vectorState = 'Indexed') = (embeddedAt IS NOT NULL
/// AND embeddingModel IS NOT NULL))` — so an `Indexed` chunk always knows *which model*
/// produced its vector, which is what makes the model-change re-index of §7 able to
/// identify exactly which points are stale;
/// `CK_Chunks_offsets CHECK (charEnd > charStart)`;
/// `CK_Chunks_dimension CHECK (embeddingDimension IS NULL OR embeddingDimension = 3072)`;
/// `CK_Chunks_vectorState` and `_graphState`.
model Chunk {
  id                    String    @id @db.Char(26)
  sourceDocumentId      String    @db.Char(26)
  knowledgeSourceId     String    @db.Char(26)
  knowledgeCollectionId String    @db.Char(26)
  ordinal               Int
  /// The authoritative text. Never copied into Qdrant or Neo4j (ADR-0003).
  text                  String    @db.NVarChar(Max)
  tokenCount            Int       @db.SmallInt
  charStart             Int
  charEnd               Int
  contentHash           String    @db.Char(64)
  sectionPath           String?   @db.NVarChar(500)
  pageNumber            Int?
  localeCode            String    @db.VarChar(16)
  embeddingModel        String?   @db.VarChar(64)
  embeddingDimension    Int?
  embeddedAt            DateTime? @db.DateTime2
  /// `Pending` | `Indexed` | `Stale` | `Failed` (§5.2).
  vectorState           String    @db.VarChar(12)
  /// `Pending` | `Indexed` | `Stale` | `Failed` (§5.2).
  graphState            String    @db.VarChar(12)
  erasedAt              DateTime? @db.DateTime2
  createdAt             DateTime  @db.DateTime2
  updatedAt             DateTime  @updatedAt @db.DateTime2

  sourceDocument      SourceDocument      @relation(fields: [sourceDocumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  knowledgeSource     KnowledgeSource     @relation(fields: [knowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  knowledgeCollection KnowledgeCollection @relation(fields: [knowledgeCollectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  citations           GroundingCitation[]
  graphNodesFirstSeen GraphNodeRecord[]
  graphEdgeEvidence   GraphEdgeRecord[]
  conflictsAsSideA    SourceConflict[]    @relation("SourceConflictSideAChunk")
  conflictsAsSideB    SourceConflict[]    @relation("SourceConflictSideBChunk")

  @@unique([sourceDocumentId, ordinal], map: "UQ_Chunks_sourceDocumentId_ordinal")
  @@map("Chunks")
}

/// One crawl/ingest pass over one source. **AI-writable — grant group 3** (§3.6).
///
/// `UQ_IngestionRuns_activePerSource (knowledgeSourceId) WHERE state IN
/// ('Queued','Running')` — one ingest per source at a time; the Redis lock (§8) is the
/// fast path, this filtered index is the correctness backstop. In
/// `prisma/sql/001_constraints.sql` along with `CK_IngestionRuns_trigger` and `_state`.
model IngestionRun {
  id                     String    @id @db.Char(26)
  knowledgeSourceId      String    @db.Char(26)
  /// `Manual` | `Schedule` | `ReindexAll` | `Reconciliation`.
  trigger                String    @db.VarChar(16)
  state                  String    @db.VarChar(12)
  documentsSeen          Int
  documentsAdded         Int
  documentsUpdated       Int
  documentsRemoved       Int
  chunksWritten          Int
  chunksSkippedUnchanged Int
  startedAt              DateTime  @db.DateTime2
  finishedAt             DateTime? @db.DateTime2
  error                  String?   @db.NVarChar(Max)
  ranByStaffUserId       String?   @db.Char(26)
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  knowledgeSource KnowledgeSource @relation(fields: [knowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([knowledgeSourceId, startedAt(sort: Desc)], map: "IX_IngestionRuns_knowledgeSourceId_startedAt")
  @@map("IngestionRuns")
}

/// The B6 tab 3 job history. **AI-writable — grant group 3** (§3.6). Re-index is not a
/// special-purpose recovery script; it is the product feature that ADR-0003's "re-index
/// repairs the index" relies on, which is why reconciliation escalates into it (§9.3).
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_ReindexJobs_activeTenantScope (scope) WHERE scope = 'Tenant' AND state IN
/// ('Queued','Running')`, `CK_ReindexJobs_scopePaired`,
/// `CK_ReindexJobs_progress CHECK (progressPercent BETWEEN 0 AND 100)`,
/// `CK_ReindexJobs_reason` and `_state`.
model ReindexJob {
  id                    String    @id @db.Char(26)
  /// `Tenant` | `Collection` | `Source` | `Document`.
  scope                 String    @db.VarChar(16)
  knowledgeSourceId     String?   @db.Char(26)
  knowledgeCollectionId String?   @db.Char(26)
  /// `Manual` | `EmbeddingModelChange` | `RetrievalConfigChange` | `Reconciliation` |
  /// `Restore` | `GraphMerge`.
  reason                String    @db.VarChar(32)
  state                 String    @db.VarChar(12)
  progressPercent       Int       @db.TinyInt
  chunksTotal           Int?
  chunksProcessed       Int
  targetEmbeddingModel  String?   @db.VarChar(64)
  startedAt             DateTime? @db.DateTime2
  finishedAt            DateTime? @db.DateTime2
  error                 String?   @db.NVarChar(Max)
  ranByStaffUserId      String?   @db.Char(26)
  createdAt             DateTime  @db.DateTime2
  updatedAt             DateTime  @updatedAt @db.DateTime2

  knowledgeSource     KnowledgeSource?     @relation(fields: [knowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  knowledgeCollection KnowledgeCollection? @relation(fields: [knowledgeCollectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reconciliationRuns  ReconciliationRun[]
  graphMergeDecisions GraphMergeDecision[]

  @@index([state, createdAt(sort: Desc)], map: "IX_ReindexJobs_state_createdAt")
  @@map("ReindexJobs")
}

/// B6 tab 3 in full, plus the default conflict policy.
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_RetrievalConfigs_tenantScope (scope) WHERE scope = 'Tenant'`;
/// `UQ_RetrievalConfigs_knowledgeCollectionId ... WHERE knowledgeCollectionId IS NOT NULL`;
/// **`CK_RetrievalConfigs_weightsSumToOne CHECK (graphWeight + vectorWeight = 1.000)`** —
/// the B6 slider is one degree of freedom, so two independently-editable weights that
/// fail to sum to 1 must be unrepresentable;
/// `CK_RetrievalConfigs_overlapLessThanSize`; `CK_RetrievalConfigs_rerankerPaired`;
/// `CK_RetrievalConfigs_dimensionMatchesModel`;
/// `CK_RetrievalConfigs_topK CHECK (topK BETWEEN 1 AND 50)`; and
/// `TR_RetrievalConfigs_modelChangeQueuesReindex` — changing `embeddingModel` or
/// `embeddingDimension` enqueues a `ReindexJob` with `reason = 'EmbeddingModelChange'`
/// (§7.5), because a collection holding vectors from two models silently degrades every
/// similarity comparison in it.
model RetrievalConfig {
  id                     String   @id @db.Char(26)
  /// `Tenant` | `Collection`.
  scope                  String   @db.VarChar(12)
  knowledgeCollectionId  String?  @db.Char(26)
  chunkSizeTokens        Int      @default(512) @db.SmallInt
  chunkOverlapTokens     Int      @default(64) @db.SmallInt
  embeddingModel         String   @default("text-embedding-3-large") @db.VarChar(64)
  embeddingDimension     Int      @default(3072)
  graphWeight            Decimal  @default(0.600) @db.Decimal(4, 3)
  vectorWeight           Decimal  @default(0.400) @db.Decimal(4, 3)
  topK                   Int      @default(8) @db.SmallInt
  rerankerEnabled        Boolean  @default(true)
  rerankerModel          String?  @default("rerank-v3.5") @db.VarChar(64)
  rerankCandidateCount   Int      @default(40) @db.SmallInt
  minGroundingConfidence Decimal  @default(0.6000) @db.Decimal(5, 4)
  /// `PreferMostRecentlyUpdated` | `PreferOwningEntitySource` | `AlwaysAskAdmin`.
  defaultConflictPolicy  String   @db.VarChar(32)
  maxGraphHops           Int      @default(3) @db.TinyInt
  createdAt              DateTime @db.DateTime2
  updatedAt              DateTime @updatedAt @db.DateTime2

  knowledgeCollection  KnowledgeCollection?  @relation("RetrievalConfigScopedCollection", fields: [knowledgeCollectionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  appliedToCollections KnowledgeCollection[] @relation("KnowledgeCollectionRetrievalConfig")

  @@map("RetrievalConfigs")
}

/// B6 tab 3's playground, kept so a tuning decision is reviewable. Retained 90 days then
/// swept (§14 ASSUMPTION 10).
///
/// `CK_RetrievalPlaygroundRuns_configSnapshotJson_isJson` and `_resultsJson_isJson` live
/// in `prisma/sql/001_constraints.sql`.
model RetrievalPlaygroundRun {
  id                 String   @id @db.Char(26)
  query              String   @db.NVarChar(2000)
  configSnapshotJson String   @db.NVarChar(Max)
  resultsJson        String   @db.NVarChar(Max)
  matchedSubgraph    String?  @db.NVarChar(2000)
  topScore           Decimal? @db.Decimal(6, 5)
  ranByStaffUserId   String   @db.Char(26)
  durationMs         Int
  createdAt          DateTime @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  @@index([createdAt(sort: Desc)], map: "IX_RetrievalPlaygroundRuns_createdAt")
  @@map("RetrievalPlaygroundRuns")
}

/// Two indexed sources disagreeing about one graph entity (B6 tab 4).
///
/// `policyAtDetection` is stored **separately from the policy in force at resolution**,
/// which is what lets an admin later see that an automatic resolution was made under a
/// policy since changed — B6 tab 4's awkward second conflict, where "the more recent
/// source holds the less authoritative value". Without it, a badly resolved conflict is
/// indistinguishable from a correctly resolved one.
///
/// `groundingPenalty` is subtracted from the hybrid score of any citation whose chunk is
/// on either side of an **open** conflict, which is the mechanism linking B6 tab 4 to
/// B12's refusal threshold. It is a column rather than a constant so the penalty is
/// tunable without a deploy.
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_SourceConflicts_open (graphEntityKey, topic) WHERE status = 'Open'` — one open
/// conflict per entity and topic, so repeated detection updates rather than duplicates;
/// `CK_SourceConflicts_differentSources`; `CK_SourceConflicts_resolvedHasSide`;
/// `CK_SourceConflicts_penalty CHECK (groundingPenalty BETWEEN 0 AND 1)`;
/// `CK_SourceConflicts_status` and `_authoritativeSide`.
model SourceConflict {
  id                     String    @id @db.Char(26)
  topic                  String    @db.NVarChar(300)
  graphNodeRecordId      String?   @db.Char(26)
  graphEntityKey         String    @db.VarChar(200)
  sideAChunkId           String    @db.Char(26)
  sideAKnowledgeSourceId String    @db.Char(26)
  sideAValue             String    @db.NVarChar(500)
  sideASourceUpdatedAt   DateTime  @db.DateTime2
  sideBChunkId           String    @db.Char(26)
  sideBKnowledgeSourceId String    @db.Char(26)
  sideBValue             String    @db.NVarChar(500)
  sideBSourceUpdatedAt   DateTime  @db.DateTime2
  detectedAt             DateTime  @db.DateTime2
  detectionMethod        String    @db.VarChar(32)
  /// `Open` | `Resolved` | `Ignored`.
  status                 String    @db.VarChar(12)
  policyAtDetection      String    @db.VarChar(32)
  /// `A` | `B`.
  authoritativeSide      String?   @db.Char(1)
  resolvedByStaffUserId  String?   @db.Char(26)
  resolvedAt             DateTime? @db.DateTime2
  groundingPenalty       Decimal   @db.Decimal(4, 3)
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  graphNodeRecord      GraphNodeRecord? @relation(fields: [graphNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sideAChunk           Chunk            @relation("SourceConflictSideAChunk", fields: [sideAChunkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sideBChunk           Chunk            @relation("SourceConflictSideBChunk", fields: [sideBChunkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sideAKnowledgeSource KnowledgeSource  @relation("SourceConflictSideASource", fields: [sideAKnowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sideBKnowledgeSource KnowledgeSource  @relation("SourceConflictSideBSource", fields: [sideBKnowledgeSourceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, detectedAt], map: "IX_SourceConflicts_status_detectedAt")
  @@map("SourceConflicts")
}

/// The **authoritative** record of every graph entity, so Neo4j stays rebuildable
/// (§4.7). This looks like graph data in the relational store, which the store map
/// forbids — the distinction is between a *traversal structure* (Neo4j's exclusive job)
/// and an *authored decision record*. Without this table, "re-index all sources now"
/// would regenerate the extracted nodes and **silently discard every human decision**,
/// making a recovery button into a data-loss button.
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_GraphNodeRecords_label_canonicalKey ... WHERE deletedAt IS NULL`;
/// the filtered `IX_GraphNodeRecords_mergedIntoNodeRecordId ... WHERE
/// mergedIntoNodeRecordId IS NOT NULL`; `CK_GraphNodeRecords_label`;
/// `CK_GraphNodeRecords_authoredHasActor CHECK (origin <> 'Authored' OR
/// authoredByStaffUserId IS NOT NULL)`;
/// `CK_GraphNodeRecords_noSelfMerge CHECK (mergedIntoNodeRecordId <> id)`.
model GraphNodeRecord {
  id                     String    @id @db.Char(26)
  /// `Service` | `Provider` | `Fee` | `Document` | `Channel`.
  label                  String    @db.VarChar(24)
  canonicalKey           String    @db.VarChar(200)
  canonicalName          String    @db.NVarChar(300)
  aliasesJson            String?   @db.NVarChar(Max)
  propertiesJson         String?   @db.NVarChar(Max)
  /// `Extracted` | `Authored` — B6 tab 2's **+ Add node** produces `Authored`.
  origin                 String    @db.VarChar(16)
  authoredByStaffUserId  String?   @db.Char(26)
  firstSeenChunkId       String?   @db.Char(26)
  mergedIntoNodeRecordId String?   @db.Char(26)
  mergedAt               DateTime? @db.DateTime2
  deletedAt              DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  firstSeenChunk  Chunk?                    @relation(fields: [firstSeenChunkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mergedInto      GraphNodeRecord?          @relation("GraphNodeRecordMerge", fields: [mergedIntoNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  absorbed        GraphNodeRecord[]         @relation("GraphNodeRecordMerge")
  edgesFrom       GraphEdgeRecord[]         @relation("GraphEdgeRecordFrom")
  edgesTo         GraphEdgeRecord[]         @relation("GraphEdgeRecordTo")
  duplicateLeft   GraphDuplicateCandidate[] @relation("GraphDuplicateCandidateLeft")
  duplicateRight  GraphDuplicateCandidate[] @relation("GraphDuplicateCandidateRight")
  mergeSurvivorOf GraphMergeDecision[]      @relation("GraphMergeDecisionSurvivor")
  mergeAbsorbedOf GraphMergeDecision[]      @relation("GraphMergeDecisionAbsorbed")
  sourceConflicts SourceConflict[]

  @@map("GraphNodeRecords")
}

/// The authoritative edges. Same rebuildability argument as `GraphNodeRecords`: this
/// stores **no adjacency query capability and is never traversed** — it is a decision
/// ledger that happens to be shaped like edges.
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_GraphEdgeRecords_triple (fromNodeRecordId, toNodeRecordId, relationshipType)
/// WHERE deletedAt IS NULL`;
/// `CK_GraphEdgeRecords_noSelfEdge CHECK (fromNodeRecordId <> toNodeRecordId)`;
/// `TR_GraphEdgeRecords_typeMatchesLabels`, which enforces the permitted label pairs of
/// §6.2 — every relationship stays within one tenant, so no type has a cross-tenant
/// form.
model GraphEdgeRecord {
  id               String    @id @db.Char(26)
  fromNodeRecordId String    @db.Char(26)
  toNodeRecordId   String    @db.Char(26)
  /// `PROVIDED_BY` | `HAS_FEE` | `DOCUMENTED_BY` | `PAYABLE_VIA` | `AVAILABLE_ON` |
  /// `MENTIONS` | `FROM_DOCUMENT` | `MERGED_INTO` | `SAME_AS`.
  relationshipType String    @db.VarChar(32)
  propertiesJson   String?   @db.NVarChar(Max)
  /// `Extracted` | `Authored`.
  origin           String    @db.VarChar(16)
  evidenceChunkId  String?   @db.Char(26)
  confidence       Decimal?  @db.Decimal(4, 3)
  deletedAt        DateTime? @db.DateTime2
  createdAt        DateTime  @db.DateTime2
  updatedAt        DateTime  @updatedAt @db.DateTime2

  fromNode      GraphNodeRecord @relation("GraphEdgeRecordFrom", fields: [fromNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toNode        GraphNodeRecord @relation("GraphEdgeRecordTo", fields: [toNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evidenceChunk Chunk?          @relation(fields: [evidenceChunkId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fromNodeRecordId, relationshipType], map: "IX_GraphEdgeRecords_from_type")
  @@map("GraphEdgeRecords")
}

/// Detected duplicate pairs awaiting **Merge** / **Ignore** (B6 tab 2).
///
/// `UQ_GraphDuplicateCandidates_pair` is unique on the **ordered** pair — two computed
/// persisted columns holding `LEAST`/`GREATEST` of the two node ids — so
/// `SEWA <-> SEWA A&W` and its mirror are one row rather than two. Both the computed
/// columns and the index are in `prisma/sql/001_constraints.sql`, because Prisma can
/// declare neither; they are absent from this model so no code can write to them.
///
/// Also there: `CK_GraphDuplicateCandidates_differentNodes`,
/// `CK_GraphDuplicateCandidates_similarity CHECK (similarity BETWEEN 0 AND 1)`,
/// `_detectionMethod` and `_state`.
model GraphDuplicateCandidate {
  id                String   @id @db.Char(26)
  leftNodeRecordId  String   @db.Char(26)
  rightNodeRecordId String   @db.Char(26)
  similarity        Decimal  @db.Decimal(4, 3)
  /// `NormalizedName` | `AliasOverlap` | `FullTextSimilarity` | `Manual`.
  detectionMethod   String   @db.VarChar(32)
  /// `Open` | `Merged` | `Ignored`.
  state             String   @db.VarChar(12)
  detectedAt        DateTime @db.DateTime2
  createdAt         DateTime @db.DateTime2
  updatedAt         DateTime @updatedAt @db.DateTime2

  leftNode  GraphNodeRecord      @relation("GraphDuplicateCandidateLeft", fields: [leftNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rightNode GraphNodeRecord      @relation("GraphDuplicateCandidateRight", fields: [rightNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  decisions GraphMergeDecision[]

  @@index([state, similarity(sort: Desc)], map: "IX_GraphDuplicateCandidates_state_similarity")
  @@map("GraphDuplicateCandidates")
}

/// The durable, auditable outcome of a merge or ignore (B6 tab 2). Part of the rebuild
/// path — `sources -> extraction -> apply GraphMergeDecisions -> apply Authored nodes
/// and edges -> Neo4j` — so a re-index preserves the merged
/// `SEWA <-> Sharjah Electricity & Water Authority` and the ignored `du <-> du Telecom`.
///
/// `UQ_GraphMergeDecisions_candidate (graphDuplicateCandidateId) WHERE revertedAt IS
/// NULL` and
/// `CK_GraphMergeDecisions_mergePaired CHECK ((decision = 'Merge') =
/// (survivingNodeRecordId IS NOT NULL AND absorbedNodeRecordId IS NOT NULL))` live in
/// `prisma/sql/001_constraints.sql`.
model GraphMergeDecision {
  id                        String    @id @db.Char(26)
  graphDuplicateCandidateId String    @db.Char(26)
  /// `Merge` | `Ignore`.
  decision                  String    @db.VarChar(8)
  survivingNodeRecordId     String?   @db.Char(26)
  absorbedNodeRecordId      String?   @db.Char(26)
  aliasesAddedJson          String?   @db.NVarChar(Max)
  edgesRewiredCount         Int
  decidedByStaffUserId      String    @db.Char(26)
  decidedAt                 DateTime  @db.DateTime2
  reindexJobId              String?   @db.Char(26)
  revertedAt                DateTime? @db.DateTime2
  revertedByStaffUserId     String?   @db.Char(26)
  createdAt                 DateTime  @db.DateTime2
  updatedAt                 DateTime  @updatedAt @db.DateTime2

  candidate     GraphDuplicateCandidate @relation(fields: [graphDuplicateCandidateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  survivingNode GraphNodeRecord?        @relation("GraphMergeDecisionSurvivor", fields: [survivingNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  absorbedNode  GraphNodeRecord?        @relation("GraphMergeDecisionAbsorbed", fields: [absorbedNodeRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reindexJob    ReindexJob?             @relation(fields: [reindexJobId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([decidedAt(sort: Desc)], map: "IX_GraphMergeDecisions_decidedAt")
  @@map("GraphMergeDecisions")
}

// -------------------------------------------------------------------------------------
// tenant · 4.8 flows — definitions, nodes, edges, the free-text escape
//
// Live flow state is NOT here: the current node, filled slots and preserved escape
// context live in Redis (§8). Only the definition is relational. A flow run is not a
// record; a conversation is.
// -------------------------------------------------------------------------------------

/// The flow registry row (B7, B3 step 6).
///
/// `UQ_Flows_slug ... WHERE deletedAt IS NULL` and
/// `CK_Flows_publishedHasVersion CHECK (status <> 'Published' OR currentVersionId IS NOT
/// NULL)` live in `prisma/sql/001_constraints.sql`.
model Flow {
  id                   String    @id @db.Char(26)
  name                 String    @db.NVarChar(200)
  slug                 String    @db.VarChar(120)
  description          String?   @db.NVarChar(1000)
  ownerTenantId        String    @db.Char(26)
  /// `Draft` | `Published` | `Archived`.
  status               String    @db.VarChar(16)
  currentVersionId     String?   @db.Char(26)
  createdByStaffUserId String    @db.Char(26)
  deletedAt            DateTime? @db.DateTime2
  createdAt            DateTime  @db.DateTime2
  updatedAt            DateTime  @updatedAt @db.DateTime2

  versions           FlowVersion[]        @relation("FlowVersionOfFlow")
  currentVersion     FlowVersion?         @relation("FlowCurrentVersion", fields: [currentVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  agentBindings      AgentFlowBinding[]
  feedbackIssues     FeedbackIssue[]
  unansweredResolved UnansweredQuestion[]

  @@map("Flows")
}

/// An immutable-once-published canvas. Carries the escape guarantee.
///
/// **`CK_FlowVersions_publishedHasEscape CHECK (status <> 'Published' OR
/// (freeTextEscapeEnabled = 1 AND escapeNodeId IS NOT NULL))`** is B7's purpose made
/// unrepresentable-to-violate (requirement R3): a guarantee enforced by UI validation is
/// a guarantee that survives until someone writes a flow through an API or a seed script.
/// A published flow version without an escape node is a constraint violation, so the
/// guarantee holds for every write path including the migration seeds.
///
/// In `prisma/sql/001_constraints.sql` alongside
/// `UQ_FlowVersions_flowId_current (flowId) WHERE isCurrent = 1`,
/// `CK_FlowVersions_publishedHasEntry` and `TR_FlowVersions_publishedImmutable`.
model FlowVersion {
  id                     String    @id @db.Char(26)
  flowId                 String    @db.Char(26)
  major                  Int       @db.SmallInt
  minor                  Int       @db.SmallInt
  status                 String    @db.VarChar(16)
  isCurrent              Boolean
  entryNodeId            String?   @db.Char(26)
  /// Default on. A2 step 4's rule: the escape "is available at every node, and context
  /// is preserved rather than discarded".
  freeTextEscapeEnabled  Boolean   @default(true)
  escapeNodeId           String?   @db.Char(26)
  changeSummary          String?   @db.NVarChar(1000)
  createdByStaffUserId   String    @db.Char(26)
  publishedAt            DateTime? @db.DateTime2
  /// The real, attributed actor of this version's publish, mirroring `AgentVersion.
  /// publishedByStaffUserId` — a plain, unconstrained `Char(26)` (no `@relation`) for the
  /// identical reason that column is: `StaffUser` lives in the platform schema, and this
  /// project's "no multiSchema" design (ADR-0011) means a cross-schema FK cannot be
  /// declared in Prisma at all, only validated at the application layer.
  publishedByStaffUserId String?   @db.Char(26)
  deletedAt              DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  flow            Flow               @relation("FlowVersionOfFlow", fields: [flowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentForFlows Flow[]             @relation("FlowCurrentVersion")
  entryNode       FlowNode?          @relation("FlowVersionEntryNode", fields: [entryNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escapeNode      FlowNode?          @relation("FlowVersionEscapeNode", fields: [escapeNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nodes           FlowNode[]         @relation("FlowNodeOfVersion")
  edges           FlowEdge[]
  agentBindings   AgentFlowBinding[]

  @@unique([flowId, major, minor], map: "UQ_FlowVersions_flowId_major_minor")
  @@map("FlowVersions")
}

/// One canvas node. **Typed columns per node kind, not a JSON blob**, so the per-kind
/// completeness rules below are database constraints rather than UI validation.
/// Hard-deleted (§1.4).
///
/// **`CK_FlowNodes_toolCallFields CHECK (type <> 'ToolCall' OR (toolBindingId IS NOT NULL
/// AND retryCount IS NOT NULL AND onFailureNodeId IS NOT NULL))`** encodes B7's retry
/// contract: a tool-call node with no failure target is a node whose failure path is
/// undefined, and that undefined path is precisely what B7's rule connects to B8 ("tool
/// call failed twice -> escalation reason on the ticket"). Requiring the failure target
/// at insert means the flow-to-queue agreement cannot be broken by an incomplete node.
///
/// `handoverReason` draws on the **same closed set** as `EscalationTickets.reason`
/// (`ToolFailure` | `UserRequest` | `LowConfidence`), which is how B7's rule that "the
/// flow definition and the operational queue agree" is maintained. `UserRequest` is the
/// third value no flow node produces, because it comes from the citizen.
///
/// All of `CK_FlowNodes_type`, `_messageFields`, `_questionFields`, `_toolCallFields`,
/// `_handoverFields`, `_conditionFields` and
/// `_retryBounded CHECK (retryCount IS NULL OR retryCount BETWEEN 0 AND 3)` live in
/// `prisma/sql/001_constraints.sql`.
model FlowNode {
  id                  String   @id @db.Char(26)
  flowVersionId       String   @db.Char(26)
  key                 String   @db.VarChar(64)
  /// `Message` | `Question` | `ToolCall` | `Handover` | `Condition`.
  type                String   @db.VarChar(16)
  title               String   @db.NVarChar(200)
  canvasX             Int
  canvasY             Int
  messageText         String?  @db.NVarChar(Max)
  quickActionSetKey   String?  @db.VarChar(64)
  slotName            String?  @db.VarChar(64)
  /// `Static` | `GraphEntityLabel` | `ToolResult`.
  optionSourceKind    String?  @db.VarChar(24)
  optionSourceRef     String?  @db.NVarChar(200)
  staticOptionsJson   String?  @db.NVarChar(Max)
  toolBindingId       String?  @db.Char(26)
  retryCount          Int?     @db.TinyInt
  retryOnTimeout      Boolean?
  timeoutMs           Int?
  onFailureNodeId     String?  @db.Char(26)
  /// `ToolFailure` | `LowConfidence` — two of the three `EscalationTickets.reason` values.
  handoverReason      String?  @db.VarChar(24)
  confidenceThreshold Decimal? @db.Decimal(5, 4)
  conditionExpression String?  @db.NVarChar(1000)
  requiredAssurance   String?  @db.VarChar(32)
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  flowVersion       FlowVersion        @relation("FlowNodeOfVersion", fields: [flowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  toolBinding       ToolBinding?       @relation(fields: [toolBindingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  onFailureNode     FlowNode?          @relation("FlowNodeFailurePath", fields: [onFailureNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  failurePathFor    FlowNode[]         @relation("FlowNodeFailurePath")
  entryForVersions  FlowVersion[]      @relation("FlowVersionEntryNode")
  escapeForVersions FlowVersion[]      @relation("FlowVersionEscapeNode")
  edgesFrom         FlowEdge[]         @relation("FlowEdgeFrom")
  edgesTo           FlowEdge[]         @relation("FlowEdgeTo")
  escalationTickets EscalationTicket[]

  @@unique([flowVersionId, key], map: "UQ_FlowNodes_flowVersionId_key")
  @@map("FlowNodes")
}

/// A connection between two nodes, with branch ordering. Hard-deleted (§1.4).
///
/// `UQ_FlowEdges_from_ordinal (flowVersionId, fromNodeId, ordinal)` makes branch
/// evaluation order deterministic. In `prisma/sql/001_constraints.sql`:
/// `UQ_FlowEdges_defaultBranch (flowVersionId, fromNodeId) WHERE isDefaultBranch = 1`,
/// `CK_FlowEdges_noSelfLoop CHECK (fromNodeId <> toNodeId)`, and
/// `TR_FlowEdges_sameVersion` — both endpoints must belong to `flowVersionId`, so a
/// canvas cannot reference another flow's node.
model FlowEdge {
  id                  String   @id @db.Char(26)
  flowVersionId       String   @db.Char(26)
  fromNodeId          String   @db.Char(26)
  toNodeId            String   @db.Char(26)
  label               String?  @db.NVarChar(120)
  ordinal             Int      @db.SmallInt
  conditionExpression String?  @db.NVarChar(1000)
  isDefaultBranch     Boolean
  createdAt           DateTime @db.DateTime2
  updatedAt           DateTime @updatedAt @db.DateTime2

  flowVersion FlowVersion @relation(fields: [flowVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fromNode    FlowNode    @relation("FlowEdgeFrom", fields: [fromNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toNode      FlowNode    @relation("FlowEdgeTo", fields: [toNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([flowVersionId, fromNodeId, ordinal], map: "UQ_FlowEdges_from_ordinal")
  @@map("FlowEdges")
}

/// Singleton (§4.8). The Flow Designer's "AI sidebar" (`propose_flow_edit.py`, `apps/ai`)
/// used to resolve its model ONLY from `SHJ3_FLOW_EDIT_MODEL`/`_FALLBACK_MODEL_ENV_VAR`,
/// which meant changing it required an env edit plus a container recreate. This is the
/// tenant-wide override an "AI settings" backoffice screen lets an Agent Designer
/// (`agents:manage`) change without touching either — `primaryModel`/`fallbackModel` are
/// free text with no allowlist, matching `AgentVersion.primaryModel`/`fallbackModel`'s own
/// convention exactly (no model catalogue exists anywhere in this codebase to validate
/// against). `ensureTenantConfig` seeds this row on first use with the SAME defaults the
/// env-var path already had (`anthropic/claude-sonnet-5`, no fallback), so a tenant that
/// never opens the screen sees no behavior change.
///
/// In `prisma/sql/001_constraints.sql`: `UQ_FlowAssistantConfigs_singleton`,
/// `CK_FlowAssistantConfigs_singleton CHECK (singletonKey = 1)`.
model FlowAssistantConfig {
  id                   String   @id @db.Char(26)
  singletonKey         Int      @unique(map: "UQ_FlowAssistantConfigs_singleton") @default(1) @db.TinyInt
  primaryModel         String   @db.VarChar(120)
  fallbackModel        String?  @db.VarChar(120)
  /// Unconstrained `StaffUser` reference — `StaffUser` lives in the platform schema and
  /// this project's no-multiSchema design (ADR-0011) means a cross-schema FK cannot be
  /// declared here, only validated at the application layer (`AgentVersion.
  /// publishedByStaffUserId`'s own precedent).
  updatedByStaffUserId String?  @db.Char(26)
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2

  @@map("FlowAssistantConfigs")
}

// -------------------------------------------------------------------------------------
// tenant · 4.9 handover — escalation queue, presence, routing rules
// -------------------------------------------------------------------------------------

/// An escalated conversation with its full transferred context (B8, A3, B7).
/// `contextSnapshotJson` plus `pendingSlotName` are what make A3's "the pending slot
/// transfers" true across process loss — the ticket is raised by `shj3-web` through its
/// internal API precisely because `handover` is a web module and the AI service cannot
/// write here (§3.6).
///
/// In `prisma/sql/001_constraints.sql`:
/// `UQ_EscalationTickets_openPerConversation (conversationId) WHERE status IN
/// ('Queued','Assigned','Active')` — one open ticket per conversation;
/// the filtered `IX_EscalationTickets_assignedStaffUserId ... WHERE status IN
/// ('Assigned','Active')`;
/// `CK_EscalationTickets_assignedPaired CHECK ((status IN ('Assigned','Active')) =
/// (assignedStaffUserId IS NOT NULL))`;
/// `CK_EscalationTickets_contextSnapshotJson_isJson`; `_reason`, `_status`, `_priority`
/// and `_topicKey`.
model EscalationTicket {
  id                     String    @id @db.Char(26)
  conversationId         String    @db.Char(26)
  topic                  String    @db.NVarChar(200)
  /// `Billing` | `Customs` | `Library` | `General`.
  topicKey               String    @db.VarChar(32)
  channelKey             String    @db.VarChar(24)
  /// `Normal` | `High`.
  priority               String    @db.VarChar(8)
  /// `ToolFailure` | `UserRequest` | `LowConfidence` — the same closed set as
  /// `FlowNodes.handoverReason`, which is how the flow definition and the operational
  /// queue are kept from drifting apart (B7's rule).
  reason                 String    @db.VarChar(16)
  reasonDetail           String    @db.NVarChar(500)
  originFlowNodeId       String?   @db.Char(26)
  customerContextSummary String?   @db.NVarChar(1000)
  verificationState      String    @db.VarChar(32)
  citizenIdentityId      String?   @db.Char(26)
  pendingSlotName        String?   @db.VarChar(64)
  contextSnapshotJson    String    @db.NVarChar(Max)
  /// `Queued` | `Assigned` | `Active` | `Resolved` | `Abandoned`.
  status                 String    @db.VarChar(12)
  routedByRoutingRuleId  String?   @db.Char(26)
  routeTargetTeamId      String?   @db.Char(26)
  wasRequeued            Boolean
  assignedStaffUserId    String?   @db.Char(26)
  queuedAt               DateTime  @db.DateTime2
  assignedAt             DateTime? @db.DateTime2
  firstResponseAt        DateTime? @db.DateTime2
  resolvedAt             DateTime? @db.DateTime2
  createdAt              DateTime  @db.DateTime2
  updatedAt              DateTime  @updatedAt @db.DateTime2

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  originFlowNode  FlowNode?        @relation(fields: [originFlowNodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  citizenIdentity CitizenIdentity? @relation(fields: [citizenIdentityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routedByRule    RoutingRule?     @relation(fields: [routedByRoutingRuleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routeTargetTeam Team?            @relation(fields: [routeTargetTeamId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, priority, queuedAt], map: "IX_EscalationTickets_status_priority_queuedAt")
  @@map("EscalationTickets")
}

/// Live-agent availability. The sub-90-second heartbeat lives in Redis (§8); this row is
/// the **settled** value, so presence survives a Redis flush without a live agent
/// silently disappearing from the queue.
///
/// `CK_AgentPresence_capacity CHECK (activeTicketCount <= maxConcurrentTickets)` and
/// `CK_AgentPresence_offlineHasNoTickets CHECK (status <> 'Offline' OR activeTicketCount
/// = 0)` live in `prisma/sql/001_constraints.sql`.
model AgentPresence {
  /// PK, 1:1 per staff user. References `platform.StaffUsers.id`; not FK-enforced (see
  /// the header block).
  staffUserId          String   @id @db.Char(26)
  /// `Available` | `Busy` | `Offline`.
  status               String   @db.VarChar(12)
  statusChangedAt      DateTime @db.DateTime2
  activeTicketCount    Int      @db.SmallInt
  maxConcurrentTickets Int      @db.SmallInt
  lastHeartbeatAt      DateTime @db.DateTime2
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2

  @@index([status], map: "IX_AgentPresence_status")
  @@map("AgentPresence")
}

/// Ordered rules; **first active match wins**. Hard-deleted (§1.4) — B8's **Delete** must
/// actually remove the rule, because a soft-deleted rule that still occupied an ordinal
/// would silently change routing precedence.
///
/// **`UQ_RoutingRules_ordinal` is the most consequential index in the module.** If the
/// ordinal were merely a non-unique sort column, two rules could share position 2 and the
/// outcome would depend on the database's tiebreak — not stable, not documented, and not
/// something B8's rule tester could predict. Uniqueness makes precedence a fact about the
/// data rather than an artefact of query planning. Reordering is therefore a transaction
/// that parks a rule at `ordinal = -1`, which
/// `CK_RoutingRules_ordinalPositive CHECK (ordinal > 0)` makes invalid outside that
/// transaction — a half-completed reorder cannot be committed.
///
/// `isEnabled`, `ordinal` and existence are three independent pieces of state; collapsing
/// any two of them breaks one of B8's three actions. A disabled rule keeps its ordinal so
/// re-enabling restores its exact precedence.
///
/// In `prisma/sql/001_constraints.sql`: `CK_RoutingRules_ordinalPositive`,
/// **`CK_RoutingRules_operatorMatchesAttribute`** (mirrors the form's auto-switch to `>`
/// for Wait time and `=` otherwise, so an imported rule cannot carry `Topic > Billing`),
/// `CK_RoutingRules_targetPaired` and `CK_RoutingRules_waitTimeNumeric`.
model RoutingRule {
  id                   String   @id @db.Char(26)
  ordinal              Int      @unique(map: "UQ_RoutingRules_ordinal")
  /// `Topic` | `Priority` | `Channel` | `WaitTime`.
  attribute            String   @db.VarChar(16)
  /// `Eq` | `Gt`.
  operator             String   @db.VarChar(4)
  value                String   @db.NVarChar(64)
  /// `Team` | `Requeue`.
  targetKind           String   @db.VarChar(16)
  targetTeamId         String?  @db.Char(26)
  alertSupervisor      Boolean
  isEnabled            Boolean
  createdByStaffUserId String   @db.Char(26)
  updatedByStaffUserId String   @db.Char(26)
  createdAt            DateTime @db.DateTime2
  updatedAt            DateTime @updatedAt @db.DateTime2

  targetTeam        Team?              @relation(fields: [targetTeamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  escalationTickets EscalationTicket[]
  tests             RoutingRuleTest[]

  @@map("RoutingRules")
}

/// A recorded run of B8's tester, so a pre-live check is evidence rather than a
/// transient reassurance. `ruleSetHash` pins **which rule ordering was tested**
/// (§4.9 ASSUMPTION 3) — without it a passed test cannot be tied to the configuration it
/// passed against.
///
/// `firedRule` is `onDelete: SetNull` (2026-09-10, follow-up fix — was `NoAction`,
/// which made any routing rule that had ever been evaluated by the tester permanently
/// undeletable). `firedRuleOrdinal` is a plain snapshot `Int`, not a foreign key, so it
/// keeps recording which position fired even after `firedRoutingRuleId` is nulled out
/// by a later delete — the test's forensic value survives the rule's own deletion.
///
/// `CK_RoutingRuleTests_firedPaired CHECK (fellToDefaultQueue = 0 OR firedRoutingRuleId
/// IS NULL)` and `_sampleJson_isJson` live in `prisma/sql/001_constraints.sql`. The
/// CHECK is a one-way implication, not a symmetric equality, specifically so a fired
/// rule's later deletion (which nulls `firedRoutingRuleId` while `fellToDefaultQueue`
/// correctly stays 0, a fixed historical fact) does not itself violate the constraint.
model RoutingRuleTest {
  id                 String   @id @db.Char(26)
  sampleJson         String   @db.NVarChar(Max)
  firedRoutingRuleId String?  @db.Char(26)
  firedRuleOrdinal   Int?
  resolvedTarget     String   @db.NVarChar(200)
  fellToDefaultQueue Boolean
  ruleSetHash        String   @db.Char(64)
  ranByStaffUserId   String   @db.Char(26)
  createdAt          DateTime @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  firedRule RoutingRule? @relation(fields: [firedRoutingRuleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "IX_RoutingRuleTests_createdAt")
  @@map("RoutingRuleTests")
}

/// Editable pre-written replies, scoped by team and topic (B8).
///
/// `UQ_CannedReplies_name_localeCode ... WHERE deletedAt IS NULL` and the filtered
/// `IX_CannedReplies_topicKey_localeCode ... WHERE isEnabled = 1 AND deletedAt IS NULL`
/// live in `prisma/sql/001_constraints.sql`.
model CannedReply {
  id                   String    @id @db.Char(26)
