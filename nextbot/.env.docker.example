# Copy to `.env.docker` for `docker compose -f docker-compose.yml up`. Every value
# below already has a working default baked into docker-compose.yml's
# `x-db-env`/`x-shared-env` anchors (via `${VAR:-default}`), so this file is
# optional for a first local run — override only what you want to change. NEVER
# commit a filled-in `.env.docker` (it is gitignored, same as `.env`/`.env.*`).

# --- Postgres (schema-owner credentials; ensure-roles.ts derives the app/platform/
#     gateway role passwords below from these connection-string vars) ---
POSTGRES_OWNER_USER=nextbot
POSTGRES_OWNER_PASSWORD=nextbot_dev_password
POSTGRES_DB=nextbot

# --- Per-role Postgres passwords (ADR-0001 role separation) ---
DB_APP_USER=nextbot_app
DB_APP_PASSWORD=app_dev_pw_change_me
DB_PLATFORM_USER=nextbot_platform
DB_PLATFORM_PASSWORD=platform_dev_pw_change_me
DB_GATEWAY_USER=nextbot_gateway
DB_GATEWAY_PASSWORD=gateway_dev_pw_change_me

# --- ClickHouse (ADR-0008) ---
CLICKHOUSE_USER=nextbot
CLICKHOUSE_PASSWORD=nextbot_dev_password
CLICKHOUSE_DB=nextbot
# ClickHouse has no separate migration set: its one table (`agent_run_span`,
# ADR-0008) is provisioned by the application itself via an idempotent
# `CREATE TABLE IF NOT EXISTS` on first write/read (see `packages/db/src/
# clickhouse.ts`'s `ensureSchema()`) — nothing extra to run here.

# --- Neo4j / graph store (ADR-0018, Target Architecture Blueprint Phase 7a) ---
# **Enterprise Edition, real production license required — see
#   docs/deployment/DEPLOYMENT.md "Neo4j Enterprise licensing" before deploying
#   this stack anywhere but a local/throwaway environment.** The password below
#   is this stack's Neo4j superuser (`neo4j`) password — change it for anything
#   beyond a throwaway local run, same as every other credential in this file.
NEO4J_PASSWORD=nextbot_neo4j_dev_password
# The service credential `@nextbot/graph-store`'s `withTenantGraph()` connects as
# (ADR-0018 §2.2) — holds no data privileges of its own, only IMPERSONATE on each
# tenant's own restricted user. Not a pre-existing Neo4j user: created idempotently,
# with this password, the first time any tenant is provisioned. Change the password
# for anything beyond a throwaway local run.
GRAPH_STORE_SERVICE_USER=svc_graph
GRAPH_STORE_CREDENTIAL_REF=svc_graph_dev_password_change_me
# Prefix for a tenant's Neo4j database name (`<prefix>-<hex(tenantId)>`) — only
# change this if you need to disambiguate multiple deployments sharing one Neo4j
# cluster.
GRAPH_STORE_DATABASE_PREFIX=t

# --- IAM/session secrets — change these for anything beyond a throwaway local
#     stack; both must be >= 32 chars and DISTINCT from each other (Phase 2 design:
#     admin sessions vs. anonymous widget sessions never share a signing secret) ---
NEXTBOT_SESSION_SECRET=dev-session-secret-please-change-me-32chars-min
NEXTBOT_WIDGET_SESSION_SECRET=dev-widget-session-secret-please-change-32ch

# --- Credential-vault envelope-encryption master key (ADR-0007) — env-var KEK for
#     local/dev only; production should source this from a real KMS/secret store ---
NEXTBOT_KMS_MASTER_KEY=1111111111111111111111111111111111111111111111111111111111111111

# --- Where the widget-embed static assets (nextbot.js loader + widget SPA) are
#     reachable from a customer's browser — used to render the Admin Console's
#     "Get embed snippet" (QA Final Review B3). Default matches the `widget-embed`
#     service's published host port for a single-host `docker compose up` ---
NEXTBOT_WIDGET_BASE_URL=http://localhost:8080

# --- AI subsystem (ADR-0006) — provider-agnostic; point AI_BASE_URL at any
#     OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, or a real provider).
#     Leave the placeholders as-is if you only want to explore the Admin Console/
#     widget UI without exercising an actual agent conversation. ---
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL_CHAT_PRIMARY=local-placeholder-model
AI_MODEL_CHAT_FAST=
AI_MODEL_REASONING_PLANNER=
AI_MODEL_CLASSIFY_GUARDRAIL=
AI_MODEL_SUMMARIZE=
AI_MODEL_EMBED=

# --- Platform Manager console (NFR-11, `/internal/ops/**` — cross-tenant operator
#     surface, `apps/web`). The console 404s indistinguishably from any other
#     missing path until BOTH NEXTBOT_OPS_OPERATOR_TOKEN and NEXTBOT_OPS_IP_ALLOWLIST
#     are set (fail-closed by design).
#
#     UNLIKE every other var in this file, these three now DO have working
#     defaults baked directly into docker-compose.yml's `x-shared-env` anchor —
#     so the console is reachable and loggable-into out of the box, with zero
#     manual config, the same way the Admin Console already is. Leave these
#     three blank here to use those defaults; set a value here only to override
#     them (e.g. a different operator token).
#
#     Those defaults only work *because* `docker-compose.yml` also adds a
#     `web-proxy` service (docker/web-proxy/nginx.conf) — a small nginx reverse
#     proxy that now sits in front of `web` and overwrites (never appends)
#     X-Forwarded-For/X-Real-IP with its own observed connection, and a pinned
#     `172.30.238.0/24` compose network so that connection's source address is
#     deterministic across machines. This is a LOCAL-TESTING CONVENIENCE, not a
#     production-safe default: see docs/deployment/DEPLOYMENT.md "Testing the
#     Platform Manager console locally" and "Known gaps" for what changes for a
#     real deployment (a real reverse proxy + real network-level isolation, a
#     decision for the orchestrator/architect, not this file).
#
# Leave blank to use docker-compose.yml's generated default (see
# SEED_CREDENTIALS.md for that value) — set a real value here to use your own.
NEXTBOT_OPS_OPERATOR_TOKEN=
# Leave blank to use docker-compose.yml's default (172.30.238.1/32 — the pinned
# compose network's gateway address, i.e. what a host-machine browser request
# resolves to once it's passed through `web-proxy`).
NEXTBOT_OPS_IP_ALLOWLIST=
# Comma-separated IP/CIDR of the reverse proxy(ies) this deployment guarantees
# sit directly in front of `web` and can be trusted to have overwritten (never
# appended to) X-Forwarded-For/X-Real-IP with their own view of the real caller.
# Leave blank to use docker-compose.yml's default (172.30.238.250/32 — the
# `web-proxy` service's own pinned address, the only hop this local topology
# actually guarantees). See `apps/web/src/lib/platform-ops-network.ts`'s
# `getTrustedProxyCidrs` doc comment for the full trust-model rationale, and
# docs/deployment/DEPLOYMENT.md's "Known gaps" for what a real (non-local)
# deployment needs instead of this local convenience.
NEXTBOT_OPS_TRUSTED_PROXY_CIDRS=
