# ExamLand — environment for `docker-compose.yml` (the full-stack, repo-root compose file).
# Copy to `.env` (gitignored — see .gitignore's `.env` / `.env.*` / `!.env.example` rules) and fill
# in every value marked REQUIRED before running `docker compose up`. Values below with a plain
# default need no action for local/self-hosted use; they're listed so nothing is hidden.
#
# Source of truth for this list: apps/api/src/config/env.schema.ts (the single zod schema that
# validates every env var this process reads) and services/ai-engine/.env.example (the AI engine's
# own, separate env vars — that process never reads this file's AI_SERVICE_TOKEN/OPENROUTER_API_KEY
# indirectly; docker-compose.yml passes the same values to both containers explicitly).
#
# docker-compose.dev.yml's mysql/qdrant/mailhog credentials (DB_USER=examland, DB_PASSWORD=
# examland_dev, MYSQL_ROOT_PASSWORD=examland_dev_root) are hardcoded in that file, not read from
# here — do not add DB_USER/DB_PASSWORD overrides expecting them to take effect; see
# docs/deployment/DEPLOYMENT.md if you need to change them (requires editing that file too).

# ── App ────────────────────────────────────────────────────────────────────────────────────────
# production | staging | development | test. `production` is the compose default (matches how the
# image is built) — see docs/deployment/DEPLOYMENT.md for why `development` may be easier while you
# don't yet have real embeddings/Stripe/Google credentials.
NODE_ENV=production
# The domain this deployment answers to. Only cosmetic for a pure-localhost run (no wildcard DNS
# is used locally — DEFAULT_TENANT_SUBDOMAIN below is what actually routes single-tenant local
# requests, per HLD §13.2).
PUBLIC_APEX_DOMAIN=examland.local
DEFAULT_TENANT_SUBDOMAIN=default
RESERVED_SUBDOMAINS=admin,www,api,app,auth,static,mail,status
# Host port the `api` container's single HTTP port (3000, serving both /api/** and the Angular
# SPA — HLD §13.1) is published on.
API_HTTP_PORT=3000

# ── Secrets — REQUIRED, no safe default ships here on purpose ───────────────────────────────────
# Two DIFFERENT random strings (HLD §5.1 "three independent barriers" — a shared secret would let a
# tenant-realm token be replayed as a platform-realm token if a guard bug ever slipped through).
# Generate with: openssl rand -base64 48
JWT_TENANT_SECRET=change-me-generate-a-real-random-secret-tenant
JWT_PLATFORM_SECRET=change-me-generate-a-different-random-secret-platform
# HMAC key for signed file-delivery URLs (HLD §5.3). Generate with: openssl rand -base64 48
FILE_SIGNING_SECRET=change-me-generate-a-real-random-secret-files

# ── First Platform Admin bootstrap (optional but recommended — see RUNBOOK) ─────────────────────
# Idempotent: only inserts a Platform Admin when platform_admin is empty, safe to leave set across
# every boot (apps/api/src/config/env.schema.ts's own doc comment). Leave both blank to skip and
# create your first Platform Admin another way.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# ── Platform schema name ─────────────────────────────────────────────────────────────────────────
DB_PLATFORM_SCHEMA=examland_platform

# ── Demo tenant seed (optional — `npm run seed:demo-tenant` / `node dist/api/seed-demo-tenant.js`) ─
# Not read by env.schema.ts (this is a one-off local-dev convenience script, not a shared runtime
# config surface) — the script hardcodes the same defaults shown here, so these three lines only
# need uncommenting if you want a different name/slug/admin email than the defaults. Idempotent:
# safe to leave set across every re-run. See docs/deployment/DEPLOYMENT.md §2 step 8.
# DEMO_TENANT_NAME=Demo
# DEMO_TENANT_SUBDOMAIN=demo
# DEMO_TENANT_ADMIN_EMAIL=admin@demo.local

# ── AI engine (OPTIONAL — omit entirely for an AI-less deployment, HLD §8.4/§8.5) ────────────────
# Set AI_ENGINE=enabled AND bring the stack up with `docker compose --profile ai up` to run the
# Python AI engine alongside the app. Leave AI_ENGINE=disabled (default) to skip it entirely — auth,
# exam taking, authoring, billing, and the Platform Admin console are fully functional without it.
AI_ENGINE=disabled
# Shared-secret bearer, defense in depth alongside mTLS (HLD §8.3). >=32 chars, required whenever
# AI_ENGINE=enabled. Generate with: openssl rand -base64 32
AI_SERVICE_TOKEN=
# Required only when AI_ENGINE=enabled — the only place OPENROUTER_API_KEY is used; apps/api never
# holds this credential (HLD §8.0/§8.4). Get one at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_SERVICE_TIMEOUT_MS=120000

# ── Embeddings (curriculum ingestion/search, FR-CUR-2/3, HLD §7.2) ───────────────────────────────
# openai-compatible | local-tei | null. `null` (NullEmbeddingsAdapter) is refused whenever
# NODE_ENV=production/staging — only usable with NODE_ENV=development/test.
EMBEDDINGS_PROVIDER=openai-compatible
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# Required for curriculum ingestion/search/PDF-fingerprint dedup to actually work; boot succeeds
# without it (not in the hard-required-at-boot list), but those features 5xx until it's set.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# ── Qdrant API key (only needed if you've put Qdrant behind auth — the bundled qdrant service has
#    none) ──────────────────────────────────────────────────────────────────────────────────────
QDRANT_API_KEY=

# ── Mail (SMTP_FROM only — host/port/user/password are pinned to the bundled MailHog service in
#    docker-compose.yml; MailHog needs no credentials) ───────────────────────────────────────────
SMTP_FROM=no-reply@examland.local

# ── Google Sign-In (optional, FR-MT-6) ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
# The fixed non-wildcard origin the Google OAuth flow runs on before handing the verified ID token
# back to the tenant subdomain (HLD §14 item 3). Leave blank if Google Sign-In isn't configured.
GOOGLE_AUTH_BRIDGE_ORIGIN=

# ── Stripe billing (optional, FR-PKG-6) — both must be set together, or both left blank ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Leave blank to use the built-in admin.{PUBLIC_APEX_DOMAIN} default templates (see
# apps/api/src/config/configuration.ts).
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# ── Observability / misc ─────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Bearer token guarding GET /api/metrics (Prometheus text). Leave blank to leave metrics
# unauthenticated (fine for a fully local/private deployment only).
PLATFORM_METRICS_TOKEN=

# ── Build ──────────────────────────────────────────────────────────────────────────────────────
# Tag applied to the built app image (examland-app:<tag>) — bump when you want docker-compose to
# distinguish builds, otherwise `local` is fine.
IMAGE_TAG=local
