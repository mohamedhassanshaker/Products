# EXAMPLE ONLY — do not `kubectl apply` this file with real values, and never commit
# a filled-in copy. In a real environment this Secret's data should come from your
# secret-management tool of choice (the HLD/ADR do not name one for k8s specifically
# — this is flagged in docs/deployment/DEPLOYMENT.md as an open decision the user
# should make: HashiCorp Vault + the Vault CSI/Agent-injector, External Secrets
# Operator pointed at a cloud KMS/secret-manager, or Sealed Secrets, are the three
# realistic options for this stack). Whichever is chosen, it should populate a
# Secret with exactly these keys so the Deployments below (which reference them via
# `secretKeyRef`) don't need to change.
apiVersion: v1
kind: Secret
metadata:
  name: nextbot-secrets
  namespace: nextbot
type: Opaque
stringData:
  NEXTBOT_DB_OWNER_URL: "postgres://REPLACE_ME:REPLACE_ME@postgres:5432/nextbot"
  NEXTBOT_DB_APP_URL: "postgres://REPLACE_ME:REPLACE_ME@postgres:5432/nextbot"
  NEXTBOT_DB_PLATFORM_URL: "postgres://REPLACE_ME:REPLACE_ME@postgres:5432/nextbot"
  NEXTBOT_DB_GATEWAY_URL: "postgres://REPLACE_ME:REPLACE_ME@postgres:5432/nextbot"
  CLICKHOUSE_URL: "http://REPLACE_ME:REPLACE_ME@clickhouse:8123/nextbot"
  NEXTBOT_SESSION_SECRET: "REPLACE_ME_32_BYTES_MIN"
  NEXTBOT_WIDGET_SESSION_SECRET: "REPLACE_ME_32_BYTES_MIN_DISTINCT_FROM_ABOVE"
  NEXTBOT_KMS_MASTER_KEY: "REPLACE_ME_KEK_FROM_CLOUD_KMS_OR_VAULT"
  AI_API_KEY: "REPLACE_ME_OR_LEAVE_EMPTY_FOR_UNAUTHENTICATED_ON_PREM_ENDPOINT"
  AI_BASE_URL: "REPLACE_ME_PROVIDER_OR_ON_PREM_ENDPOINT"
  # Graph store (ADR-0018, Target Architecture Blueprint Phase 7a) — gap fix,
  # 2026-09-01, this whole block was missing. GRAPH_STORE_ADMIN_* is the Neo4j
  # DBMS-admin credential (used only by `tenant-database-provisioner.ts` — never
  # for tenant data reads/writes); GRAPH_STORE_SERVICE_* is the lower-privilege
  # credential `withTenantGraph()` connects as (holds no data privileges of its
  # own, only IMPERSONATE on each tenant's own restricted user, ADR-0018 §2.2) —
  # not a pre-existing Neo4j user, created idempotently with this password the
  # first time any tenant is provisioned.
  GRAPH_STORE_ADMIN_USER: "neo4j"
  GRAPH_STORE_ADMIN_CREDENTIAL_REF: "REPLACE_ME_NEO4J_SUPERUSER_PASSWORD"
  GRAPH_STORE_SERVICE_USER: "svc_graph"
  GRAPH_STORE_CREDENTIAL_REF: "REPLACE_ME_SERVICE_USER_PASSWORD"
