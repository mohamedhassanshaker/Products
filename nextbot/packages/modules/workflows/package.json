    "@nextbot/model-gateway": "workspace:*",
    "@nextbot/orchestration": "workspace:*",
    "@nextbot/pii": "workspace:*",
    "@nextbot/skills": "workspace:*",
    "@nextbot/tenancy": "workspace:*",
    "@nextbot/tool-registry": "workspace:*",
    "@nextbot/yaml-diff": "workspace:*",
    "@sinclair/typebox": "^0.33.15",
    "drizzle-orm": "^0.36.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@nextbot/connectors": "workspace:*",
    "@nextbot/testing": "workspace:*",
