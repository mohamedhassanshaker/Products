/// **The permission boundary.** An agent version may invoke exactly what is bound here —
/// a first-class entity, not a boolean on a skill, and three properties follow that a
/// boolean could not give (§4.6): the binding is **versioned with the agent**, so rolling
/// back to v1.3 restores v1.3's tool permissions; it is **attributable**, which answers
/// the question a government auditor will ask; and it **carries policy**, so
/// `get_bill_status` can be anonymous for one agent and require OTP for another.
///
/// In `prisma/sql/001_constraints.sql`: the three filtered uniques
/// `UQ_ToolBindings_skill/_mcpTool/_apiConnector (agentVersionId, <target>) WHERE
/// <target> IS NOT NULL`; `CK_ToolBindings_exactlyOneTarget`;
/// `CK_ToolBindings_kindMatchesTarget`; `CK_ToolBindings_requiredAssurance`; and
/// `TR_ToolBindings_serverMustBeConnected` — a binding to an `McpTool` on a
/// `NotConnected` server is rejected, and its sibling rejects a binding to a
/// soft-deleted skill while leaving existing bindings resolvable for trace readability.
model ToolBinding {
  id                 String   @id @db.Char(26)
  agentVersionId     String   @db.Char(26)
  /// `Skill` | `McpTool` | `ApiConnector`.
  targetKind         String   @db.VarChar(16)
  skillId            String?  @db.Char(26)
  mcpToolId          String?  @db.Char(26)
  apiConnectorId     String?  @db.Char(26)
  isEnabled          Boolean
  /// Pins or constrains arguments — for example forcing `provider` to an entity the
  /// agent owns.
  argumentPolicyJson String?  @db.NVarChar(Max)
  /// Lets a B11 tab 2 step-up rule attach to the **binding** rather than to the tool.
  requiredAssurance  String   @db.VarChar(32)
  rateLimitPolicyId  String?  @db.Char(26)
  boundByStaffUserId String   @db.Char(26)
  boundAt            DateTime @db.DateTime2
  createdAt          DateTime @db.DateTime2
  updatedAt          DateTime @updatedAt @db.DateTime2

  agentVersion    AgentVersion             @relation(fields: [agentVersionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  skill           Skill?                   @relation(fields: [skillId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mcpTool         McpTool?                 @relation(fields: [mcpToolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  apiConnector    ApiConnector?            @relation(fields: [apiConnectorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rateLimitPolicy RateLimitPolicy?         @relation(fields: [rateLimitPolicyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  traceSteps      OrchestrationTraceStep[]
  flowNodes       FlowNode[]

  @@index([agentVersionId], map: "IX_ToolBindings_agentVersionId")
  @@map("ToolBindings")
}

/// The configured breaker. **Live state is in Redis** (§8) — "a breaker tripped on one
/// pod is tripped on all" — so there is no second copy of "is it open" to drift: this
/// table holds configuration, Redis holds state, `ServiceHealthSamples` holds the
/// observation, and B5 tab 4 and B14 tab 3 read the same two sources.
///
/// In `prisma/sql/001_constraints.sql`:
/// `CK_CircuitBreakerConfigs_cachedStrategyNeedsMaxAge CHECK (fallbackStrategy <>
/// 'ServeCachedAnswer' OR cachedAnswerMaxAgeSeconds IS NOT NULL)`,
/// `CK_CircuitBreakerConfigs_positive`, `_targetKind` and `_fallbackStrategy`.
model CircuitBreakerConfig {
  id                        String   @id @db.Char(26)
  /// `ApiConnector` | `McpServer` | `Channel` | `Internal`.
  targetKind                String   @db.VarChar(16)
